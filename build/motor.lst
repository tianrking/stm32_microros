 117:Cus/MOTOR_DRV/motor.c **** }
 118:Cus/MOTOR_DRV/motor.c **** 
 119:Cus/MOTOR_DRV/motor.c **** void Motor_UpdateSpeed(Motor_HandleTypeDef *hmotor)
 120:Cus/MOTOR_DRV/motor.c **** {
 121:Cus/MOTOR_DRV/motor.c ****     // 获取当前速度
 122:Cus/MOTOR_DRV/motor.c ****     hmotor->current_rpm = Encoder_GetSpeedRPM(hmotor->encoder);
 123:Cus/MOTOR_DRV/motor.c ****     
 124:Cus/MOTOR_DRV/motor.c ****     // 更新PID控制器
 125:Cus/MOTOR_DRV/motor.c ****     float pid_output = PID_Update(&hmotor->pid, hmotor->current_rpm);
 126:Cus/MOTOR_DRV/motor.c ****     
 127:Cus/MOTOR_DRV/motor.c ****     // 设置电机PWM
 128:Cus/MOTOR_DRV/motor.c ****     Motor_SetSpeed(hmotor, (int32_t)pid_output);
 129:Cus/MOTOR_DRV/motor.c **** }
