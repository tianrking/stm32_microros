  11:Cus/MOTOR_DRV/motor.c **** void Motor_Init(Motor_HandleTypeDef *hmotor, Motor_InitTypeDef *init)
  12:Cus/MOTOR_DRV/motor.c **** {
  13:Cus/MOTOR_DRV/motor.c ****     // 配置电机参数
  14:Cus/MOTOR_DRV/motor.c ****     hmotor->htim = init->htim;
  15:Cus/MOTOR_DRV/motor.c ****     hmotor->channel = init->channel;
  16:Cus/MOTOR_DRV/motor.c ****     hmotor->dir_port1 = init->dir_port1;
  17:Cus/MOTOR_DRV/motor.c ****     hmotor->dir_pin1 = init->dir_pin1;
  18:Cus/MOTOR_DRV/motor.c ****     hmotor->dir_port2 = init->dir_port2;
  19:Cus/MOTOR_DRV/motor.c ****     hmotor->dir_pin2 = init->dir_pin2;
  20:Cus/MOTOR_DRV/motor.c ****     
  21:Cus/MOTOR_DRV/motor.c ****     // 初始化默认状态
  22:Cus/MOTOR_DRV/motor.c ****     hmotor->current_speed = 0;
  23:Cus/MOTOR_DRV/motor.c ****     hmotor->current_dir = MOTOR_STOP;
  24:Cus/MOTOR_DRV/motor.c ****     
  25:Cus/MOTOR_DRV/motor.c ****     // 启动PWM
  26:Cus/MOTOR_DRV/motor.c ****     HAL_TIM_PWM_Start(hmotor->htim, hmotor->channel);
  27:Cus/MOTOR_DRV/motor.c ****     
  28:Cus/MOTOR_DRV/motor.c ****     // 确保电机初始状态为停止
  29:Cus/MOTOR_DRV/motor.c ****     Motor_Stop(hmotor);
  30:Cus/MOTOR_DRV/motor.c **** }
