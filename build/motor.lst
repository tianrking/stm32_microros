  71:Cus/MOTOR_DRV/motor.c **** // 原始PWM控制接口保持不变
  72:Cus/MOTOR_DRV/motor.c **** void Motor_SetSpeed(Motor_HandleTypeDef *hmotor, int32_t speed)
  73:Cus/MOTOR_DRV/motor.c **** {
  74:Cus/MOTOR_DRV/motor.c ****     // 根据安装方向调整实际速度
  75:Cus/MOTOR_DRV/motor.c ****     int32_t actual_speed = speed * hmotor->install_dir;
  76:Cus/MOTOR_DRV/motor.c ****     
  77:Cus/MOTOR_DRV/motor.c ****     // 确定方向并获取绝对值
  78:Cus/MOTOR_DRV/motor.c ****     MotorDirection dir;
  79:Cus/MOTOR_DRV/motor.c ****     uint32_t abs_speed;
  80:Cus/MOTOR_DRV/motor.c ****     
  81:Cus/MOTOR_DRV/motor.c ****     if (actual_speed > 0) {
  82:Cus/MOTOR_DRV/motor.c ****         dir = MOTOR_FORWARD;
  83:Cus/MOTOR_DRV/motor.c ****         abs_speed = (uint32_t)actual_speed;
  84:Cus/MOTOR_DRV/motor.c ****     } else if (actual_speed < 0) {
  85:Cus/MOTOR_DRV/motor.c ****         dir = MOTOR_BACKWARD;
  86:Cus/MOTOR_DRV/motor.c ****         abs_speed = (uint32_t)(-actual_speed);
  87:Cus/MOTOR_DRV/motor.c ****     } else {
ARM GAS  /tmp/ccuoQXaZ.s 			page 3


  88:Cus/MOTOR_DRV/motor.c ****         dir = MOTOR_STOP;
  89:Cus/MOTOR_DRV/motor.c ****         abs_speed = 0;
  90:Cus/MOTOR_DRV/motor.c ****     }
  91:Cus/MOTOR_DRV/motor.c ****     
  92:Cus/MOTOR_DRV/motor.c ****     // 限制最大值为1000
  93:Cus/MOTOR_DRV/motor.c ****     if (abs_speed > 1000) {
  94:Cus/MOTOR_DRV/motor.c ****         abs_speed = 1000;
  95:Cus/MOTOR_DRV/motor.c ****     }
  96:Cus/MOTOR_DRV/motor.c ****     
  97:Cus/MOTOR_DRV/motor.c ****     // 设置方向
  98:Cus/MOTOR_DRV/motor.c ****     Motor_SetDirection(hmotor, dir);
  99:Cus/MOTOR_DRV/motor.c ****     
 100:Cus/MOTOR_DRV/motor.c ****     // 直接设置PWM值
 101:Cus/MOTOR_DRV/motor.c ****     __HAL_TIM_SET_COMPARE(hmotor->htim, hmotor->channel, abs_speed);
 102:Cus/MOTOR_DRV/motor.c ****     
 103:Cus/MOTOR_DRV/motor.c ****     // 更新当前状态
 104:Cus/MOTOR_DRV/motor.c ****     hmotor->current_speed = abs_speed;
 105:Cus/MOTOR_DRV/motor.c ****     hmotor->current_dir = dir;
 106:Cus/MOTOR_DRV/motor.c **** }
 107:Cus/MOTOR_DRV/motor.c **** 
 108:Cus/MOTOR_DRV/motor.c **** void Motor_Stop(Motor_HandleTypeDef *hmotor)
 109:Cus/MOTOR_DRV/motor.c **** {
 110:Cus/MOTOR_DRV/motor.c ****     Motor_SetDirection(hmotor, MOTOR_STOP);
 111:Cus/MOTOR_DRV/motor.c ****     __HAL_TIM_SET_COMPARE(hmotor->htim, hmotor->channel, 0);
 112:Cus/MOTOR_DRV/motor.c ****     hmotor->current_speed = 0;
 113:Cus/MOTOR_DRV/motor.c ****     hmotor->current_dir = MOTOR_STOP;
 114:Cus/MOTOR_DRV/motor.c ****     hmotor->target_rpm = 0;
 115:Cus/MOTOR_DRV/motor.c ****     hmotor->current_rpm = 0;
 116:Cus/MOTOR_DRV/motor.c ****     PID_Reset(&hmotor->pid);
 117:Cus/MOTOR_DRV/motor.c **** }
 118:Cus/MOTOR_DRV/motor.c **** 
 119:Cus/MOTOR_DRV/motor.c **** void Motor_SetTargetSpeed(Motor_HandleTypeDef *hmotor, float target_rpm)
 120:Cus/MOTOR_DRV/motor.c **** {
 121:Cus/MOTOR_DRV/motor.c ****     // 根据安装方向调整目标转速
 122:Cus/MOTOR_DRV/motor.c ****     float actual_target_rpm = target_rpm * hmotor->install_dir;
 123:Cus/MOTOR_DRV/motor.c ****     hmotor->target_rpm = actual_target_rpm;
 124:Cus/MOTOR_DRV/motor.c ****     PID_SetSetpoint(&hmotor->pid, actual_target_rpm);
 125:Cus/MOTOR_DRV/motor.c **** }
 126:Cus/MOTOR_DRV/motor.c **** 
 127:Cus/MOTOR_DRV/motor.c **** void Motor_UpdateSpeed(Motor_HandleTypeDef *hmotor)
 128:Cus/MOTOR_DRV/motor.c **** {
 129:Cus/MOTOR_DRV/motor.c ****     // 获取当前速度
