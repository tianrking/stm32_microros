 101:Cus/MOTOR_DRV/motor.c **** void Motor_Stop(Motor_HandleTypeDef *hmotor)
 102:Cus/MOTOR_DRV/motor.c **** {
 103:Cus/MOTOR_DRV/motor.c ****     Motor_SetDirection(hmotor, MOTOR_STOP);
 104:Cus/MOTOR_DRV/motor.c ****     __HAL_TIM_SET_COMPARE(hmotor->htim, hmotor->channel, 0);
 105:Cus/MOTOR_DRV/motor.c ****     hmotor->current_speed = 0;
 106:Cus/MOTOR_DRV/motor.c ****     hmotor->current_dir = MOTOR_STOP;
 107:Cus/MOTOR_DRV/motor.c ****     hmotor->target_rpm = 0;
 108:Cus/MOTOR_DRV/motor.c ****     hmotor->current_rpm = 0;
 109:Cus/MOTOR_DRV/motor.c ****     PID_Reset(&hmotor->pid);
 110:Cus/MOTOR_DRV/motor.c **** }
 111:Cus/MOTOR_DRV/motor.c **** 
 112:Cus/MOTOR_DRV/motor.c **** // 新增速度控制接口
 113:Cus/MOTOR_DRV/motor.c **** void Motor_SetTargetSpeed(Motor_HandleTypeDef *hmotor, float target_rpm)
 114:Cus/MOTOR_DRV/motor.c **** {
 115:Cus/MOTOR_DRV/motor.c ****     hmotor->target_rpm = target_rpm;
