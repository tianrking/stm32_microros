  57:Cus/MOTOR_DRV/motor.c **** 
  58:Cus/MOTOR_DRV/motor.c **** void Motor_SetSpeed(Motor_HandleTypeDef *hmotor, int32_t speed)
  59:Cus/MOTOR_DRV/motor.c **** {
  60:Cus/MOTOR_DRV/motor.c ****     // 确定方向并获取绝对值
  61:Cus/MOTOR_DRV/motor.c ****     MotorDirection dir;
  62:Cus/MOTOR_DRV/motor.c ****     uint32_t abs_speed;
  63:Cus/MOTOR_DRV/motor.c ****     
  64:Cus/MOTOR_DRV/motor.c ****     if (speed > 0) {
  65:Cus/MOTOR_DRV/motor.c ****         dir = MOTOR_FORWARD;
  66:Cus/MOTOR_DRV/motor.c ****         abs_speed = (uint32_t)speed;
  67:Cus/MOTOR_DRV/motor.c ****     } else if (speed < 0) {
  68:Cus/MOTOR_DRV/motor.c ****         dir = MOTOR_BACKWARD;
  69:Cus/MOTOR_DRV/motor.c ****         abs_speed = (uint32_t)(-speed);
  70:Cus/MOTOR_DRV/motor.c ****     } else {
  71:Cus/MOTOR_DRV/motor.c ****         dir = MOTOR_STOP;
  72:Cus/MOTOR_DRV/motor.c ****         abs_speed = 0;
  73:Cus/MOTOR_DRV/motor.c ****     }
  74:Cus/MOTOR_DRV/motor.c ****     
  75:Cus/MOTOR_DRV/motor.c ****     // 限制最大值为1000
  76:Cus/MOTOR_DRV/motor.c ****     if (abs_speed > 1000) {
  77:Cus/MOTOR_DRV/motor.c ****         abs_speed = 1000;
  78:Cus/MOTOR_DRV/motor.c ****     }
  79:Cus/MOTOR_DRV/motor.c ****     
  80:Cus/MOTOR_DRV/motor.c ****     // 设置方向
  81:Cus/MOTOR_DRV/motor.c ****     Motor_SetDirection(hmotor, dir);
  82:Cus/MOTOR_DRV/motor.c ****     
  83:Cus/MOTOR_DRV/motor.c ****     // 直接设置PWM值
  84:Cus/MOTOR_DRV/motor.c ****     __HAL_TIM_SET_COMPARE(hmotor->htim, hmotor->channel, abs_speed);
  85:Cus/MOTOR_DRV/motor.c ****     
  86:Cus/MOTOR_DRV/motor.c ****     // 更新当前状态
  87:Cus/MOTOR_DRV/motor.c ****     hmotor->current_speed = abs_speed;
ARM GAS  /tmp/ccHfCcY2.s 			page 3


  88:Cus/MOTOR_DRV/motor.c ****     hmotor->current_dir = dir;
  89:Cus/MOTOR_DRV/motor.c **** }
