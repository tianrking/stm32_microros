  67:Cus/MOTOR_DRV/motor.c **** // 原始PWM控制接口保持不变
  68:Cus/MOTOR_DRV/motor.c **** void Motor_SetSpeed(Motor_HandleTypeDef *hmotor, int32_t speed)
  69:Cus/MOTOR_DRV/motor.c **** {
  70:Cus/MOTOR_DRV/motor.c ****     // 确定方向并获取绝对值
  71:Cus/MOTOR_DRV/motor.c ****     MotorDirection dir;
  72:Cus/MOTOR_DRV/motor.c ****     uint32_t abs_speed;
  73:Cus/MOTOR_DRV/motor.c ****     
  74:Cus/MOTOR_DRV/motor.c ****     if (speed > 0) {
  75:Cus/MOTOR_DRV/motor.c ****         dir = MOTOR_FORWARD;
  76:Cus/MOTOR_DRV/motor.c ****         abs_speed = (uint32_t)speed;
  77:Cus/MOTOR_DRV/motor.c ****     } else if (speed < 0) {
  78:Cus/MOTOR_DRV/motor.c ****         dir = MOTOR_BACKWARD;
  79:Cus/MOTOR_DRV/motor.c ****         abs_speed = (uint32_t)(-speed);
  80:Cus/MOTOR_DRV/motor.c ****     } else {
  81:Cus/MOTOR_DRV/motor.c ****         dir = MOTOR_STOP;
  82:Cus/MOTOR_DRV/motor.c ****         abs_speed = 0;
  83:Cus/MOTOR_DRV/motor.c ****     }
  84:Cus/MOTOR_DRV/motor.c ****     
  85:Cus/MOTOR_DRV/motor.c ****     // 限制最大值为1000
  86:Cus/MOTOR_DRV/motor.c ****     if (abs_speed > 1000) {
  87:Cus/MOTOR_DRV/motor.c ****         abs_speed = 1000;
ARM GAS  /tmp/ccJ2KOWs.s 			page 3


  88:Cus/MOTOR_DRV/motor.c ****     }
  89:Cus/MOTOR_DRV/motor.c ****     
  90:Cus/MOTOR_DRV/motor.c ****     // 设置方向
  91:Cus/MOTOR_DRV/motor.c ****     Motor_SetDirection(hmotor, dir);
  92:Cus/MOTOR_DRV/motor.c ****     
  93:Cus/MOTOR_DRV/motor.c ****     // 直接设置PWM值
  94:Cus/MOTOR_DRV/motor.c ****     __HAL_TIM_SET_COMPARE(hmotor->htim, hmotor->channel, abs_speed);
  95:Cus/MOTOR_DRV/motor.c ****     
  96:Cus/MOTOR_DRV/motor.c ****     // 更新当前状态
  97:Cus/MOTOR_DRV/motor.c ****     hmotor->current_speed = abs_speed;
  98:Cus/MOTOR_DRV/motor.c ****     hmotor->current_dir = dir;
  99:Cus/MOTOR_DRV/motor.c **** }
