 106:Middlewares/Third_Party/LibJPEG/source/jdmaster.c **** 
 107:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****   /* In selecting the actual DCT scaling for each component, we try to
 108:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****    * scale up the chroma components via IDCT scaling rather than upsampling.
 109:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****    * This saves time if the upsampler gets to use 1:1 scaling.
 110:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****    * Note this code adapts subsampling ratios which are powers of 2.
 111:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****    */
 112:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****   for (ci = 0, compptr = cinfo->comp_info; ci < cinfo->num_components;
 113:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****        ci++, compptr++) {
 114:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****     int ssize = 1;
 115:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****     while (cinfo->min_DCT_h_scaled_size * ssize <=
 116:Middlewares/Third_Party/LibJPEG/source/jdmaster.c **** 	   (cinfo->do_fancy_upsampling ? DCTSIZE : DCTSIZE / 2) &&
 117:Middlewares/Third_Party/LibJPEG/source/jdmaster.c **** 	   (cinfo->max_h_samp_factor % (compptr->h_samp_factor * ssize * 2)) == 0) {
 118:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****       ssize = ssize * 2;
 119:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****     }
 120:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****     compptr->DCT_h_scaled_size = cinfo->min_DCT_h_scaled_size * ssize;
 121:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****     ssize = 1;
 122:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****     while (cinfo->min_DCT_v_scaled_size * ssize <=
