 101:Middlewares/Third_Party/LibJPEG/source/jdmaster.c **** 
 102:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****   /* Compute core output image dimensions and DCT scaling choices. */
 103:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****   jpeg_core_output_dimensions(cinfo);
