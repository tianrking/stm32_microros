 185:Middlewares/Third_Party/LibJPEG/source/jdmaster.c **** /*
 186:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****  * Several decompression processes need to range-limit values to the range
 187:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****  * 0..MAXJSAMPLE; the input value may fall somewhat outside this range
 188:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****  * due to noise introduced by quantization, roundoff error, etc.  These
 189:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****  * processes are inner loops and need to be as fast as possible.  On most
 190:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****  * machines, particularly CPUs with pipelines or instruction prefetch,
 191:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****  * a (subscript-check-less) C table lookup
 192:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****  *		x = sample_range_limit[x];
 193:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****  * is faster than explicit tests
 194:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****  *		if (x < 0)  x = 0;
 195:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****  *		else if (x > MAXJSAMPLE)  x = MAXJSAMPLE;
 196:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****  * These processes all use a common table prepared by the routine below.
 197:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****  *
 198:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****  * For most steps we can mathematically guarantee that the initial value
 199:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****  * of x is within MAXJSAMPLE+1 of the legal range, so a table running from
 200:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****  * -(MAXJSAMPLE+1) to 2*MAXJSAMPLE+1 is sufficient.  But for the initial
 201:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****  * limiting step (just after the IDCT), a wildly out-of-range value is 
 202:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****  * possible if the input data is corrupt.  To avoid any chance of indexing
 203:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****  * off the end of memory and getting a bad-pointer trap, we perform the
 204:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****  * post-IDCT limiting thus:
 205:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****  *		x = range_limit[x & MASK];
 206:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****  * where MASK is 2 bits wider than legal sample data, ie 10 bits for 8-bit
 207:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****  * samples.  Under normal circumstances this is more than enough range and
 208:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****  * a correct output will be generated; with bogus input data the mask will
 209:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****  * cause wraparound, and we will safely generate a bogus-but-in-range output.
 210:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****  * For the post-IDCT step, we want to convert the data from signed to unsigned
 211:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****  * representation by adding CENTERJSAMPLE at the same time that we limit it.
ARM GAS  /tmp/ccW1rWnO.s 			page 8


 212:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****  * So the post-IDCT limiting table ends up looking like this:
 213:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****  *   CENTERJSAMPLE,CENTERJSAMPLE+1,...,MAXJSAMPLE,
 214:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****  *   MAXJSAMPLE (repeat 2*(MAXJSAMPLE+1)-CENTERJSAMPLE times),
 215:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****  *   0          (repeat 2*(MAXJSAMPLE+1)-CENTERJSAMPLE times),
 216:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****  *   0,1,...,CENTERJSAMPLE-1
 217:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****  * Negative inputs select values from the upper half of the table after
 218:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****  * masking.
 219:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****  *
 220:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****  * We can save some space by overlapping the start of the post-IDCT table
 221:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****  * with the simpler range limiting table.  The post-IDCT table begins at
 222:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****  * sample_range_limit + CENTERJSAMPLE.
 223:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****  *
 224:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****  * Note that the table is allocated in near data space on PCs; it's small
 225:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****  * enough and used often enough to justify this.
 226:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****  */
 227:Middlewares/Third_Party/LibJPEG/source/jdmaster.c **** 
 228:Middlewares/Third_Party/LibJPEG/source/jdmaster.c **** LOCAL(void)
 229:Middlewares/Third_Party/LibJPEG/source/jdmaster.c **** prepare_range_limit_table (j_decompress_ptr cinfo)
 230:Middlewares/Third_Party/LibJPEG/source/jdmaster.c **** /* Allocate and fill in the sample_range_limit table */
 231:Middlewares/Third_Party/LibJPEG/source/jdmaster.c **** {
 232:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****   JSAMPLE * table;
 233:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****   int i;
 234:Middlewares/Third_Party/LibJPEG/source/jdmaster.c **** 
 235:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****   table = (JSAMPLE *)
 236:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****     (*cinfo->mem->alloc_small) ((j_common_ptr) cinfo, JPOOL_IMAGE,
 237:Middlewares/Third_Party/LibJPEG/source/jdmaster.c **** 		(5 * (MAXJSAMPLE+1) + CENTERJSAMPLE) * SIZEOF(JSAMPLE));
 238:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****   table += (MAXJSAMPLE+1);	/* allow negative subscripts of simple table */
 239:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****   cinfo->sample_range_limit = table;
 240:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****   /* First segment of "simple" table: limit[x] = 0 for x < 0 */
 241:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****   MEMZERO(table - (MAXJSAMPLE+1), (MAXJSAMPLE+1) * SIZEOF(JSAMPLE));
 242:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****   /* Main part of "simple" table: limit[x] = x */
 243:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****   for (i = 0; i <= MAXJSAMPLE; i++)
 244:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****     table[i] = (JSAMPLE) i;
 245:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****   table += CENTERJSAMPLE;	/* Point to where post-IDCT table starts */
 246:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****   /* End of simple table, rest of first half of post-IDCT table */
 247:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****   for (i = CENTERJSAMPLE; i < 2*(MAXJSAMPLE+1); i++)
 248:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****     table[i] = MAXJSAMPLE;
 249:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****   /* Second half of post-IDCT table */
 250:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****   MEMZERO(table + (2 * (MAXJSAMPLE+1)),
 251:Middlewares/Third_Party/LibJPEG/source/jdmaster.c **** 	  (2 * (MAXJSAMPLE+1) - CENTERJSAMPLE) * SIZEOF(JSAMPLE));
 252:Middlewares/Third_Party/LibJPEG/source/jdmaster.c ****   MEMCOPY(table + (4 * (MAXJSAMPLE+1) - CENTERJSAMPLE),
 253:Middlewares/Third_Party/LibJPEG/source/jdmaster.c **** 	  cinfo->sample_range_limit, CENTERJSAMPLE * SIZEOF(JSAMPLE));
 254:Middlewares/Third_Party/LibJPEG/source/jdmaster.c **** }
 255:Middlewares/Third_Party/LibJPEG/source/jdmaster.c **** 
 256:Middlewares/Third_Party/LibJPEG/source/jdmaster.c **** 
