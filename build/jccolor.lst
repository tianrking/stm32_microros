  29:Middlewares/Third_Party/LibJPEG/source/jccolor.c **** /**************** RGB -> YCbCr conversion: most common case **************/
  30:Middlewares/Third_Party/LibJPEG/source/jccolor.c **** 
ARM GAS  /tmp/ccxwFal8.s 			page 2


  31:Middlewares/Third_Party/LibJPEG/source/jccolor.c **** /*
  32:Middlewares/Third_Party/LibJPEG/source/jccolor.c ****  * YCbCr is defined per CCIR 601-1, except that Cb and Cr are
  33:Middlewares/Third_Party/LibJPEG/source/jccolor.c ****  * normalized to the range 0..MAXJSAMPLE rather than -0.5 .. 0.5.
  34:Middlewares/Third_Party/LibJPEG/source/jccolor.c ****  * The conversion equations to be implemented are therefore
  35:Middlewares/Third_Party/LibJPEG/source/jccolor.c ****  *	Y  =  0.29900 * R + 0.58700 * G + 0.11400 * B
  36:Middlewares/Third_Party/LibJPEG/source/jccolor.c ****  *	Cb = -0.16874 * R - 0.33126 * G + 0.50000 * B  + CENTERJSAMPLE
  37:Middlewares/Third_Party/LibJPEG/source/jccolor.c ****  *	Cr =  0.50000 * R - 0.41869 * G - 0.08131 * B  + CENTERJSAMPLE
  38:Middlewares/Third_Party/LibJPEG/source/jccolor.c ****  * (These numbers are derived from TIFF 6.0 section 21, dated 3-June-92.)
  39:Middlewares/Third_Party/LibJPEG/source/jccolor.c ****  * Note: older versions of the IJG code used a zero offset of MAXJSAMPLE/2,
  40:Middlewares/Third_Party/LibJPEG/source/jccolor.c ****  * rather than CENTERJSAMPLE, for Cb and Cr.  This gave equal positive and
  41:Middlewares/Third_Party/LibJPEG/source/jccolor.c ****  * negative swings for Cb/Cr, but meant that grayscale values (Cb=Cr=0)
  42:Middlewares/Third_Party/LibJPEG/source/jccolor.c ****  * were not represented exactly.  Now we sacrifice exact representation of
  43:Middlewares/Third_Party/LibJPEG/source/jccolor.c ****  * maximum red and maximum blue in order to get exact grayscales.
  44:Middlewares/Third_Party/LibJPEG/source/jccolor.c ****  *
  45:Middlewares/Third_Party/LibJPEG/source/jccolor.c ****  * To avoid floating-point arithmetic, we represent the fractional constants
  46:Middlewares/Third_Party/LibJPEG/source/jccolor.c ****  * as integers scaled up by 2^16 (about 4 digits precision); we have to divide
  47:Middlewares/Third_Party/LibJPEG/source/jccolor.c ****  * the products by 2^16, with appropriate rounding, to get the correct answer.
  48:Middlewares/Third_Party/LibJPEG/source/jccolor.c ****  *
  49:Middlewares/Third_Party/LibJPEG/source/jccolor.c ****  * For even more speed, we avoid doing any multiplications in the inner loop
  50:Middlewares/Third_Party/LibJPEG/source/jccolor.c ****  * by precalculating the constants times R,G,B for all possible values.
  51:Middlewares/Third_Party/LibJPEG/source/jccolor.c ****  * For 8-bit JSAMPLEs this is very reasonable (only 256 entries per table);
  52:Middlewares/Third_Party/LibJPEG/source/jccolor.c ****  * for 12-bit samples it is still acceptable.  It's not very reasonable for
  53:Middlewares/Third_Party/LibJPEG/source/jccolor.c ****  * 16-bit samples, but if you want lossless storage you shouldn't be changing
  54:Middlewares/Third_Party/LibJPEG/source/jccolor.c ****  * colorspace anyway.
  55:Middlewares/Third_Party/LibJPEG/source/jccolor.c ****  * The CENTERJSAMPLE offsets and the rounding fudge-factor of 0.5 are included
  56:Middlewares/Third_Party/LibJPEG/source/jccolor.c ****  * in the tables to save adding them separately in the inner loop.
  57:Middlewares/Third_Party/LibJPEG/source/jccolor.c ****  */
  58:Middlewares/Third_Party/LibJPEG/source/jccolor.c **** 
  59:Middlewares/Third_Party/LibJPEG/source/jccolor.c **** #define SCALEBITS	16	/* speediest right-shift on some machines */
  60:Middlewares/Third_Party/LibJPEG/source/jccolor.c **** #define CBCR_OFFSET	((INT32) CENTERJSAMPLE << SCALEBITS)
  61:Middlewares/Third_Party/LibJPEG/source/jccolor.c **** #define ONE_HALF	((INT32) 1 << (SCALEBITS-1))
  62:Middlewares/Third_Party/LibJPEG/source/jccolor.c **** #define FIX(x)		((INT32) ((x) * (1L<<SCALEBITS) + 0.5))
  63:Middlewares/Third_Party/LibJPEG/source/jccolor.c **** 
  64:Middlewares/Third_Party/LibJPEG/source/jccolor.c **** /* We allocate one big table and divide it up into eight parts, instead of
  65:Middlewares/Third_Party/LibJPEG/source/jccolor.c ****  * doing eight alloc_small requests.  This lets us use a single table base
  66:Middlewares/Third_Party/LibJPEG/source/jccolor.c ****  * address, which can be held in a register in the inner loops on many
  67:Middlewares/Third_Party/LibJPEG/source/jccolor.c ****  * machines (more than can hold all eight addresses, anyway).
  68:Middlewares/Third_Party/LibJPEG/source/jccolor.c ****  */
  69:Middlewares/Third_Party/LibJPEG/source/jccolor.c **** 
  70:Middlewares/Third_Party/LibJPEG/source/jccolor.c **** #define R_Y_OFF		0			/* offset to R => Y section */
  71:Middlewares/Third_Party/LibJPEG/source/jccolor.c **** #define G_Y_OFF		(1*(MAXJSAMPLE+1))	/* offset to G => Y section */
  72:Middlewares/Third_Party/LibJPEG/source/jccolor.c **** #define B_Y_OFF		(2*(MAXJSAMPLE+1))	/* etc. */
  73:Middlewares/Third_Party/LibJPEG/source/jccolor.c **** #define R_CB_OFF	(3*(MAXJSAMPLE+1))
  74:Middlewares/Third_Party/LibJPEG/source/jccolor.c **** #define G_CB_OFF	(4*(MAXJSAMPLE+1))
  75:Middlewares/Third_Party/LibJPEG/source/jccolor.c **** #define B_CB_OFF	(5*(MAXJSAMPLE+1))
  76:Middlewares/Third_Party/LibJPEG/source/jccolor.c **** #define R_CR_OFF	B_CB_OFF		/* B=>Cb, R=>Cr are the same */
  77:Middlewares/Third_Party/LibJPEG/source/jccolor.c **** #define G_CR_OFF	(6*(MAXJSAMPLE+1))
  78:Middlewares/Third_Party/LibJPEG/source/jccolor.c **** #define B_CR_OFF	(7*(MAXJSAMPLE+1))
  79:Middlewares/Third_Party/LibJPEG/source/jccolor.c **** #define TABLE_SIZE	(8*(MAXJSAMPLE+1))
  80:Middlewares/Third_Party/LibJPEG/source/jccolor.c **** 
  81:Middlewares/Third_Party/LibJPEG/source/jccolor.c **** 
