 562:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   if (cinfo->restart_interval) {
 563:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****     if (entropy->restarts_to_go == 0) {
 564:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****       emit_restart(cinfo, entropy->next_restart_num);
 565:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****       entropy->restarts_to_go = cinfo->restart_interval;
 566:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****       entropy->next_restart_num++;
 567:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****       entropy->next_restart_num &= 7;
 568:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****     }
 569:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****     entropy->restarts_to_go--;
 570:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   }
 571:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 
 572:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   st = entropy->fixed_bin;	/* use fixed probability estimation */
 573:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   Al = cinfo->Al;
 574:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 
