 498:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****     for (;;) {
 499:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****       if ((v = (*block)[natural_order[k]]) >= 0) {
 500:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 	if (v >>= cinfo->Al) {
 501:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 	  arith_encode(cinfo, st + 1, 1);
 502:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 	  arith_encode(cinfo, entropy->fixed_bin, 0);
 503:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 	  break;
 504:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 	}
 505:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****       } else {
 506:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 	v = -v;
 507:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 	if (v >>= cinfo->Al) {
 508:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 	  arith_encode(cinfo, st + 1, 1);
 509:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 	  arith_encode(cinfo, entropy->fixed_bin, 1);
 510:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 	  break;
 511:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 	}
 512:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****       }
 513:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****       arith_encode(cinfo, st + 1, 0); st += 3; k++;
 514:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****     }
 515:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****     st += 2;
 516:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****     /* Figure F.8: Encoding the magnitude category of v */
 517:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****     m = 0;
 518:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****     if (v -= 1) {
 519:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****       arith_encode(cinfo, st, 1);
 520:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****       m = 1;
 521:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****       v2 = v;
ARM GAS  /tmp/ccKuXqzp.s 			page 26


 522:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****       if (v2 >>= 1) {
 523:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 	arith_encode(cinfo, st, 1);
 524:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 	m <<= 1;
 525:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 	st = entropy->ac_stats[tbl] +
 526:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 	     (k <= cinfo->arith_ac_K[tbl] ? 189 : 217);
 527:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 	while (v2 >>= 1) {
 528:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 	  arith_encode(cinfo, st, 1);
 529:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 	  m <<= 1;
 530:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 	  st += 1;
 531:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 	}
 532:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****       }
 533:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****     }
 534:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****     arith_encode(cinfo, st, 0);
 535:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****     /* Figure F.9: Encoding the magnitude bit pattern of v */
 536:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****     st += 14;
 537:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****     while (m >>= 1)
 538:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****       arith_encode(cinfo, st, (m & v) ? 1 : 0);
 539:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   }
 540:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   /* Encode EOB decision only if k <= cinfo->Se */
 541:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   if (k <= cinfo->Se) {
 542:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****     st = entropy->ac_stats[tbl] + 3 * (k - 1);
 543:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****     arith_encode(cinfo, st, 1);
 544:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   }
 545:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 
 546:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   return TRUE;
 547:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** }
