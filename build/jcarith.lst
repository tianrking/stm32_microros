 447:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** /*
 448:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  * MCU encoding for AC initial scan (either spectral selection,
 449:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  * or first pass of successive approximation).
 450:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  */
 451:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 
 452:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** METHODDEF(boolean)
 453:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** encode_mcu_AC_first (j_compress_ptr cinfo, JBLOCKROW *MCU_data)
 454:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** {
 455:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   arith_entropy_ptr entropy = (arith_entropy_ptr) cinfo->entropy;
 456:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   JBLOCKROW block;
 457:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   unsigned char *st;
 458:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   int tbl, k, ke;
 459:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   int v, v2, m;
 460:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   const int * natural_order;
 461:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 
 462:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   /* Emit restart marker if needed */
 463:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   if (cinfo->restart_interval) {
 464:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****     if (entropy->restarts_to_go == 0) {
ARM GAS  /tmp/ccKuXqzp.s 			page 25


 465:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****       emit_restart(cinfo, entropy->next_restart_num);
 466:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****       entropy->restarts_to_go = cinfo->restart_interval;
 467:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****       entropy->next_restart_num++;
 468:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****       entropy->next_restart_num &= 7;
 469:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****     }
 470:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****     entropy->restarts_to_go--;
 471:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   }
 472:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 
 473:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   natural_order = cinfo->natural_order;
 474:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 
 475:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   /* Encode the MCU data block */
 476:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   block = MCU_data[0];
 477:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   tbl = cinfo->cur_comp_info[0]->ac_tbl_no;
 478:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 
 479:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   /* Sections F.1.4.2 & F.1.4.4.2: Encoding of AC coefficients */
 480:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 
 481:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   /* Establish EOB (end-of-block) index */
 482:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   for (ke = cinfo->Se; ke > 0; ke--)
 483:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****     /* We must apply the point transform by Al.  For AC coefficients this
 484:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****      * is an integer division with rounding towards 0.  To do this portably
 485:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****      * in C, we shift after obtaining the absolute value.
 486:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****      */
 487:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****     if ((v = (*block)[natural_order[ke]]) >= 0) {
 488:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****       if (v >>= cinfo->Al) break;
 489:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****     } else {
 490:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****       v = -v;
 491:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****       if (v >>= cinfo->Al) break;
 492:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****     }
 493:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 
 494:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   /* Figure F.5: Encode_AC_Coefficients */
 495:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   for (k = cinfo->Ss; k <= ke; k++) {
 496:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****     st = entropy->ac_stats[tbl] + 3 * (k - 1);
