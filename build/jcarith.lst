 314:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** /*
 315:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  * Emit a restart marker & resynchronize predictions.
 316:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  */
 317:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 
 318:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** LOCAL(void)
 319:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** emit_restart (j_compress_ptr cinfo, int restart_num)
 320:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** {
 321:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   arith_entropy_ptr entropy = (arith_entropy_ptr) cinfo->entropy;
 322:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   int ci;
 323:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   jpeg_component_info * compptr;
 324:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 
 325:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   finish_pass(cinfo);
 326:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 
 327:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   emit_byte(0xFF, cinfo);
 328:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   emit_byte(JPEG_RST0 + restart_num, cinfo);
 329:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 
 330:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   /* Re-initialize statistics areas */
 331:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   for (ci = 0; ci < cinfo->comps_in_scan; ci++) {
 332:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****     compptr = cinfo->cur_comp_info[ci];
 333:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****     /* DC needs no table for refinement scan */
 334:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****     if (cinfo->Ss == 0 && cinfo->Ah == 0) {
 335:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****       MEMZERO(entropy->dc_stats[compptr->dc_tbl_no], DC_STAT_BINS);
 336:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****       /* Reset DC predictions to 0 */
 337:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****       entropy->last_dc_val[ci] = 0;
 338:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****       entropy->dc_context[ci] = 0;
 339:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****     }
 340:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****     /* AC needs no table when not present */
 341:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****     if (cinfo->Se) {
 342:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****       MEMZERO(entropy->ac_stats[compptr->ac_tbl_no], AC_STAT_BINS);
 343:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****     }
 344:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   }
 345:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 
 346:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   /* Reset arithmetic encoding variables */
 347:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   entropy->c = 0;
 348:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   entropy->a = 0x10000L;
 349:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   entropy->sc = 0;
 350:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   entropy->zc = 0;
ARM GAS  /tmp/ccKuXqzp.s 			page 23


 351:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   entropy->ct = 11;
 352:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   entropy->buffer = -1;  /* empty */
 353:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** }
 354:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 
 355:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 
 356:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** /*
 357:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  * MCU encoding for DC initial scan (either spectral selection,
 358:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  * or first pass of successive approximation).
 359:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  */
 360:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 
 361:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** METHODDEF(boolean)
 362:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** encode_mcu_DC_first (j_compress_ptr cinfo, JBLOCKROW *MCU_data)
 363:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** {
 364:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   arith_entropy_ptr entropy = (arith_entropy_ptr) cinfo->entropy;
 365:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   JBLOCKROW block;
 366:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   unsigned char *st;
 367:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   int blkn, ci, tbl;
 368:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   int v, v2, m;
 369:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   ISHIFT_TEMPS
 370:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 
 371:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   /* Emit restart marker if needed */
 372:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   if (cinfo->restart_interval) {
 373:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****     if (entropy->restarts_to_go == 0) {
 374:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****       emit_restart(cinfo, entropy->next_restart_num);
 375:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****       entropy->restarts_to_go = cinfo->restart_interval;
 376:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****       entropy->next_restart_num++;
 377:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****       entropy->next_restart_num &= 7;
 378:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****     }
 379:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****     entropy->restarts_to_go--;
 380:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   }
 381:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 
 382:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   /* Encode the MCU data blocks */
 383:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   for (blkn = 0; blkn < cinfo->blocks_in_MCU; blkn++) {
 384:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****     block = MCU_data[blkn];
 385:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****     ci = cinfo->MCU_membership[blkn];
 386:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****     tbl = cinfo->cur_comp_info[ci]->dc_tbl_no;
 387:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 
 388:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****     /* Compute the DC value after the required point transform by Al.
 389:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****      * This is simply an arithmetic right shift.
 390:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****      */
 391:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****     m = IRIGHT_SHIFT((int) ((*block)[0]), cinfo->Al);
 392:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 
 393:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****     /* Sections F.1.4.1 & F.1.4.4.1: Encoding of DC coefficients */
 394:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 
 395:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****     /* Table F.4: Point to statistics bin S0 for DC coefficient coding */
 396:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****     st = entropy->dc_stats[tbl] + entropy->dc_context[ci];
 397:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 
 398:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****     /* Figure F.4: Encode_DC_DIFF */
 399:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****     if ((v = m - entropy->last_dc_val[ci]) == 0) {
 400:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****       arith_encode(cinfo, st, 0);
 401:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****       entropy->dc_context[ci] = 0;	/* zero diff category */
 402:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****     } else {
 403:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****       entropy->last_dc_val[ci] = m;
