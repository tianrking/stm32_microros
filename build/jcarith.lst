   3:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  *
   4:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  * Developed 1997-2011 by Guido Vollbeding.
   5:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  * This file is part of the Independent JPEG Group's software.
   6:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  * For conditions of distribution and use, see the accompanying README file.
   7:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  *
   8:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  * This file contains portable arithmetic entropy encoding routines for JPEG
   9:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  * (implementing the ISO/IEC IS 10918-1 and CCITT Recommendation ITU-T T.81).
  10:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  *
  11:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  * Both sequential and progressive modes are supported in this single module.
  12:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  *
  13:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  * Suspension is not currently supported in this module.
  14:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  */
  15:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 
  16:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** #define JPEG_INTERNALS
  17:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** #include "jinclude.h"
  18:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** #include "jpeglib.h"
  19:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 
  20:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 
  21:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** /* Expanded entropy encoder object for arithmetic encoding. */
  22:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 
  23:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** typedef struct {
  24:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   struct jpeg_entropy_encoder pub; /* public fields */
  25:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 
  26:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   INT32 c; /* C register, base of coding interval, layout as in sec. D.1.3 */
  27:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   INT32 a;               /* A register, normalized size of coding interval */
  28:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   INT32 sc;        /* counter for stacked 0xFF values which might overflow */
  29:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   INT32 zc;          /* counter for pending 0x00 output values which might *
  30:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****                           * be discarded at the end ("Pacman" termination) */
ARM GAS  /tmp/ccKuXqzp.s 			page 2


  31:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   int ct;  /* bit shift counter, determines when next byte will be written */
  32:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   int buffer;                /* buffer for most recent output byte != 0xFF */
  33:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 
  34:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   int last_dc_val[MAX_COMPS_IN_SCAN]; /* last DC coef for each component */
  35:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   int dc_context[MAX_COMPS_IN_SCAN]; /* context index for DC conditioning */
  36:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 
  37:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   unsigned int restarts_to_go;	/* MCUs left in this restart interval */
  38:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   int next_restart_num;		/* next restart number to write (0-7) */
  39:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 
  40:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   /* Pointers to statistics areas (these workspaces have image lifespan) */
  41:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   unsigned char * dc_stats[NUM_ARITH_TBLS];
  42:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   unsigned char * ac_stats[NUM_ARITH_TBLS];
  43:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 
  44:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   /* Statistics bin for coding with fixed probability 0.5 */
  45:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****   unsigned char fixed_bin[4];
  46:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** } arith_entropy_encoder;
  47:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 
  48:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** typedef arith_entropy_encoder * arith_entropy_ptr;
  49:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 
  50:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** /* The following two definitions specify the allocation chunk size
  51:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  * for the statistics area.
  52:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  * According to sections F.1.4.4.1.3 and F.1.4.4.2, we need at least
  53:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  * 49 statistics bins for DC, and 245 statistics bins for AC coding.
  54:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  *
  55:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  * We use a compact representation with 1 byte per statistics bin,
  56:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  * thus the numbers directly represent byte sizes.
  57:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  * This 1 byte per statistics bin contains the meaning of the MPS
  58:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  * (more probable symbol) in the highest bit (mask 0x80), and the
  59:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  * index into the probability estimation state machine table
  60:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  * in the lower bits (mask 0x7F).
  61:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  */
  62:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 
  63:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** #define DC_STAT_BINS 64
  64:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** #define AC_STAT_BINS 256
  65:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 
  66:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** /* NOTE: Uncomment the following #define if you want to use the
  67:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  * given formula for calculating the AC conditioning parameter Kx
  68:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  * for spectral selection progressive coding in section G.1.3.2
  69:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  * of the spec (Kx = Kmin + SRL (8 + Se - Kmin) 4).
  70:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  * Although the spec and P&M authors claim that this "has proven
  71:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  * to give good results for 8 bit precision samples", I'm not
  72:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  * convinced yet that this is really beneficial.
  73:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  * Early tests gave only very marginal compression enhancements
  74:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  * (a few - around 5 or so - bytes even for very large files),
  75:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  * which would turn out rather negative if we'd suppress the
  76:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  * DAC (Define Arithmetic Conditioning) marker segments for
  77:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  * the default parameters in the future.
  78:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  * Note that currently the marker writing module emits 12-byte
  79:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  * DAC segments for a full-component scan in a color image.
  80:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  * This is not worth worrying about IMHO. However, since the
  81:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  * spec defines the default values to be used if the tables
  82:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  * are omitted (unlike Huffman tables, which are required
  83:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  * anyway), one might optimize this behaviour in the future,
  84:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  * and then it would be disadvantageous to use custom tables if
  85:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  * they don't provide sufficient gain to exceed the DAC size.
  86:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  *
  87:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  * On the other hand, I'd consider it as a reasonable result
ARM GAS  /tmp/ccKuXqzp.s 			page 3


  88:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  * that the conditioning has no significant influence on the
  89:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  * compression performance. This means that the basic
  90:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  * statistical model is already rather stable.
  91:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  *
  92:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  * Thus, at the moment, we use the default conditioning values
  93:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  * anyway, and do not use the custom formula.
  94:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  *
  95:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** #define CALCULATE_SPECTRAL_CONDITIONING
  96:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  */
  97:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 
  98:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** /* IRIGHT_SHIFT is like RIGHT_SHIFT, but works on int rather than INT32.
  99:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  * We assume that int right shift is unsigned if INT32 right shift is,
 100:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  * which should be safe.
 101:Middlewares/Third_Party/LibJPEG/source/jcarith.c ****  */
 102:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 
 103:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** #ifdef RIGHT_SHIFT_IS_UNSIGNED
 104:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** #define ISHIFT_TEMPS	int ishift_temp;
 105:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** #define IRIGHT_SHIFT(x,shft)  \
 106:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 	((ishift_temp = (x)) < 0 ? \
 107:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 	 (ishift_temp >> (shft)) | ((~0) << (16-(shft))) : \
 108:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** 	 (ishift_temp >> (shft)))
 109:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** #else
 110:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** #define ISHIFT_TEMPS
 111:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** #define IRIGHT_SHIFT(x,shft)	((x) >> (shft))
 112:Middlewares/Third_Party/LibJPEG/source/jcarith.c **** #endif
