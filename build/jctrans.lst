  26:Middlewares/Third_Party/LibJPEG/source/jctrans.c **** /*
  27:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****  * Compression initialization for writing raw-coefficient data.
  28:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****  * Before calling this, all parameters and a data destination must be set up.
  29:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****  * Call jpeg_finish_compress() to actually write the data.
  30:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****  *
ARM GAS  /tmp/ccrL6ShV.s 			page 2


  31:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****  * The number of passed virtual arrays must match cinfo->num_components.
  32:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****  * Note that the virtual arrays need not be filled or even realized at
  33:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****  * the time write_coefficients is called; indeed, if the virtual arrays
  34:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****  * were requested from this compression object's memory manager, they
  35:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****  * typically will be realized during this routine and filled afterwards.
  36:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****  */
  37:Middlewares/Third_Party/LibJPEG/source/jctrans.c **** 
  38:Middlewares/Third_Party/LibJPEG/source/jctrans.c **** GLOBAL(void)
  39:Middlewares/Third_Party/LibJPEG/source/jctrans.c **** jpeg_write_coefficients (j_compress_ptr cinfo, jvirt_barray_ptr * coef_arrays)
  40:Middlewares/Third_Party/LibJPEG/source/jctrans.c **** {
  41:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   if (cinfo->global_state != CSTATE_START)
  42:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****     ERREXIT1(cinfo, JERR_BAD_STATE, cinfo->global_state);
  43:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   /* Mark all tables to be written */
  44:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   jpeg_suppress_tables(cinfo, FALSE);
  45:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   /* (Re)initialize error mgr and destination modules */
  46:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   (*cinfo->err->reset_error_mgr) ((j_common_ptr) cinfo);
  47:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   (*cinfo->dest->init_destination) (cinfo);
  48:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   /* Perform master selection of active modules */
  49:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   transencode_master_selection(cinfo, coef_arrays);
  50:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   /* Wait for jpeg_finish_compress() call */
  51:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   cinfo->next_scanline = 0;	/* so jpeg_write_marker works */
  52:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   cinfo->global_state = CSTATE_WRCOEFS;
  53:Middlewares/Third_Party/LibJPEG/source/jctrans.c **** }
  54:Middlewares/Third_Party/LibJPEG/source/jctrans.c **** 
  55:Middlewares/Third_Party/LibJPEG/source/jctrans.c **** 
  56:Middlewares/Third_Party/LibJPEG/source/jctrans.c **** /*
  57:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****  * Initialize the compression object with default parameters,
  58:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****  * then copy from the source object all parameters needed for lossless
  59:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****  * transcoding.  Parameters that can be varied without loss (such as
  60:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****  * scan script and Huffman optimization) are left in their default states.
  61:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****  */
  62:Middlewares/Third_Party/LibJPEG/source/jctrans.c **** 
  63:Middlewares/Third_Party/LibJPEG/source/jctrans.c **** GLOBAL(void)
  64:Middlewares/Third_Party/LibJPEG/source/jctrans.c **** jpeg_copy_critical_parameters (j_decompress_ptr srcinfo,
  65:Middlewares/Third_Party/LibJPEG/source/jctrans.c **** 			       j_compress_ptr dstinfo)
  66:Middlewares/Third_Party/LibJPEG/source/jctrans.c **** {
  67:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   JQUANT_TBL ** qtblptr;
  68:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   jpeg_component_info *incomp, *outcomp;
  69:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   JQUANT_TBL *c_quant, *slot_quant;
  70:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   int tblno, ci, coefi;
  71:Middlewares/Third_Party/LibJPEG/source/jctrans.c **** 
  72:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   /* Safety check to ensure start_compress not called yet. */
  73:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   if (dstinfo->global_state != CSTATE_START)
  74:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****     ERREXIT1(dstinfo, JERR_BAD_STATE, dstinfo->global_state);
  75:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   /* Copy fundamental image dimensions */
  76:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   dstinfo->image_width = srcinfo->image_width;
  77:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   dstinfo->image_height = srcinfo->image_height;
  78:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   dstinfo->input_components = srcinfo->num_components;
  79:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   dstinfo->in_color_space = srcinfo->jpeg_color_space;
  80:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   dstinfo->jpeg_width = srcinfo->output_width;
  81:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   dstinfo->jpeg_height = srcinfo->output_height;
  82:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   dstinfo->min_DCT_h_scaled_size = srcinfo->min_DCT_h_scaled_size;
  83:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   dstinfo->min_DCT_v_scaled_size = srcinfo->min_DCT_v_scaled_size;
  84:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   /* Initialize all parameters to default values */
  85:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   jpeg_set_defaults(dstinfo);
  86:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   /* jpeg_set_defaults may choose wrong colorspace, eg YCbCr if input is RGB.
  87:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****    * Fix it to get the right header markers for the image colorspace.
ARM GAS  /tmp/ccrL6ShV.s 			page 3


  88:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****    */
  89:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   jpeg_set_colorspace(dstinfo, srcinfo->jpeg_color_space);
  90:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   dstinfo->data_precision = srcinfo->data_precision;
  91:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   dstinfo->CCIR601_sampling = srcinfo->CCIR601_sampling;
  92:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   /* Copy the source's quantization tables. */
  93:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   for (tblno = 0; tblno < NUM_QUANT_TBLS; tblno++) {
  94:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****     if (srcinfo->quant_tbl_ptrs[tblno] != NULL) {
  95:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****       qtblptr = & dstinfo->quant_tbl_ptrs[tblno];
  96:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****       if (*qtblptr == NULL)
