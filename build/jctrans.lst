 147:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****       dstinfo->JFIF_major_version = srcinfo->JFIF_major_version;
 148:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****       dstinfo->JFIF_minor_version = srcinfo->JFIF_minor_version;
 149:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****     }
