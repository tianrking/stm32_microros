 202:Middlewares/Third_Party/LibJPEG/source/jctrans.c **** typedef struct {
 203:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   struct jpeg_c_coef_controller pub; /* public fields */
 204:Middlewares/Third_Party/LibJPEG/source/jctrans.c **** 
 205:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   JDIMENSION iMCU_row_num;	/* iMCU row # within image */
 206:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   JDIMENSION mcu_ctr;		/* counts MCUs processed in current row */
 207:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   int MCU_vert_offset;		/* counts MCU rows within iMCU row */
 208:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   int MCU_rows_per_iMCU_row;	/* number of such rows needed */
 209:Middlewares/Third_Party/LibJPEG/source/jctrans.c **** 
 210:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   /* Virtual block array for each component. */
