 157:Middlewares/Third_Party/LibJPEG/source/jctrans.c **** /*
 158:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****  * Master selection of compression modules for transcoding.
 159:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****  * This substitutes for jcinit.c's initialization of the full compressor.
 160:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****  */
 161:Middlewares/Third_Party/LibJPEG/source/jctrans.c **** 
 162:Middlewares/Third_Party/LibJPEG/source/jctrans.c **** LOCAL(void)
 163:Middlewares/Third_Party/LibJPEG/source/jctrans.c **** transencode_master_selection (j_compress_ptr cinfo,
 164:Middlewares/Third_Party/LibJPEG/source/jctrans.c **** 			      jvirt_barray_ptr * coef_arrays)
 165:Middlewares/Third_Party/LibJPEG/source/jctrans.c **** {
 166:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   /* Initialize master control (includes parameter checking/processing) */
 167:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   jinit_c_master_control(cinfo, TRUE /* transcode only */);
 168:Middlewares/Third_Party/LibJPEG/source/jctrans.c **** 
 169:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   /* Entropy encoding: either Huffman or arithmetic coding. */
 170:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   if (cinfo->arith_code)
 171:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****     jinit_arith_encoder(cinfo);
 172:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   else {
 173:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****     jinit_huff_encoder(cinfo);
 174:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   }
 175:Middlewares/Third_Party/LibJPEG/source/jctrans.c **** 
 176:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   /* We need a special coefficient buffer controller. */
 177:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   transencode_coef_controller(cinfo, coef_arrays);
 178:Middlewares/Third_Party/LibJPEG/source/jctrans.c **** 
 179:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   jinit_marker_writer(cinfo);
 180:Middlewares/Third_Party/LibJPEG/source/jctrans.c **** 
 181:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   /* We can now tell the memory manager to allocate virtual arrays. */
 182:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   (*cinfo->mem->realize_virt_arrays) ((j_common_ptr) cinfo);
 183:Middlewares/Third_Party/LibJPEG/source/jctrans.c **** 
 184:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   /* Write the datastream header (SOI, JFIF) immediately.
 185:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****    * Frame and scan headers are postponed till later.
 186:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****    * This lets application insert special markers after the SOI.
 187:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****    */
 188:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   (*cinfo->marker->write_file_header) (cinfo);
 189:Middlewares/Third_Party/LibJPEG/source/jctrans.c **** }
