  98:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****       MEMCOPY((*qtblptr)->quantval,
  99:Middlewares/Third_Party/LibJPEG/source/jctrans.c **** 	      srcinfo->quant_tbl_ptrs[tblno]->quantval,
 100:Middlewares/Third_Party/LibJPEG/source/jctrans.c **** 	      SIZEOF((*qtblptr)->quantval));
 101:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****       (*qtblptr)->sent_table = FALSE;
 102:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****     }
 103:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   }
 104:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   /* Copy the source's per-component info.
 105:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****    * Note we assume jpeg_set_defaults has allocated the dest comp_info array.
 106:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****    */
 107:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   dstinfo->num_components = srcinfo->num_components;
 108:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   if (dstinfo->num_components < 1 || dstinfo->num_components > MAX_COMPONENTS)
 109:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****     ERREXIT2(dstinfo, JERR_COMPONENT_COUNT, dstinfo->num_components,
 110:Middlewares/Third_Party/LibJPEG/source/jctrans.c **** 	     MAX_COMPONENTS);
 111:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   for (ci = 0, incomp = srcinfo->comp_info, outcomp = dstinfo->comp_info;
 112:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****        ci < dstinfo->num_components; ci++, incomp++, outcomp++) {
 113:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****     outcomp->component_id = incomp->component_id;
 114:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****     outcomp->h_samp_factor = incomp->h_samp_factor;
 115:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****     outcomp->v_samp_factor = incomp->v_samp_factor;
 116:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****     outcomp->quant_tbl_no = incomp->quant_tbl_no;
 117:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****     /* Make sure saved quantization table for component matches the qtable
 118:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****      * slot.  If not, the input file re-used this qtable slot.
 119:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****      * IJG encoder currently cannot duplicate this.
 120:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****      */
 121:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****     tblno = outcomp->quant_tbl_no;
 122:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****     if (tblno < 0 || tblno >= NUM_QUANT_TBLS ||
 123:Middlewares/Third_Party/LibJPEG/source/jctrans.c **** 	srcinfo->quant_tbl_ptrs[tblno] == NULL)
 124:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****       ERREXIT1(dstinfo, JERR_NO_QUANT_TABLE, tblno);
 125:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****     slot_quant = srcinfo->quant_tbl_ptrs[tblno];
 126:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****     c_quant = incomp->quant_table;
 127:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****     if (c_quant != NULL) {
 128:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****       for (coefi = 0; coefi < DCTSIZE2; coefi++) {
 129:Middlewares/Third_Party/LibJPEG/source/jctrans.c **** 	if (c_quant->quantval[coefi] != slot_quant->quantval[coefi])
 130:Middlewares/Third_Party/LibJPEG/source/jctrans.c **** 	  ERREXIT1(dstinfo, JERR_MISMATCHED_QUANT_TABLE, tblno);
 131:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****       }
 132:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****     }
 133:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****     /* Note: we do not copy the source's Huffman table assignments;
 134:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****      * instead we rely on jpeg_set_colorspace to have made a suitable choice.
 135:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****      */
 136:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   }
 137:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****   /* Also copy JFIF version and resolution information, if available.
 138:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****    * Strictly speaking this isn't "critical" info, but it's nearly
 139:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****    * always appropriate to copy it if available.  In particular,
 140:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****    * if the application chooses to copy JFIF 1.02 extension markers from
 141:Middlewares/Third_Party/LibJPEG/source/jctrans.c ****    * the source file, we need to copy the version to make sure we don't
