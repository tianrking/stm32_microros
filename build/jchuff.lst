 609:Middlewares/Third_Party/LibJPEG/source/jchuff.c ****   if (cinfo->restart_interval) {
 610:Middlewares/Third_Party/LibJPEG/source/jchuff.c ****     if (entropy->restarts_to_go == 0) {
