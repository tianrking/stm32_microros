 994:Middlewares/Third_Party/LibJPEG/source/jchuff.c ****       /* or the complement of its magnitude, if negative. */
 995:Middlewares/Third_Party/LibJPEG/source/jchuff.c ****       if (! emit_bits_s(state, (unsigned int) temp2, nbits))
