 587:Middlewares/Third_Party/LibJPEG/source/jchuff.c ****       nbits++;
 588:Middlewares/Third_Party/LibJPEG/source/jchuff.c ****       temp >>= 1;
 589:Middlewares/Third_Party/LibJPEG/source/jchuff.c ****     }
