 787:Middlewares/Third_Party/LibJPEG/source/jchuff.c **** {
 788:Middlewares/Third_Party/LibJPEG/source/jchuff.c ****   huff_entropy_ptr entropy = (huff_entropy_ptr) cinfo->entropy;
