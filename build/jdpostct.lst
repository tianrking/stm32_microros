  22:Middlewares/Third_Party/LibJPEG/source/jdpostct.c **** 
  23:Middlewares/Third_Party/LibJPEG/source/jdpostct.c **** 
  24:Middlewares/Third_Party/LibJPEG/source/jdpostct.c **** /* Private buffer controller object */
  25:Middlewares/Third_Party/LibJPEG/source/jdpostct.c **** 
  26:Middlewares/Third_Party/LibJPEG/source/jdpostct.c **** typedef struct {
  27:Middlewares/Third_Party/LibJPEG/source/jdpostct.c ****   struct jpeg_d_post_controller pub; /* public fields */
  28:Middlewares/Third_Party/LibJPEG/source/jdpostct.c **** 
  29:Middlewares/Third_Party/LibJPEG/source/jdpostct.c ****   /* Color quantization source buffer: this holds output data from
  30:Middlewares/Third_Party/LibJPEG/source/jdpostct.c ****    * the upsample/color conversion step to be passed to the quantizer.
ARM GAS  /tmp/ccZmssoc.s 			page 2


  31:Middlewares/Third_Party/LibJPEG/source/jdpostct.c ****    * For two-pass color quantization, we need a full-image buffer;
  32:Middlewares/Third_Party/LibJPEG/source/jdpostct.c ****    * for one-pass operation, a strip buffer is sufficient.
  33:Middlewares/Third_Party/LibJPEG/source/jdpostct.c ****    */
  34:Middlewares/Third_Party/LibJPEG/source/jdpostct.c ****   jvirt_sarray_ptr whole_image;	/* virtual array, or NULL if one-pass */
  35:Middlewares/Third_Party/LibJPEG/source/jdpostct.c ****   JSAMPARRAY buffer;		/* strip buffer, or current strip of virtual */
  36:Middlewares/Third_Party/LibJPEG/source/jdpostct.c ****   JDIMENSION strip_height;	/* buffer size in rows */
  37:Middlewares/Third_Party/LibJPEG/source/jdpostct.c ****   /* for two-pass mode only: */
  38:Middlewares/Third_Party/LibJPEG/source/jdpostct.c ****   JDIMENSION starting_row;	/* row # of first row in current strip */
  39:Middlewares/Third_Party/LibJPEG/source/jdpostct.c ****   JDIMENSION next_row;		/* index of next row to fill/empty in strip */
  40:Middlewares/Third_Party/LibJPEG/source/jdpostct.c **** } my_post_controller;
  41:Middlewares/Third_Party/LibJPEG/source/jdpostct.c **** 
  42:Middlewares/Third_Party/LibJPEG/source/jdpostct.c **** typedef my_post_controller * my_post_ptr;
