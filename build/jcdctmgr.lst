  90:Middlewares/Third_Party/LibJPEG/source/jcdctmgr.c **** 	qval = divisors[i];
  91:Middlewares/Third_Party/LibJPEG/source/jcdctmgr.c **** 	temp = workspace[i];
  92:Middlewares/Third_Party/LibJPEG/source/jcdctmgr.c **** 	/* Divide the coefficient value by qval, ensuring proper rounding.
  93:Middlewares/Third_Party/LibJPEG/source/jcdctmgr.c **** 	 * Since C does not specify the direction of rounding for negative
  94:Middlewares/Third_Party/LibJPEG/source/jcdctmgr.c **** 	 * quotients, we have to force the dividend positive for portability.
  95:Middlewares/Third_Party/LibJPEG/source/jcdctmgr.c **** 	 *
  96:Middlewares/Third_Party/LibJPEG/source/jcdctmgr.c **** 	 * In most files, at least half of the output values will be zero
  97:Middlewares/Third_Party/LibJPEG/source/jcdctmgr.c **** 	 * (at default quantization settings, more like three-quarters...)
  98:Middlewares/Third_Party/LibJPEG/source/jcdctmgr.c **** 	 * so we should ensure that this case is fast.  On many machines,
  99:Middlewares/Third_Party/LibJPEG/source/jcdctmgr.c **** 	 * a comparison is enough cheaper than a divide to make a special test
 100:Middlewares/Third_Party/LibJPEG/source/jcdctmgr.c **** 	 * a win.  Since both inputs will be nonnegative, we need only test
 101:Middlewares/Third_Party/LibJPEG/source/jcdctmgr.c **** 	 * for a < b to discover whether a/b is 0.
 102:Middlewares/Third_Party/LibJPEG/source/jcdctmgr.c **** 	 * If your machine's division is fast enough, define FAST_DIVIDE.
 103:Middlewares/Third_Party/LibJPEG/source/jcdctmgr.c **** 	 */
 104:Middlewares/Third_Party/LibJPEG/source/jcdctmgr.c **** #ifdef FAST_DIVIDE
 105:Middlewares/Third_Party/LibJPEG/source/jcdctmgr.c **** #define DIVIDE_BY(a,b)	a /= b
 106:Middlewares/Third_Party/LibJPEG/source/jcdctmgr.c **** #else
 107:Middlewares/Third_Party/LibJPEG/source/jcdctmgr.c **** #define DIVIDE_BY(a,b)	if (a >= b) a /= b; else a = 0
 108:Middlewares/Third_Party/LibJPEG/source/jcdctmgr.c **** #endif
 109:Middlewares/Third_Party/LibJPEG/source/jcdctmgr.c **** 	if (temp < 0) {
 110:Middlewares/Third_Party/LibJPEG/source/jcdctmgr.c **** 	  temp = -temp;
