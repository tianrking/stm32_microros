  84:Middlewares/Third_Party/LibJPEG/source/jcdctmgr.c ****     /* Quantize/descale the coefficients, and store into coef_blocks[] */
  85:Middlewares/Third_Party/LibJPEG/source/jcdctmgr.c ****     { register DCTELEM temp, qval;
