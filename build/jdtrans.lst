   5:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****  * Modified 2000-2009 by Guido Vollbeding.
   6:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****  * This file is part of the Independent JPEG Group's software.
   7:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****  * For conditions of distribution and use, see the accompanying README file.
   8:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****  *
   9:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****  * This file contains library routines for transcoding decompression,
  10:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****  * that is, reading raw DCT coefficient arrays from an input JPEG file.
  11:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****  * The routines in jdapimin.c will also be needed by a transcoder.
  12:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****  */
  13:Middlewares/Third_Party/LibJPEG/source/jdtrans.c **** 
  14:Middlewares/Third_Party/LibJPEG/source/jdtrans.c **** #define JPEG_INTERNALS
  15:Middlewares/Third_Party/LibJPEG/source/jdtrans.c **** #include "jinclude.h"
  16:Middlewares/Third_Party/LibJPEG/source/jdtrans.c **** #include "jpeglib.h"
  17:Middlewares/Third_Party/LibJPEG/source/jdtrans.c **** 
  18:Middlewares/Third_Party/LibJPEG/source/jdtrans.c **** 
  19:Middlewares/Third_Party/LibJPEG/source/jdtrans.c **** /* Forward declarations */
  20:Middlewares/Third_Party/LibJPEG/source/jdtrans.c **** LOCAL(void) transdecode_master_selection JPP((j_decompress_ptr cinfo));
  21:Middlewares/Third_Party/LibJPEG/source/jdtrans.c **** 
  22:Middlewares/Third_Party/LibJPEG/source/jdtrans.c **** 
  23:Middlewares/Third_Party/LibJPEG/source/jdtrans.c **** /*
  24:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****  * Read the coefficient arrays from a JPEG file.
  25:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****  * jpeg_read_header must be completed before calling this.
  26:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****  *
  27:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****  * The entire image is read into a set of virtual coefficient-block arrays,
  28:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****  * one per component.  The return value is a pointer to the array of
  29:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****  * virtual-array descriptors.  These can be manipulated directly via the
  30:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****  * JPEG memory manager, or handed off to jpeg_write_coefficients().
ARM GAS  /tmp/ccLSxsS1.s 			page 2


  31:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****  * To release the memory occupied by the virtual arrays, call
  32:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****  * jpeg_finish_decompress() when done with the data.
  33:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****  *
  34:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****  * An alternative usage is to simply obtain access to the coefficient arrays
  35:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****  * during a buffered-image-mode decompression operation.  This is allowed
  36:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****  * after any jpeg_finish_output() call.  The arrays can be accessed until
  37:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****  * jpeg_finish_decompress() is called.  (Note that any call to the library
  38:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****  * may reposition the arrays, so don't rely on access_virt_barray() results
  39:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****  * to stay valid across library calls.)
  40:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****  *
  41:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****  * Returns NULL if suspended.  This case need be checked only if
  42:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****  * a suspending data source is used.
  43:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****  */
  44:Middlewares/Third_Party/LibJPEG/source/jdtrans.c **** 
  45:Middlewares/Third_Party/LibJPEG/source/jdtrans.c **** GLOBAL(jvirt_barray_ptr *)
  46:Middlewares/Third_Party/LibJPEG/source/jdtrans.c **** jpeg_read_coefficients (j_decompress_ptr cinfo)
  47:Middlewares/Third_Party/LibJPEG/source/jdtrans.c **** {
  48:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****   if (cinfo->global_state == DSTATE_READY) {
  49:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****     /* First call: initialize active modules */
  50:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****     transdecode_master_selection(cinfo);
  51:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****     cinfo->global_state = DSTATE_RDCOEFS;
  52:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****   }
  53:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****   if (cinfo->global_state == DSTATE_RDCOEFS) {
  54:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****     /* Absorb whole file into the coef buffer */
  55:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****     for (;;) {
  56:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****       int retcode;
  57:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****       /* Call progress monitor hook if present */
  58:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****       if (cinfo->progress != NULL)
  59:Middlewares/Third_Party/LibJPEG/source/jdtrans.c **** 	(*cinfo->progress->progress_monitor) ((j_common_ptr) cinfo);
  60:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****       /* Absorb some more input */
  61:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****       retcode = (*cinfo->inputctl->consume_input) (cinfo);
  62:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****       if (retcode == JPEG_SUSPENDED)
  63:Middlewares/Third_Party/LibJPEG/source/jdtrans.c **** 	return NULL;
  64:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****       if (retcode == JPEG_REACHED_EOI)
  65:Middlewares/Third_Party/LibJPEG/source/jdtrans.c **** 	break;
  66:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****       /* Advance progress counter if appropriate */
  67:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****       if (cinfo->progress != NULL &&
  68:Middlewares/Third_Party/LibJPEG/source/jdtrans.c **** 	  (retcode == JPEG_ROW_COMPLETED || retcode == JPEG_REACHED_SOS)) {
  69:Middlewares/Third_Party/LibJPEG/source/jdtrans.c **** 	if (++cinfo->progress->pass_counter >= cinfo->progress->pass_limit) {
  70:Middlewares/Third_Party/LibJPEG/source/jdtrans.c **** 	  /* startup underestimated number of scans; ratchet up one scan */
  71:Middlewares/Third_Party/LibJPEG/source/jdtrans.c **** 	  cinfo->progress->pass_limit += (long) cinfo->total_iMCU_rows;
  72:Middlewares/Third_Party/LibJPEG/source/jdtrans.c **** 	}
  73:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****       }
  74:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****     }
  75:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****     /* Set state so that jpeg_finish_decompress does the right thing */
  76:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****     cinfo->global_state = DSTATE_STOPPING;
  77:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****   }
  78:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****   /* At this point we should be in state DSTATE_STOPPING if being used
  79:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****    * standalone, or in state DSTATE_BUFIMAGE if being invoked to get access
  80:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****    * to the coefficients during a full buffered-image-mode decompression.
  81:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****    */
  82:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****   if ((cinfo->global_state == DSTATE_STOPPING ||
  83:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****        cinfo->global_state == DSTATE_BUFIMAGE) && cinfo->buffered_image) {
  84:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****     return cinfo->coef->coef_arrays;
  85:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****   }
  86:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****   /* Oops, improper usage */
  87:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****   ERREXIT1(cinfo, JERR_BAD_STATE, cinfo->global_state);
ARM GAS  /tmp/ccLSxsS1.s 			page 3


  88:Middlewares/Third_Party/LibJPEG/source/jdtrans.c ****   return NULL;			/* keep compiler happy */
  89:Middlewares/Third_Party/LibJPEG/source/jdtrans.c **** }
