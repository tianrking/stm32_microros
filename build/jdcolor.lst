  31:Middlewares/Third_Party/LibJPEG/source/jdcolor.c **** 
  32:Middlewares/Third_Party/LibJPEG/source/jdcolor.c **** typedef my_color_deconverter * my_cconvert_ptr;
  33:Middlewares/Third_Party/LibJPEG/source/jdcolor.c **** 
  34:Middlewares/Third_Party/LibJPEG/source/jdcolor.c **** 
  35:Middlewares/Third_Party/LibJPEG/source/jdcolor.c **** /**************** YCbCr -> RGB conversion: most common case **************/
  36:Middlewares/Third_Party/LibJPEG/source/jdcolor.c **** /****************   RGB -> Y   conversion: less common case **************/
  37:Middlewares/Third_Party/LibJPEG/source/jdcolor.c **** 
  38:Middlewares/Third_Party/LibJPEG/source/jdcolor.c **** /*
  39:Middlewares/Third_Party/LibJPEG/source/jdcolor.c ****  * YCbCr is defined per CCIR 601-1, except that Cb and Cr are
  40:Middlewares/Third_Party/LibJPEG/source/jdcolor.c ****  * normalized to the range 0..MAXJSAMPLE rather than -0.5 .. 0.5.
  41:Middlewares/Third_Party/LibJPEG/source/jdcolor.c ****  * The conversion equations to be implemented are therefore
  42:Middlewares/Third_Party/LibJPEG/source/jdcolor.c ****  *
  43:Middlewares/Third_Party/LibJPEG/source/jdcolor.c ****  *	R = Y                + 1.40200 * Cr
  44:Middlewares/Third_Party/LibJPEG/source/jdcolor.c ****  *	G = Y - 0.34414 * Cb - 0.71414 * Cr
  45:Middlewares/Third_Party/LibJPEG/source/jdcolor.c ****  *	B = Y + 1.77200 * Cb
  46:Middlewares/Third_Party/LibJPEG/source/jdcolor.c ****  *
  47:Middlewares/Third_Party/LibJPEG/source/jdcolor.c ****  *	Y = 0.29900 * R + 0.58700 * G + 0.11400 * B
  48:Middlewares/Third_Party/LibJPEG/source/jdcolor.c ****  *
  49:Middlewares/Third_Party/LibJPEG/source/jdcolor.c ****  * where Cb and Cr represent the incoming values less CENTERJSAMPLE.
  50:Middlewares/Third_Party/LibJPEG/source/jdcolor.c ****  * (These numbers are derived from TIFF 6.0 section 21, dated 3-June-92.)
  51:Middlewares/Third_Party/LibJPEG/source/jdcolor.c ****  *
  52:Middlewares/Third_Party/LibJPEG/source/jdcolor.c ****  * To avoid floating-point arithmetic, we represent the fractional constants
  53:Middlewares/Third_Party/LibJPEG/source/jdcolor.c ****  * as integers scaled up by 2^16 (about 4 digits precision); we have to divide
  54:Middlewares/Third_Party/LibJPEG/source/jdcolor.c ****  * the products by 2^16, with appropriate rounding, to get the correct answer.
  55:Middlewares/Third_Party/LibJPEG/source/jdcolor.c ****  * Notice that Y, being an integral input, does not contribute any fraction
  56:Middlewares/Third_Party/LibJPEG/source/jdcolor.c ****  * so it need not participate in the rounding.
  57:Middlewares/Third_Party/LibJPEG/source/jdcolor.c ****  *
  58:Middlewares/Third_Party/LibJPEG/source/jdcolor.c ****  * For even more speed, we avoid doing any multiplications in the inner loop
  59:Middlewares/Third_Party/LibJPEG/source/jdcolor.c ****  * by precalculating the constants times Cb and Cr for all possible values.
  60:Middlewares/Third_Party/LibJPEG/source/jdcolor.c ****  * For 8-bit JSAMPLEs this is very reasonable (only 256 entries per table);
  61:Middlewares/Third_Party/LibJPEG/source/jdcolor.c ****  * for 12-bit samples it is still acceptable.  It's not very reasonable for
  62:Middlewares/Third_Party/LibJPEG/source/jdcolor.c ****  * 16-bit samples, but if you want lossless storage you shouldn't be changing
  63:Middlewares/Third_Party/LibJPEG/source/jdcolor.c ****  * colorspace anyway.
  64:Middlewares/Third_Party/LibJPEG/source/jdcolor.c ****  * The Cr=>R and Cb=>B values can be rounded to integers in advance; the
  65:Middlewares/Third_Party/LibJPEG/source/jdcolor.c ****  * values for the G calculation are left scaled up, since we must add them
  66:Middlewares/Third_Party/LibJPEG/source/jdcolor.c ****  * together before rounding.
  67:Middlewares/Third_Party/LibJPEG/source/jdcolor.c ****  */
  68:Middlewares/Third_Party/LibJPEG/source/jdcolor.c **** 
  69:Middlewares/Third_Party/LibJPEG/source/jdcolor.c **** #define SCALEBITS	16	/* speediest right-shift on some machines */
  70:Middlewares/Third_Party/LibJPEG/source/jdcolor.c **** #define ONE_HALF	((INT32) 1 << (SCALEBITS-1))
  71:Middlewares/Third_Party/LibJPEG/source/jdcolor.c **** #define FIX(x)		((INT32) ((x) * (1L<<SCALEBITS) + 0.5))
  72:Middlewares/Third_Party/LibJPEG/source/jdcolor.c **** 
  73:Middlewares/Third_Party/LibJPEG/source/jdcolor.c **** /* We allocate one big table for RGB->Y conversion and divide it up into
  74:Middlewares/Third_Party/LibJPEG/source/jdcolor.c ****  * three parts, instead of doing three alloc_small requests.  This lets us
  75:Middlewares/Third_Party/LibJPEG/source/jdcolor.c ****  * use a single table base address, which can be held in a register in the
  76:Middlewares/Third_Party/LibJPEG/source/jdcolor.c ****  * inner loops on many machines (more than can hold all three addresses,
  77:Middlewares/Third_Party/LibJPEG/source/jdcolor.c ****  * anyway).
  78:Middlewares/Third_Party/LibJPEG/source/jdcolor.c ****  */
  79:Middlewares/Third_Party/LibJPEG/source/jdcolor.c **** 
  80:Middlewares/Third_Party/LibJPEG/source/jdcolor.c **** #define R_Y_OFF		0			/* offset to R => Y section */
  81:Middlewares/Third_Party/LibJPEG/source/jdcolor.c **** #define G_Y_OFF		(1*(MAXJSAMPLE+1))	/* offset to G => Y section */
  82:Middlewares/Third_Party/LibJPEG/source/jdcolor.c **** #define B_Y_OFF		(2*(MAXJSAMPLE+1))	/* etc. */
  83:Middlewares/Third_Party/LibJPEG/source/jdcolor.c **** #define TABLE_SIZE	(3*(MAXJSAMPLE+1))
  84:Middlewares/Third_Party/LibJPEG/source/jdcolor.c **** 
  85:Middlewares/Third_Party/LibJPEG/source/jdcolor.c **** 
  86:Middlewares/Third_Party/LibJPEG/source/jdcolor.c **** /*
  87:Middlewares/Third_Party/LibJPEG/source/jdcolor.c ****  * Initialize tables for YCC->RGB colorspace conversion.
ARM GAS  /tmp/ccmnxINp.s 			page 3


