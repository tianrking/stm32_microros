 347:Core/Src/freertos.c **** void StartTask02(void *argument)
 348:Core/Src/freertos.c **** {
 349:Core/Src/freertos.c ****   /* USER CODE BEGIN StartTask02 */
 350:Core/Src/freertos.c ****   HAL_TIM_PWM_Start(&htim4, TIM_CHANNEL_1);
 351:Core/Src/freertos.c ****   HAL_TIM_PWM_Start(&htim4, TIM_CHANNEL_2);
 352:Core/Src/freertos.c ****   HAL_TIM_PWM_Start(&htim4, TIM_CHANNEL_3);
 353:Core/Src/freertos.c ****   HAL_TIM_PWM_Start(&htim4, TIM_CHANNEL_4);
 354:Core/Src/freertos.c **** 
 355:Core/Src/freertos.c ****   TIM4->CCR1 = 100; // PD12
 356:Core/Src/freertos.c ****   TIM4->CCR2 = 400; // PD13
 357:Core/Src/freertos.c ****   TIM4->CCR3 = 600; // PD14
 358:Core/Src/freertos.c ****   TIM4->CCR4 = 800; // PD15
 359:Core/Src/freertos.c ****   // static int pre = 84;
 360:Core/Src/freertos.c ****   // static int delayTime = 2000;
 361:Core/Src/freertos.c ****   /* Infinite loop */
 362:Core/Src/freertos.c ****   for (;;)
 363:Core/Src/freertos.c ****   {
 364:Core/Src/freertos.c **** 
 365:Core/Src/freertos.c ****     // 逐渐增加频率
 366:Core/Src/freertos.c ****     for (int value = 0; value <= 50; value++)
 367:Core/Src/freertos.c ****     {
 368:Core/Src/freertos.c ****       Configure_TIM4_PWM_Frequency(value);
 369:Core/Src/freertos.c ****       osDelay(100);
 370:Core/Src/freertos.c ****     }
 371:Core/Src/freertos.c **** 
 372:Core/Src/freertos.c ****     // 逐渐减少频率
 373:Core/Src/freertos.c ****     for (int value = 50; value > 0; value--)
 374:Core/Src/freertos.c ****     {
 375:Core/Src/freertos.c ****       Configure_TIM4_PWM_Frequency(value);
 376:Core/Src/freertos.c ****       osDelay(100);
 377:Core/Src/freertos.c ****     }
 378:Core/Src/freertos.c ****   }
 379:Core/Src/freertos.c ****   /* USER CODE END StartTask02 */
ARM GAS  /tmp/cc9sxnr9.s 			page 16


