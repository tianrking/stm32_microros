 150:Core/Src/freertos.c **** void vApplicationIdleHook( void )
 151:Core/Src/freertos.c **** {
 152:Core/Src/freertos.c ****    /* vApplicationIdleHook() will only be called if configUSE_IDLE_HOOK is set
 153:Core/Src/freertos.c ****    to 1 in FreeRTOSConfig.h. It will be called on each iteration of the idle
 154:Core/Src/freertos.c ****    task. It is essential that code added to this hook function never attempts
 155:Core/Src/freertos.c ****    to block in any way (for example, call xQueueReceive() with a block time
 156:Core/Src/freertos.c ****    specified, or call vTaskDelay()). If the application makes use of the
 157:Core/Src/freertos.c ****    vTaskDelete() API function (as this demo application does) then it is also
 158:Core/Src/freertos.c ****    important that vApplicationIdleHook() is permitted to return to its calling
 159:Core/Src/freertos.c ****    function, because it is the responsibility of the idle task to clean up
 160:Core/Src/freertos.c ****    memory allocated by the kernel to any task that has since been deleted. */
 161:Core/Src/freertos.c **** }
 162:Core/Src/freertos.c **** /* USER CODE END 2 */
 163:Core/Src/freertos.c **** 
 164:Core/Src/freertos.c **** /* USER CODE BEGIN 3 */
 165:Core/Src/freertos.c **** void vApplicationTickHook( void )
 166:Core/Src/freertos.c **** {
 167:Core/Src/freertos.c ****    /* This function will be called by each tick interrupt if
 168:Core/Src/freertos.c ****    configUSE_TICK_HOOK is set to 1 in FreeRTOSConfig.h. User code can be
 169:Core/Src/freertos.c ****    added here, but the tick hook is called from an interrupt context, so
 170:Core/Src/freertos.c ****    code must not attempt to block, and only the interrupt safe FreeRTOS API
 171:Core/Src/freertos.c ****    functions can be used (those that end in FromISR()). */
 172:Core/Src/freertos.c **** }
 173:Core/Src/freertos.c **** /* USER CODE END 3 */
