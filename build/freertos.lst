 546:Core/Src/freertos.c **** void Configure_TIM4_PWM_Frequency(uint32_t input)
 547:Core/Src/freertos.c **** {
 548:Core/Src/freertos.c ****   uint32_t prescaler = 1;              // Prescaler is 1
 549:Core/Src/freertos.c ****   uint32_t max_frequency = 13000;      // 13kHz
 550:Core/Src/freertos.c ****   uint32_t min_frequency = 0;          // 0Hz
 551:Core/Src/freertos.c ****   uint32_t clock_frequency = 84000000; // Assuming 84MHz Timer Clock frequency
 552:Core/Src/freertos.c **** 
 553:Core/Src/freertos.c ****   // Map input 0-100 to 0-13kHz
 554:Core/Src/freertos.c ****   uint32_t target_frequency = ((max_frequency - min_frequency) * input / 100) + min_frequency;
 555:Core/Src/freertos.c **** 
 556:Core/Src/freertos.c ****   // Calculate period based on the target frequency
 557:Core/Src/freertos.c ****   uint32_t period = (clock_frequency / ((prescaler + 1) * target_frequency)) - 1;
 558:Core/Src/freertos.c **** 
 559:Core/Src/freertos.c ****   /* Stop TIM4 to set the new configuration */
 560:Core/Src/freertos.c ****   HAL_TIM_PWM_Stop(&htim4, TIM_CHANNEL_ALL);
 561:Core/Src/freertos.c **** 
 562:Core/Src/freertos.c ****   /* Set the new prescaler and period values */
 563:Core/Src/freertos.c ****   htim4.Init.Prescaler = prescaler - 1; // Prescaler value in register is 1 less than actual value
 564:Core/Src/freertos.c ****   htim4.Init.Period = period;
 565:Core/Src/freertos.c **** 
 566:Core/Src/freertos.c ****   /* Re-initialize TIM4 with new settings */
 567:Core/Src/freertos.c ****   if (HAL_TIM_PWM_Init(&htim4) != HAL_OK)
 568:Core/Src/freertos.c ****   {
 569:Core/Src/freertos.c ****     Error_Handler();
 570:Core/Src/freertos.c ****   }
 571:Core/Src/freertos.c **** 
 572:Core/Src/freertos.c ****   /* Start TIM4 with the new frequency settings */
 573:Core/Src/freertos.c ****   HAL_TIM_PWM_Start(&htim4, TIM_CHANNEL_1);
 574:Core/Src/freertos.c ****   HAL_TIM_PWM_Start(&htim4, TIM_CHANNEL_2);
 575:Core/Src/freertos.c ****   HAL_TIM_PWM_Start(&htim4, TIM_CHANNEL_3);
 576:Core/Src/freertos.c ****   HAL_TIM_PWM_Start(&htim4, TIM_CHANNEL_4);
 577:Core/Src/freertos.c **** }
