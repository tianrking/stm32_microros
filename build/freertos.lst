 480:Core/Src/freertos.c **** void Configure_TIM4_PWM_Frequency(uint32_t input)
 481:Core/Src/freertos.c **** {
 482:Core/Src/freertos.c ****   uint32_t prescaler = 1;              // Prescaler is 1
 483:Core/Src/freertos.c ****   uint32_t max_frequency = 13000;      // 13kHz
 484:Core/Src/freertos.c ****   uint32_t min_frequency = 0;          // 0Hz
 485:Core/Src/freertos.c ****   uint32_t clock_frequency = 84000000; // Assuming 84MHz Timer Clock frequency
 486:Core/Src/freertos.c **** 
 487:Core/Src/freertos.c ****   // Map input 0-100 to 0-13kHz
 488:Core/Src/freertos.c ****   uint32_t target_frequency = ((max_frequency - min_frequency) * input / 100) + min_frequency;
 489:Core/Src/freertos.c **** 
 490:Core/Src/freertos.c ****   // Calculate period based on the target frequency
 491:Core/Src/freertos.c ****   uint32_t period = (clock_frequency / ((prescaler + 1) * target_frequency)) - 1;
 492:Core/Src/freertos.c **** 
 493:Core/Src/freertos.c ****   /* Stop TIM4 to set the new configuration */
 494:Core/Src/freertos.c ****   HAL_TIM_PWM_Stop(&htim4, TIM_CHANNEL_ALL);
 495:Core/Src/freertos.c **** 
 496:Core/Src/freertos.c ****   /* Set the new prescaler and period values */
 497:Core/Src/freertos.c ****   htim4.Init.Prescaler = prescaler - 1; // Prescaler value in register is 1 less than actual value
 498:Core/Src/freertos.c ****   htim4.Init.Period = period;
 499:Core/Src/freertos.c **** 
 500:Core/Src/freertos.c ****   /* Re-initialize TIM4 with new settings */
 501:Core/Src/freertos.c ****   if (HAL_TIM_PWM_Init(&htim4) != HAL_OK)
ARM GAS  /tmp/cc1LHGMv.s 			page 19


 502:Core/Src/freertos.c ****   {
 503:Core/Src/freertos.c ****     Error_Handler();
 504:Core/Src/freertos.c ****   }
 505:Core/Src/freertos.c **** 
 506:Core/Src/freertos.c ****   /* Start TIM4 with the new frequency settings */
 507:Core/Src/freertos.c ****   HAL_TIM_PWM_Start(&htim4, TIM_CHANNEL_1);
 508:Core/Src/freertos.c ****   HAL_TIM_PWM_Start(&htim4, TIM_CHANNEL_2);
 509:Core/Src/freertos.c ****   HAL_TIM_PWM_Start(&htim4, TIM_CHANNEL_3);
 510:Core/Src/freertos.c ****   HAL_TIM_PWM_Start(&htim4, TIM_CHANNEL_4);
 511:Core/Src/freertos.c **** }
