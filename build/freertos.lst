 399:Core/Src/freertos.c **** /* Private application code --------------------------------------------------*/
 400:Core/Src/freertos.c **** /* USER CODE BEGIN Application */
 401:Core/Src/freertos.c **** void Configure_TIM4_PWM_Frequency(uint32_t input)
 402:Core/Src/freertos.c **** {
 403:Core/Src/freertos.c ****   uint32_t prescaler = 1;              // Prescaler is 1
 404:Core/Src/freertos.c ****   uint32_t max_frequency = 13000;      // 13kHz
 405:Core/Src/freertos.c ****   uint32_t min_frequency = 0;          // 0Hz
 406:Core/Src/freertos.c ****   uint32_t clock_frequency = 84000000; // Assuming 84MHz Timer Clock frequency
ARM GAS  /tmp/ccGUBh6x.s 			page 15


 407:Core/Src/freertos.c **** 
 408:Core/Src/freertos.c ****   // Map input 0-100 to 0-13kHz
 409:Core/Src/freertos.c ****   uint32_t target_frequency = ((max_frequency - min_frequency) * input / 100) + min_frequency;
 410:Core/Src/freertos.c **** 
 411:Core/Src/freertos.c ****   // Calculate period based on the target frequency
 412:Core/Src/freertos.c ****   uint32_t period = (clock_frequency / ((prescaler + 1) * target_frequency)) - 1;
 413:Core/Src/freertos.c **** 
 414:Core/Src/freertos.c ****   /* Stop TIM4 to set the new configuration */
 415:Core/Src/freertos.c ****   HAL_TIM_PWM_Stop(&htim4, TIM_CHANNEL_ALL);
 416:Core/Src/freertos.c **** 
 417:Core/Src/freertos.c ****   /* Set the new prescaler and period values */
 418:Core/Src/freertos.c ****   htim4.Init.Prescaler = prescaler - 1; // Prescaler value in register is 1 less than actual value
 419:Core/Src/freertos.c ****   htim4.Init.Period = period;
 420:Core/Src/freertos.c **** 
 421:Core/Src/freertos.c ****   /* Re-initialize TIM4 with new settings */
 422:Core/Src/freertos.c ****   if (HAL_TIM_PWM_Init(&htim4) != HAL_OK)
 423:Core/Src/freertos.c ****   {
 424:Core/Src/freertos.c ****     Error_Handler();
 425:Core/Src/freertos.c ****   }
 426:Core/Src/freertos.c **** 
 427:Core/Src/freertos.c ****   /* Start TIM4 with the new frequency settings */
 428:Core/Src/freertos.c ****   HAL_TIM_PWM_Start(&htim4, TIM_CHANNEL_1);
 429:Core/Src/freertos.c ****   HAL_TIM_PWM_Start(&htim4, TIM_CHANNEL_2);
 430:Core/Src/freertos.c ****   HAL_TIM_PWM_Start(&htim4, TIM_CHANNEL_3);
 431:Core/Src/freertos.c ****   HAL_TIM_PWM_Start(&htim4, TIM_CHANNEL_4);
 432:Core/Src/freertos.c **** }
