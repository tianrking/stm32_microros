 382:Core/Src/freertos.c **** 
 383:Core/Src/freertos.c ****     // 逐渐增加频率
 384:Core/Src/freertos.c ****     for (int value = 0; value <= 50; value++)
 385:Core/Src/freertos.c ****     {
 386:Core/Src/freertos.c ****       Configure_TIM4_PWM_Frequency(value);
 387:Core/Src/freertos.c ****       osDelay(100);
 388:Core/Src/freertos.c ****     }
 389:Core/Src/freertos.c **** 
 390:Core/Src/freertos.c ****     // 逐渐减少频率
 391:Core/Src/freertos.c ****     for (int value = 50; value > 0; value--)
 392:Core/Src/freertos.c ****     {
 393:Core/Src/freertos.c ****       Configure_TIM4_PWM_Frequency(value);
 394:Core/Src/freertos.c ****       osDelay(100);
 395:Core/Src/freertos.c ****     }
 396:Core/Src/freertos.c ****   }
 397:Core/Src/freertos.c ****   /* USER CODE END StartTask02 */
 398:Core/Src/freertos.c **** }
