 428:Core/Src/freertos.c **** void Configure_TIM4_PWM_Frequency(uint32_t input)
 429:Core/Src/freertos.c **** {
 430:Core/Src/freertos.c ****   uint32_t prescaler = 1;              // Prescaler is 1
 431:Core/Src/freertos.c ****   uint32_t max_frequency = 13000;      // 13kHz
 432:Core/Src/freertos.c ****   uint32_t min_frequency = 0;          // 0Hz
 433:Core/Src/freertos.c ****   uint32_t clock_frequency = 84000000; // Assuming 84MHz Timer Clock frequency
 434:Core/Src/freertos.c **** 
 435:Core/Src/freertos.c ****   // Map input 0-100 to 0-13kHz
 436:Core/Src/freertos.c ****   uint32_t target_frequency = ((max_frequency - min_frequency) * input / 100) + min_frequency;
 437:Core/Src/freertos.c **** 
 438:Core/Src/freertos.c ****   // Calculate period based on the target frequency
 439:Core/Src/freertos.c ****   uint32_t period = (clock_frequency / ((prescaler + 1) * target_frequency)) - 1;
 440:Core/Src/freertos.c **** 
 441:Core/Src/freertos.c ****   /* Stop TIM4 to set the new configuration */
ARM GAS  /tmp/ccpgxBnO.s 			page 18


 442:Core/Src/freertos.c ****   HAL_TIM_PWM_Stop(&htim4, TIM_CHANNEL_ALL);
 443:Core/Src/freertos.c **** 
 444:Core/Src/freertos.c ****   /* Set the new prescaler and period values */
 445:Core/Src/freertos.c ****   htim4.Init.Prescaler = prescaler - 1; // Prescaler value in register is 1 less than actual value
 446:Core/Src/freertos.c ****   htim4.Init.Period = period;
 447:Core/Src/freertos.c **** 
 448:Core/Src/freertos.c ****   /* Re-initialize TIM4 with new settings */
 449:Core/Src/freertos.c ****   if (HAL_TIM_PWM_Init(&htim4) != HAL_OK)
 450:Core/Src/freertos.c ****   {
 451:Core/Src/freertos.c ****     Error_Handler();
 452:Core/Src/freertos.c ****   }
 453:Core/Src/freertos.c **** 
 454:Core/Src/freertos.c ****   /* Start TIM4 with the new frequency settings */
 455:Core/Src/freertos.c ****   HAL_TIM_PWM_Start(&htim4, TIM_CHANNEL_1);
 456:Core/Src/freertos.c ****   HAL_TIM_PWM_Start(&htim4, TIM_CHANNEL_2);
 457:Core/Src/freertos.c ****   HAL_TIM_PWM_Start(&htim4, TIM_CHANNEL_3);
