 608:Core/Src/freertos.c **** void Configure_TIM4_PWM_Frequency(uint32_t input)
 609:Core/Src/freertos.c **** {
 610:Core/Src/freertos.c ****   uint32_t prescaler = 1;              // Prescaler is 1
 611:Core/Src/freertos.c ****   uint32_t max_frequency = 13000;      // 13kHz
 612:Core/Src/freertos.c ****   uint32_t min_frequency = 0;          // 0Hz
 613:Core/Src/freertos.c ****   uint32_t clock_frequency = 84000000; // Assuming 84MHz Timer Clock frequency
 614:Core/Src/freertos.c **** 
 615:Core/Src/freertos.c ****   // Map input 0-100 to 0-13kHz
 616:Core/Src/freertos.c ****   uint32_t target_frequency = ((max_frequency - min_frequency) * input / 100) + min_frequency;
 617:Core/Src/freertos.c **** 
 618:Core/Src/freertos.c ****   // Calculate period based on the target frequency
 619:Core/Src/freertos.c ****   uint32_t period = (clock_frequency / ((prescaler + 1) * target_frequency)) - 1;
 620:Core/Src/freertos.c **** 
 621:Core/Src/freertos.c ****   /* Stop TIM4 to set the new configuration */
ARM GAS  /tmp/ccJCQXJK.s 			page 23


 622:Core/Src/freertos.c ****   HAL_TIM_PWM_Stop(&htim4, TIM_CHANNEL_ALL);
 623:Core/Src/freertos.c **** 
 624:Core/Src/freertos.c ****   /* Set the new prescaler and period values */
 625:Core/Src/freertos.c ****   htim4.Init.Prescaler = prescaler - 1; // Prescaler value in register is 1 less than actual value
 626:Core/Src/freertos.c ****   htim4.Init.Period = period;
 627:Core/Src/freertos.c **** 
 628:Core/Src/freertos.c ****   /* Re-initialize TIM4 with new settings */
 629:Core/Src/freertos.c ****   if (HAL_TIM_PWM_Init(&htim4) != HAL_OK)
 630:Core/Src/freertos.c ****   {
 631:Core/Src/freertos.c ****     Error_Handler();
 632:Core/Src/freertos.c ****   }
 633:Core/Src/freertos.c **** 
 634:Core/Src/freertos.c ****   /* Start TIM4 with the new frequency settings */
 635:Core/Src/freertos.c ****   HAL_TIM_PWM_Start(&htim4, TIM_CHANNEL_1);
 636:Core/Src/freertos.c ****   HAL_TIM_PWM_Start(&htim4, TIM_CHANNEL_2);
 637:Core/Src/freertos.c ****   HAL_TIM_PWM_Start(&htim4, TIM_CHANNEL_3);
 638:Core/Src/freertos.c ****   HAL_TIM_PWM_Start(&htim4, TIM_CHANNEL_4);
 639:Core/Src/freertos.c **** }
