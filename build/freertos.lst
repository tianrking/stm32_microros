 429:Core/Src/freertos.c **** void Configure_TIM4_PWM_Frequency(uint32_t input)
 430:Core/Src/freertos.c **** {
 431:Core/Src/freertos.c ****   uint32_t prescaler = 1;              // Prescaler is 1
 432:Core/Src/freertos.c ****   uint32_t max_frequency = 13000;      // 13kHz
 433:Core/Src/freertos.c ****   uint32_t min_frequency = 0;          // 0Hz
 434:Core/Src/freertos.c ****   uint32_t clock_frequency = 84000000; // Assuming 84MHz Timer Clock frequency
 435:Core/Src/freertos.c **** 
 436:Core/Src/freertos.c ****   // Map input 0-100 to 0-13kHz
 437:Core/Src/freertos.c ****   uint32_t target_frequency = ((max_frequency - min_frequency) * input / 100) + min_frequency;
 438:Core/Src/freertos.c **** 
 439:Core/Src/freertos.c ****   // Calculate period based on the target frequency
 440:Core/Src/freertos.c ****   uint32_t period = (clock_frequency / ((prescaler + 1) * target_frequency)) - 1;
 441:Core/Src/freertos.c **** 
 442:Core/Src/freertos.c ****   /* Stop TIM4 to set the new configuration */
 443:Core/Src/freertos.c ****   HAL_TIM_PWM_Stop(&htim4, TIM_CHANNEL_ALL);
 444:Core/Src/freertos.c **** 
 445:Core/Src/freertos.c ****   /* Set the new prescaler and period values */
ARM GAS  /tmp/ccAsn8Gq.s 			page 18


 446:Core/Src/freertos.c ****   htim4.Init.Prescaler = prescaler - 1; // Prescaler value in register is 1 less than actual value
 447:Core/Src/freertos.c ****   htim4.Init.Period = period;
 448:Core/Src/freertos.c **** 
 449:Core/Src/freertos.c ****   /* Re-initialize TIM4 with new settings */
 450:Core/Src/freertos.c ****   if (HAL_TIM_PWM_Init(&htim4) != HAL_OK)
 451:Core/Src/freertos.c ****   {
 452:Core/Src/freertos.c ****     Error_Handler();
 453:Core/Src/freertos.c ****   }
 454:Core/Src/freertos.c **** 
 455:Core/Src/freertos.c ****   /* Start TIM4 with the new frequency settings */
 456:Core/Src/freertos.c ****   HAL_TIM_PWM_Start(&htim4, TIM_CHANNEL_1);
 457:Core/Src/freertos.c ****   HAL_TIM_PWM_Start(&htim4, TIM_CHANNEL_2);
 458:Core/Src/freertos.c ****   HAL_TIM_PWM_Start(&htim4, TIM_CHANNEL_3);
 459:Core/Src/freertos.c ****   HAL_TIM_PWM_Start(&htim4, TIM_CHANNEL_4);
 460:Core/Src/freertos.c **** }
