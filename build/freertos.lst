 388:Core/Src/freertos.c **** 
 389:Core/Src/freertos.c ****     // 逐渐减少频率
 390:Core/Src/freertos.c ****     for (int value = 50; value > 0; value--)
 391:Core/Src/freertos.c ****     {
 392:Core/Src/freertos.c ****       Configure_TIM4_PWM_Frequency(value);
 393:Core/Src/freertos.c ****       osDelay(100);
 394:Core/Src/freertos.c ****     }
 395:Core/Src/freertos.c ****   }
 396:Core/Src/freertos.c ****   /* USER CODE END StartTask02 */
 397:Core/Src/freertos.c **** }
