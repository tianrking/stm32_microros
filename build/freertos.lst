 382:Core/Src/freertos.c **** /* Private application code --------------------------------------------------*/
 383:Core/Src/freertos.c **** /* USER CODE BEGIN Application */
 384:Core/Src/freertos.c **** void Configure_TIM4_PWM_Frequency(uint32_t input)
 385:Core/Src/freertos.c **** {
 386:Core/Src/freertos.c ****   uint32_t prescaler = 1;              // Prescaler is 1
 387:Core/Src/freertos.c ****   uint32_t max_frequency = 13000;      // 13kHz
 388:Core/Src/freertos.c ****   uint32_t min_frequency = 0;          // 0Hz
 389:Core/Src/freertos.c ****   uint32_t clock_frequency = 84000000; // Assuming 84MHz Timer Clock frequency
 390:Core/Src/freertos.c **** 
 391:Core/Src/freertos.c ****   // Map input 0-100 to 0-13kHz
 392:Core/Src/freertos.c ****   uint32_t target_frequency = ((max_frequency - min_frequency) * input / 100) + min_frequency;
 393:Core/Src/freertos.c **** 
 394:Core/Src/freertos.c ****   // Calculate period based on the target frequency
 395:Core/Src/freertos.c ****   uint32_t period = (clock_frequency / ((prescaler + 1) * target_frequency)) - 1;
 396:Core/Src/freertos.c **** 
 397:Core/Src/freertos.c ****   /* Stop TIM4 to set the new configuration */
 398:Core/Src/freertos.c ****   HAL_TIM_PWM_Stop(&htim4, TIM_CHANNEL_ALL);
 399:Core/Src/freertos.c **** 
 400:Core/Src/freertos.c ****   /* Set the new prescaler and period values */
 401:Core/Src/freertos.c ****   htim4.Init.Prescaler = prescaler - 1; // Prescaler value in register is 1 less than actual value
 402:Core/Src/freertos.c ****   htim4.Init.Period = period;
 403:Core/Src/freertos.c **** 
 404:Core/Src/freertos.c ****   /* Re-initialize TIM4 with new settings */
 405:Core/Src/freertos.c ****   if (HAL_TIM_PWM_Init(&htim4) != HAL_OK)
 406:Core/Src/freertos.c ****   {
 407:Core/Src/freertos.c ****     Error_Handler();
 408:Core/Src/freertos.c ****   }
 409:Core/Src/freertos.c **** 
 410:Core/Src/freertos.c ****   /* Start TIM4 with the new frequency settings */
 411:Core/Src/freertos.c ****   HAL_TIM_PWM_Start(&htim4, TIM_CHANNEL_1);
 412:Core/Src/freertos.c ****   HAL_TIM_PWM_Start(&htim4, TIM_CHANNEL_2);
 413:Core/Src/freertos.c ****   HAL_TIM_PWM_Start(&htim4, TIM_CHANNEL_3);
 414:Core/Src/freertos.c ****   HAL_TIM_PWM_Start(&htim4, TIM_CHANNEL_4);
 415:Core/Src/freertos.c **** }
