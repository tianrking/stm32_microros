 450:Core/Src/freertos.c **** /* USER CODE BEGIN Application */
 451:Core/Src/freertos.c **** void Configure_TIM4_PWM_Frequency(uint32_t input)
 452:Core/Src/freertos.c **** {
 453:Core/Src/freertos.c ****   uint32_t prescaler = 1;              // Prescaler is 1
 454:Core/Src/freertos.c ****   uint32_t max_frequency = 13000;      // 13kHz
 455:Core/Src/freertos.c ****   uint32_t min_frequency = 0;          // 0Hz
 456:Core/Src/freertos.c ****   uint32_t clock_frequency = 84000000; // Assuming 84MHz Timer Clock frequency
 457:Core/Src/freertos.c **** 
 458:Core/Src/freertos.c ****   // Map input 0-100 to 0-13kHz
 459:Core/Src/freertos.c ****   uint32_t target_frequency = ((max_frequency - min_frequency) * input / 100) + min_frequency;
 460:Core/Src/freertos.c **** 
 461:Core/Src/freertos.c ****   // Calculate period based on the target frequency
 462:Core/Src/freertos.c ****   uint32_t period = (clock_frequency / ((prescaler + 1) * target_frequency)) - 1;
 463:Core/Src/freertos.c **** 
 464:Core/Src/freertos.c ****   /* Stop TIM4 to set the new configuration */
 465:Core/Src/freertos.c ****   HAL_TIM_PWM_Stop(&htim4, TIM_CHANNEL_ALL);
 466:Core/Src/freertos.c **** 
 467:Core/Src/freertos.c ****   /* Set the new prescaler and period values */
 468:Core/Src/freertos.c ****   htim4.Init.Prescaler = prescaler - 1; // Prescaler value in register is 1 less than actual value
 469:Core/Src/freertos.c ****   htim4.Init.Period = period;
 470:Core/Src/freertos.c **** 
 471:Core/Src/freertos.c ****   /* Re-initialize TIM4 with new settings */
 472:Core/Src/freertos.c ****   if (HAL_TIM_PWM_Init(&htim4) != HAL_OK)
 473:Core/Src/freertos.c ****   {
 474:Core/Src/freertos.c ****     Error_Handler();
 475:Core/Src/freertos.c ****   }
 476:Core/Src/freertos.c **** 
 477:Core/Src/freertos.c ****   /* Start TIM4 with the new frequency settings */
 478:Core/Src/freertos.c ****   HAL_TIM_PWM_Start(&htim4, TIM_CHANNEL_1);
 479:Core/Src/freertos.c ****   HAL_TIM_PWM_Start(&htim4, TIM_CHANNEL_2);
 480:Core/Src/freertos.c ****   HAL_TIM_PWM_Start(&htim4, TIM_CHANNEL_3);
 481:Core/Src/freertos.c ****   HAL_TIM_PWM_Start(&htim4, TIM_CHANNEL_4);
 482:Core/Src/freertos.c **** }
