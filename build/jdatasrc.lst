  64:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c **** 
  65:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c **** /*
  66:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c ****  * Fill the input buffer --- called whenever buffer is emptied.
  67:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c ****  *
  68:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c ****  * In typical applications, this should read fresh data into the buffer
  69:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c ****  * (ignoring the current state of next_input_byte & bytes_in_buffer),
  70:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c ****  * reset the pointer & count to the start of the buffer, and return TRUE
  71:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c ****  * indicating that the buffer has been reloaded.  It is not necessary to
  72:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c ****  * fill the buffer entirely, only to obtain at least one more byte.
  73:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c ****  *
  74:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c ****  * There is no such thing as an EOF return.  If the end of the file has been
  75:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c ****  * reached, the routine has a choice of ERREXIT() or inserting fake data into
  76:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c ****  * the buffer.  In most cases, generating a warning message and inserting a
  77:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c ****  * fake EOI marker is the best course of action --- this will allow the
  78:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c ****  * decompressor to output however much of the image is there.  However,
  79:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c ****  * the resulting error message is misleading if the real problem is an empty
  80:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c ****  * input file, so we handle that case specially.
  81:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c ****  *
  82:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c ****  * In applications that need to be able to suspend compression due to input
  83:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c ****  * not being available yet, a FALSE return indicates that no more data can be
  84:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c ****  * obtained right now, but more may be forthcoming later.  In this situation,
  85:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c ****  * the decompressor will return to its caller (with an indication of the
  86:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c ****  * number of scanlines it has read, if any).  The application should resume
  87:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c ****  * decompression after it has loaded more data into the input buffer.  Note
  88:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c ****  * that there are substantial restrictions on the use of suspension --- see
  89:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c ****  * the documentation.
  90:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c ****  *
  91:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c ****  * When suspending, the decompressor will back up to a convenient restart point
  92:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c ****  * (typically the start of the current MCU). next_input_byte & bytes_in_buffer
  93:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c ****  * indicate where the restart point will be if the current call returns FALSE.
  94:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c ****  * Data beyond this point must be rescanned after resumption, so move it to
  95:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c ****  * the front of the buffer rather than discarding it.
  96:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c ****  */
  97:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c **** #ifdef JFILE 
  98:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c **** METHODDEF(boolean)
  99:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c **** fill_input_buffer (j_decompress_ptr cinfo)
 100:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c **** {
ARM GAS  /tmp/ccAKN6S6.s 			page 4


 101:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c ****   my_src_ptr src = (my_src_ptr) cinfo->src;
 102:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c ****   size_t nbytes;
 103:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c **** 
 104:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c ****   nbytes = JFREAD(src->infile, src->buffer, INPUT_BUF_SIZE);
 105:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c ****   
 106:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c ****   if (nbytes <= 0) {
 107:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c ****     if (src->start_of_file)	/* Treat empty input file as fatal error */
 108:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c ****       ERREXIT(cinfo, JERR_INPUT_EMPTY);
 109:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c ****     WARNMS(cinfo, JWRN_JPEG_EOF);
 110:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c ****     /* Insert a fake EOI marker */
 111:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c ****     src->buffer[0] = (JOCTET) 0xFF;
 112:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c ****     src->buffer[1] = (JOCTET) JPEG_EOI;
 113:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c ****     nbytes = 2;
 114:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c ****   }
 115:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c **** 
 116:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c ****   src->pub.next_input_byte = src->buffer;
 117:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c ****   src->pub.bytes_in_buffer = nbytes;
 118:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c ****   src->start_of_file = FALSE;
 119:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c **** 
 120:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c ****   return TRUE;
 121:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c **** }
 122:Middlewares/Third_Party/LibJPEG/source/jdatasrc.c **** #endif /* JFILE */
