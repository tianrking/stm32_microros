 383:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c **** /*
 384:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c ****  * This code applies interblock smoothing as described by section K.8
 385:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c ****  * of the JPEG standard: the first 5 AC coefficients are estimated from
 386:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c ****  * the DC values of a DCT block and its 8 neighboring blocks.
 387:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c ****  * We apply smoothing only for progressive JPEG decoding, and only if
 388:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c ****  * the coefficients it can estimate are not yet known to full precision.
 389:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c ****  */
 390:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c **** 
 391:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c **** /* Natural-order array positions of the first 5 zigzag-order coefficients */
 392:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c **** #define Q01_POS  1
 393:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c **** #define Q10_POS  8
 394:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c **** #define Q20_POS  16
 395:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c **** #define Q11_POS  9
 396:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c **** #define Q02_POS  2
 397:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c **** 
