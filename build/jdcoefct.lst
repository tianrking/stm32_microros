   1:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c **** /*
   2:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c ****  * jdcoefct.c
   3:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c ****  *
