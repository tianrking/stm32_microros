   5:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c ****  * Modified 2002-2011 by Guido Vollbeding.
   6:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c ****  * This file is part of the Independent JPEG Group's software.
   7:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c ****  * For conditions of distribution and use, see the accompanying README file.
   8:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c ****  *
   9:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c ****  * This file contains the coefficient buffer controller for decompression.
  10:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c ****  * This controller is the top level of the JPEG decompressor proper.
  11:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c ****  * The coefficient buffer lies between entropy decoding and inverse-DCT steps.
  12:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c ****  *
  13:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c ****  * In buffered-image mode, this controller is the interface between
  14:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c ****  * input-oriented processing and output-oriented processing.
  15:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c ****  * Also, the input side (only) is used when reading a file for transcoding.
  16:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c ****  */
  17:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c **** 
  18:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c **** #define JPEG_INTERNALS
  19:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c **** #include "jinclude.h"
  20:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c **** #include "jpeglib.h"
  21:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c **** 
  22:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c **** /* Block smoothing is only applicable for progressive JPEG, so: */
  23:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c **** #ifndef D_PROGRESSIVE_SUPPORTED
  24:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c **** #undef BLOCK_SMOOTHING_SUPPORTED
  25:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c **** #endif
  26:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c **** 
  27:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c **** /* Private buffer controller object */
  28:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c **** 
  29:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c **** typedef struct {
  30:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c ****   struct jpeg_d_coef_controller pub; /* public fields */
ARM GAS  /tmp/ccCgOGp8.s 			page 2


  31:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c **** 
  32:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c ****   /* These variables keep track of the current location of the input side. */
  33:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c ****   /* cinfo->input_iMCU_row is also used for this. */
  34:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c ****   JDIMENSION MCU_ctr;		/* counts MCUs processed in current row */
  35:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c ****   int MCU_vert_offset;		/* counts MCU rows within iMCU row */
  36:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c ****   int MCU_rows_per_iMCU_row;	/* number of such rows needed */
  37:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c **** 
  38:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c ****   /* The output side's location is represented by cinfo->output_iMCU_row. */
  39:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c **** 
  40:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c ****   /* In single-pass modes, it's sufficient to buffer just one MCU.
  41:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c ****    * We allocate a workspace of D_MAX_BLOCKS_IN_MCU coefficient blocks,
  42:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c ****    * and let the entropy decoder write into that workspace each time.
  43:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c ****    * (On 80x86, the workspace is FAR even though it's not really very big;
  44:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c ****    * this is to keep the module interfaces unchanged when a large coefficient
  45:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c ****    * buffer is necessary.)
  46:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c ****    * In multi-pass modes, this array points to the current MCU's blocks
  47:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c ****    * within the virtual arrays; it is used only by the input side.
  48:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c ****    */
  49:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c ****   JBLOCKROW MCU_buffer[D_MAX_BLOCKS_IN_MCU];
  50:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c **** 
  51:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c **** #ifdef D_MULTISCAN_FILES_SUPPORTED
  52:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c ****   /* In multi-pass modes, we need a virtual block array for each component. */
  53:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c ****   jvirt_barray_ptr whole_image[MAX_COMPONENTS];
  54:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c **** #endif
  55:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c **** 
  56:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c **** #ifdef BLOCK_SMOOTHING_SUPPORTED
  57:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c ****   /* When doing block smoothing, we latch coefficient Al values here */
  58:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c ****   int * coef_bits_latch;
  59:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c **** #define SAVED_COEFS  6		/* we save coef_bits[0..5] */
  60:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c **** #endif
  61:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c **** } my_coef_controller;
