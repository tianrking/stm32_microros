 137:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c **** /*
 138:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c ****  * Decompress and return some data in the single-pass case.
 139:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c ****  * Always attempts to emit one fully interleaved MCU row ("iMCU" row).
 140:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c ****  * Input and output must run in lockstep since we have only a one-MCU buffer.
 141:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c ****  * Return value is JPEG_ROW_COMPLETED, JPEG_SCAN_COMPLETED, or JPEG_SUSPENDED.
 142:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c ****  *
 143:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c ****  * NB: output_buf contains a plane for each component in image,
 144:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c ****  * which we index according to the component's SOF position.
 145:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c ****  */
 146:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c **** 
 147:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c **** METHODDEF(int)
ARM GAS  /tmp/ccCgOGp8.s 			page 6


 148:Middlewares/Third_Party/LibJPEG/source/jdcoefct.c **** decompress_onepass (j_decompress_ptr cinfo, JSAMPIMAGE output_buf)
