   1:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** /*
   2:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * jfdctint.c
   3:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  *
   4:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * Copyright (C) 1991-1996, Thomas G. Lane.
   5:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * Modification developed 2003-2009 by Guido Vollbeding.
   6:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * This file is part of the Independent JPEG Group's software.
   7:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * For conditions of distribution and use, see the accompanying README file.
   8:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  *
   9:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * This file contains a slow-but-accurate integer implementation of the
  10:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * forward DCT (Discrete Cosine Transform).
  11:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  *
  12:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * A 2-D DCT can be done by 1-D DCT on each row followed by 1-D DCT
  13:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * on each column.  Direct algorithms are also available, but they are
  14:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * much more complex and seem not to be any faster when reduced to code.
  15:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  *
  16:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * This implementation is based on an algorithm described in
  17:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  *   C. Loeffler, A. Ligtenberg and G. Moschytz, "Practical Fast 1-D DCT
  18:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  *   Algorithms with 11 Multiplications", Proc. Int'l. Conf. on Acoustics,
  19:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  *   Speech, and Signal Processing 1989 (ICASSP '89), pp. 988-991.
  20:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * The primary algorithm described there uses 11 multiplies and 29 adds.
  21:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * We use their alternate method with 12 multiplies and 32 adds.
  22:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * The advantage of this method is that no data path contains more than one
  23:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * multiplication; this allows a very simple and accurate implementation in
  24:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * scaled fixed-point arithmetic, with a minimal number of shifts.
  25:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  *
  26:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * We also provide FDCT routines with various input sample block sizes for
  27:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * direct resolution reduction or enlargement and for direct resolving the
  28:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * common 2x1 and 1x2 subsampling cases without additional resampling: NxN
  29:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * (N=1...16), 2NxN, and Nx2N (N=1...8) pixels for one 8x8 output DCT block.
ARM GAS  /tmp/cce9Fg7u.s 			page 2


  30:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  *
  31:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * For N<8 we fill the remaining block coefficients with zero.
  32:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * For N>8 we apply a partial N-point FDCT on the input samples, computing
  33:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * just the lower 8 frequency coefficients and discarding the rest.
  34:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  *
  35:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * We must scale the output coefficients of the N-point FDCT appropriately
  36:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * to the standard 8-point FDCT level by 8/N per 1-D pass.  This scaling
  37:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * is folded into the constant multipliers (pass 2) and/or final/initial
  38:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * shifting.
  39:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  *
  40:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * CAUTION: We rely on the FIX() macro except for the N=1,2,4,8 cases
  41:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * since there would be too many additional constants to pre-calculate.
  42:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  */
  43:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** 
  44:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** #define JPEG_INTERNALS
  45:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** #include "jinclude.h"
  46:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** #include "jpeglib.h"
  47:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** #include "jdct.h"		/* Private declarations for DCT subsystem */
  48:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** 
  49:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** #ifdef DCT_ISLOW_SUPPORTED
  50:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** 
  51:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** 
  52:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** /*
  53:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * This module is specialized to the case DCTSIZE = 8.
  54:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  */
  55:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** 
  56:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** #if DCTSIZE != 8
  57:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****   Sorry, this code only copes with 8x8 DCT blocks. /* deliberate syntax err */
  58:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** #endif
  59:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** 
  60:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** 
  61:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** /*
  62:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * The poop on this scaling stuff is as follows:
  63:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  *
  64:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * Each 1-D DCT step produces outputs which are a factor of sqrt(N)
  65:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * larger than the true DCT outputs.  The final outputs are therefore
  66:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * a factor of N larger than desired; since N=8 this can be cured by
  67:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * a simple right shift at the end of the algorithm.  The advantage of
  68:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * this arrangement is that we save two multiplications per 1-D DCT,
  69:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * because the y0 and y4 outputs need not be divided by sqrt(N).
  70:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * In the IJG code, this factor of 8 is removed by the quantization step
  71:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * (in jcdctmgr.c), NOT in this module.
  72:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  *
  73:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * We have to do addition and subtraction of the integer inputs, which
  74:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * is no problem, and multiplication by fractional constants, which is
  75:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * a problem to do in integer arithmetic.  We multiply all the constants
  76:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * by CONST_SCALE and convert them to integer constants (thus retaining
  77:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * CONST_BITS bits of precision in the constants).  After doing a
  78:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * multiplication we have to divide the product by CONST_SCALE, with proper
  79:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * rounding, to produce the correct output.  This division can be done
  80:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * cheaply as a right shift of CONST_BITS bits.  We postpone shifting
  81:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * as long as possible so that partial sums can be added together with
  82:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * full fractional precision.
  83:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  *
  84:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * The outputs of the first pass are scaled up by PASS1_BITS bits so that
  85:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * they are represented to better-than-integral precision.  These outputs
  86:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * require BITS_IN_JSAMPLE + PASS1_BITS + 3 bits; this fits in a 16-bit word
ARM GAS  /tmp/cce9Fg7u.s 			page 3


  87:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * with the recommended scaling.  (For 12-bit sample data, the intermediate
  88:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * array is INT32 anyway.)
  89:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  *
  90:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * To avoid overflow of the 32-bit intermediate results in pass 2, we must
  91:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * have BITS_IN_JSAMPLE + CONST_BITS + PASS1_BITS <= 26.  Error analysis
  92:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * shows that the values given below are the most effective.
  93:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  */
  94:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** 
  95:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** #if BITS_IN_JSAMPLE == 8
  96:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** #define CONST_BITS  13
  97:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** #define PASS1_BITS  2
  98:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** #else
  99:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** #define CONST_BITS  13
 100:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** #define PASS1_BITS  1		/* lose a little precision to avoid overflow */
 101:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** #endif
 102:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** 
 103:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** /* Some C compilers fail to reduce "FIX(constant)" at compile time, thus
 104:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * causing a lot of useless floating-point operations at run time.
 105:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * To get around this we use the following pre-calculated constants.
 106:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * If you change CONST_BITS you may want to add appropriate values.
 107:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * (With a reasonable C compiler, you can just rely on the FIX() macro...)
 108:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  */
 109:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** 
 110:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** #if CONST_BITS == 13
 111:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** #define FIX_0_298631336  ((INT32)  2446)	/* FIX(0.298631336) */
 112:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** #define FIX_0_390180644  ((INT32)  3196)	/* FIX(0.390180644) */
 113:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** #define FIX_0_541196100  ((INT32)  4433)	/* FIX(0.541196100) */
 114:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** #define FIX_0_765366865  ((INT32)  6270)	/* FIX(0.765366865) */
 115:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** #define FIX_0_899976223  ((INT32)  7373)	/* FIX(0.899976223) */
 116:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** #define FIX_1_175875602  ((INT32)  9633)	/* FIX(1.175875602) */
 117:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** #define FIX_1_501321110  ((INT32)  12299)	/* FIX(1.501321110) */
 118:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** #define FIX_1_847759065  ((INT32)  15137)	/* FIX(1.847759065) */
 119:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** #define FIX_1_961570560  ((INT32)  16069)	/* FIX(1.961570560) */
 120:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** #define FIX_2_053119869  ((INT32)  16819)	/* FIX(2.053119869) */
 121:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** #define FIX_2_562915447  ((INT32)  20995)	/* FIX(2.562915447) */
 122:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** #define FIX_3_072711026  ((INT32)  25172)	/* FIX(3.072711026) */
 123:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** #else
 124:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** #define FIX_0_298631336  FIX(0.298631336)
 125:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** #define FIX_0_390180644  FIX(0.390180644)
 126:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** #define FIX_0_541196100  FIX(0.541196100)
 127:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** #define FIX_0_765366865  FIX(0.765366865)
 128:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** #define FIX_0_899976223  FIX(0.899976223)
 129:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** #define FIX_1_175875602  FIX(1.175875602)
 130:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** #define FIX_1_501321110  FIX(1.501321110)
 131:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** #define FIX_1_847759065  FIX(1.847759065)
 132:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** #define FIX_1_961570560  FIX(1.961570560)
 133:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** #define FIX_2_053119869  FIX(2.053119869)
 134:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** #define FIX_2_562915447  FIX(2.562915447)
 135:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** #define FIX_3_072711026  FIX(3.072711026)
 136:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** #endif
