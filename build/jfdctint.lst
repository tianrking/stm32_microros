 138:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** 
 139:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** /* Multiply an INT32 variable by an INT32 constant to yield an INT32 result.
 140:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * For 8-bit samples with the recommended scaling, all the variable
 141:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * and constant values involved are no more than 16 bits wide, so a
 142:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * 16x16->32 bit multiply can be used instead of a full 32x32 multiply.
 143:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  * For 12-bit samples, a full 32-bit multiplication will be needed.
ARM GAS  /tmp/cce9Fg7u.s 			page 4


 144:Middlewares/Third_Party/LibJPEG/source/jfdctint.c ****  */
 145:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** 
 146:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** #if BITS_IN_JSAMPLE == 8
 147:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** #define MULTIPLY(var,const)  MULTIPLY16C16(var,const)
 148:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** #else
 149:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** #define MULTIPLY(var,const)  ((var) * (const))
 150:Middlewares/Third_Party/LibJPEG/source/jfdctint.c **** #endif
