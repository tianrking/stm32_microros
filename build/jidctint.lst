4761:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****     /* Due to quantization, we will usually find that many of the input
4762:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****      * coefficients are zero, especially the AC terms.  We can exploit this
4763:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****      * by short-circuiting the IDCT calculation for any column in which all
4764:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****      * the AC terms are zero.  In that case each output is equal to the
4765:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****      * DC coefficient (with scale factor as needed).
4766:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****      * With typical images and quantization tables, half or more of the
4767:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****      * column DCT calculations can be simplified this way.
4768:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****      */
4769:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** 
4770:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****     if (inptr[DCTSIZE*1] == 0 && inptr[DCTSIZE*2] == 0 &&
4771:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** 	inptr[DCTSIZE*3] == 0 && inptr[DCTSIZE*4] == 0 &&
4772:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** 	inptr[DCTSIZE*5] == 0 && inptr[DCTSIZE*6] == 0 &&
4773:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** 	inptr[DCTSIZE*7] == 0) {
4774:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****       /* AC terms all zero */
4775:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****       int dcval = DEQUANTIZE(inptr[DCTSIZE*0], quantptr[DCTSIZE*0]) << PASS1_BITS;
4776:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** 
4777:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****       wsptr[4*0] = dcval;
4778:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****       wsptr[4*1] = dcval;
4779:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****       wsptr[4*2] = dcval;
4780:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****       wsptr[4*3] = dcval;
4781:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****       wsptr[4*4] = dcval;
4782:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****       wsptr[4*5] = dcval;
4783:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****       wsptr[4*6] = dcval;
4784:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****       wsptr[4*7] = dcval;
4785:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** 
4786:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****       inptr++;			/* advance pointers to next column */
4787:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****       quantptr++;
4788:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****       wsptr++;
4789:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****       continue;
4790:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****     }
