 144:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** /* Multiply an INT32 variable by an INT32 constant to yield an INT32 result.
 145:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * For 8-bit samples with the recommended scaling, all the variable
 146:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * and constant values involved are no more than 16 bits wide, so a
 147:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * 16x16->32 bit multiply can be used instead of a full 32x32 multiply.
 148:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * For 12-bit samples, a full 32-bit multiplication will be needed.
 149:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  */
 150:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** 
 151:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** #if BITS_IN_JSAMPLE == 8
 152:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** #define MULTIPLY(var,const)  MULTIPLY16C16(var,const)
 153:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** #else
 154:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** #define MULTIPLY(var,const)  ((var) * (const))
 155:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** #endif
 156:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** 
 157:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** 
 158:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** /* Dequantize a coefficient by multiplying it by the multiplier-table
 159:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * entry; produce an int result.  In this module, both inputs and result
 160:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * are 16 bits or less, so either int or short multiply will work.
 161:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  */
 162:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** 
 163:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** #define DEQUANTIZE(coef,quantval)  (((ISLOW_MULT_TYPE) (coef)) * (quantval))
 164:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** 
 165:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** 
 166:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** /*
 167:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * Perform dequantization and inverse DCT on one block of coefficients.
 168:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  */
 169:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** 
