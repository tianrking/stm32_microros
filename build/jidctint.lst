   1:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** /*
   2:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * jidctint.c
   3:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  *
   4:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * Copyright (C) 1991-1998, Thomas G. Lane.
   5:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * Modification developed 2002-2009 by Guido Vollbeding.
   6:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * This file is part of the Independent JPEG Group's software.
   7:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * For conditions of distribution and use, see the accompanying README file.
   8:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  *
   9:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * This file contains a slow-but-accurate integer implementation of the
  10:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * inverse DCT (Discrete Cosine Transform).  In the IJG code, this routine
  11:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * must also perform dequantization of the input coefficients.
  12:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  *
  13:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * A 2-D IDCT can be done by 1-D IDCT on each column followed by 1-D IDCT
  14:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * on each row (or vice versa, but it's more convenient to emit a row at
  15:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * a time).  Direct algorithms are also available, but they are much more
  16:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * complex and seem not to be any faster when reduced to code.
  17:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  *
  18:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * This implementation is based on an algorithm described in
  19:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  *   C. Loeffler, A. Ligtenberg and G. Moschytz, "Practical Fast 1-D DCT
  20:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  *   Algorithms with 11 Multiplications", Proc. Int'l. Conf. on Acoustics,
  21:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  *   Speech, and Signal Processing 1989 (ICASSP '89), pp. 988-991.
  22:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * The primary algorithm described there uses 11 multiplies and 29 adds.
  23:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * We use their alternate method with 12 multiplies and 32 adds.
  24:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * The advantage of this method is that no data path contains more than one
  25:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * multiplication; this allows a very simple and accurate implementation in
  26:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * scaled fixed-point arithmetic, with a minimal number of shifts.
  27:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  *
  28:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * We also provide IDCT routines with various output sample block sizes for
  29:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * direct resolution reduction or enlargement and for direct resolving the
ARM GAS  /tmp/ccFgKFro.s 			page 2


  30:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * common 2x1 and 1x2 subsampling cases without additional resampling: NxN
  31:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * (N=1...16), 2NxN, and Nx2N (N=1...8) pixels for one 8x8 input DCT block.
  32:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  *
  33:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * For N<8 we simply take the corresponding low-frequency coefficients of
  34:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * the 8x8 input DCT block and apply an NxN point IDCT on the sub-block
  35:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * to yield the downscaled outputs.
  36:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * This can be seen as direct low-pass downsampling from the DCT domain
  37:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * point of view rather than the usual spatial domain point of view,
  38:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * yielding significant computational savings and results at least
  39:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * as good as common bilinear (averaging) spatial downsampling.
  40:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  *
  41:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * For N>8 we apply a partial NxN IDCT on the 8 input coefficients as
  42:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * lower frequencies and higher frequencies assumed to be zero.
  43:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * It turns out that the computational effort is similar to the 8x8 IDCT
  44:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * regarding the output size.
  45:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * Furthermore, the scaling and descaling is the same for all IDCT sizes.
  46:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  *
  47:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * CAUTION: We rely on the FIX() macro except for the N=1,2,4,8 cases
  48:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * since there would be too many additional constants to pre-calculate.
  49:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  */
  50:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** 
  51:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** #define JPEG_INTERNALS
  52:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** #include "jinclude.h"
  53:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** #include "jpeglib.h"
  54:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** #include "jdct.h"		/* Private declarations for DCT subsystem */
  55:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** 
  56:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** #ifdef DCT_ISLOW_SUPPORTED
  57:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** 
  58:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** 
  59:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** /*
  60:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * This module is specialized to the case DCTSIZE = 8.
  61:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  */
  62:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** 
  63:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** #if DCTSIZE != 8
  64:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****   Sorry, this code only copes with 8x8 DCT blocks. /* deliberate syntax err */
  65:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** #endif
  66:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** 
  67:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** 
  68:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** /*
  69:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * The poop on this scaling stuff is as follows:
  70:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  *
  71:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * Each 1-D IDCT step produces outputs which are a factor of sqrt(N)
  72:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * larger than the true IDCT outputs.  The final outputs are therefore
  73:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * a factor of N larger than desired; since N=8 this can be cured by
  74:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * a simple right shift at the end of the algorithm.  The advantage of
  75:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * this arrangement is that we save two multiplications per 1-D IDCT,
  76:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * because the y0 and y4 inputs need not be divided by sqrt(N).
  77:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  *
  78:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * We have to do addition and subtraction of the integer inputs, which
  79:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * is no problem, and multiplication by fractional constants, which is
  80:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * a problem to do in integer arithmetic.  We multiply all the constants
  81:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * by CONST_SCALE and convert them to integer constants (thus retaining
  82:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * CONST_BITS bits of precision in the constants).  After doing a
  83:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * multiplication we have to divide the product by CONST_SCALE, with proper
  84:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * rounding, to produce the correct output.  This division can be done
  85:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * cheaply as a right shift of CONST_BITS bits.  We postpone shifting
  86:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * as long as possible so that partial sums can be added together with
ARM GAS  /tmp/ccFgKFro.s 			page 3


  87:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * full fractional precision.
  88:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  *
  89:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * The outputs of the first pass are scaled up by PASS1_BITS bits so that
  90:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * they are represented to better-than-integral precision.  These outputs
  91:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * require BITS_IN_JSAMPLE + PASS1_BITS + 3 bits; this fits in a 16-bit word
  92:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * with the recommended scaling.  (To scale up 12-bit sample data further, an
  93:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * intermediate INT32 array would be needed.)
  94:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  *
  95:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * To avoid overflow of the 32-bit intermediate results in pass 2, we must
  96:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * have BITS_IN_JSAMPLE + CONST_BITS + PASS1_BITS <= 26.  Error analysis
  97:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * shows that the values given below are the most effective.
  98:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  */
  99:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** 
 100:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** #if BITS_IN_JSAMPLE == 8
 101:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** #define CONST_BITS  13
 102:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** #define PASS1_BITS  2
 103:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** #else
 104:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** #define CONST_BITS  13
 105:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** #define PASS1_BITS  1		/* lose a little precision to avoid overflow */
 106:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** #endif
 107:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** 
 108:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** /* Some C compilers fail to reduce "FIX(constant)" at compile time, thus
 109:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * causing a lot of useless floating-point operations at run time.
 110:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * To get around this we use the following pre-calculated constants.
 111:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * If you change CONST_BITS you may want to add appropriate values.
 112:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  * (With a reasonable C compiler, you can just rely on the FIX() macro...)
 113:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****  */
 114:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** 
 115:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** #if CONST_BITS == 13
 116:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** #define FIX_0_298631336  ((INT32)  2446)	/* FIX(0.298631336) */
 117:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** #define FIX_0_390180644  ((INT32)  3196)	/* FIX(0.390180644) */
 118:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** #define FIX_0_541196100  ((INT32)  4433)	/* FIX(0.541196100) */
 119:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** #define FIX_0_765366865  ((INT32)  6270)	/* FIX(0.765366865) */
 120:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** #define FIX_0_899976223  ((INT32)  7373)	/* FIX(0.899976223) */
 121:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** #define FIX_1_175875602  ((INT32)  9633)	/* FIX(1.175875602) */
 122:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** #define FIX_1_501321110  ((INT32)  12299)	/* FIX(1.501321110) */
 123:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** #define FIX_1_847759065  ((INT32)  15137)	/* FIX(1.847759065) */
 124:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** #define FIX_1_961570560  ((INT32)  16069)	/* FIX(1.961570560) */
 125:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** #define FIX_2_053119869  ((INT32)  16819)	/* FIX(2.053119869) */
 126:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** #define FIX_2_562915447  ((INT32)  20995)	/* FIX(2.562915447) */
 127:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** #define FIX_3_072711026  ((INT32)  25172)	/* FIX(3.072711026) */
 128:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** #else
 129:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** #define FIX_0_298631336  FIX(0.298631336)
 130:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** #define FIX_0_390180644  FIX(0.390180644)
 131:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** #define FIX_0_541196100  FIX(0.541196100)
 132:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** #define FIX_0_765366865  FIX(0.765366865)
 133:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** #define FIX_0_899976223  FIX(0.899976223)
 134:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** #define FIX_1_175875602  FIX(1.175875602)
 135:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** #define FIX_1_501321110  FIX(1.501321110)
 136:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** #define FIX_1_847759065  FIX(1.847759065)
 137:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** #define FIX_1_961570560  FIX(1.961570560)
 138:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** #define FIX_2_053119869  FIX(2.053119869)
 139:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** #define FIX_2_562915447  FIX(2.562915447)
 140:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** #define FIX_3_072711026  FIX(3.072711026)
 141:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** #endif
 142:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** 
 143:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** 
