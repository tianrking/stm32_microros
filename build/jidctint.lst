2846:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****     /* Due to quantization, we will usually find that many of the input
2847:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****      * coefficients are zero, especially the AC terms.  We can exploit this
2848:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****      * by short-circuiting the IDCT calculation for any column in which all
2849:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****      * the AC terms are zero.  In that case each output is equal to the
2850:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****      * DC coefficient (with scale factor as needed).
2851:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****      * With typical images and quantization tables, half or more of the
2852:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****      * column DCT calculations can be simplified this way.
2853:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****      */
2854:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****     
2855:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****     if (inptr[DCTSIZE*1] == 0 && inptr[DCTSIZE*2] == 0 &&
2856:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** 	inptr[DCTSIZE*3] == 0 && inptr[DCTSIZE*4] == 0 &&
2857:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** 	inptr[DCTSIZE*5] == 0 && inptr[DCTSIZE*6] == 0 &&
2858:Middlewares/Third_Party/LibJPEG/source/jidctint.c **** 	inptr[DCTSIZE*7] == 0) {
2859:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****       /* AC terms all zero */
2860:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****       int dcval = DEQUANTIZE(inptr[DCTSIZE*0], quantptr[DCTSIZE*0]) << PASS1_BITS;
2861:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****       
2862:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****       wsptr[DCTSIZE*0] = dcval;
2863:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****       wsptr[DCTSIZE*1] = dcval;
2864:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****       wsptr[DCTSIZE*2] = dcval;
2865:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****       wsptr[DCTSIZE*3] = dcval;
2866:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****       wsptr[DCTSIZE*4] = dcval;
2867:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****       wsptr[DCTSIZE*5] = dcval;
2868:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****       wsptr[DCTSIZE*6] = dcval;
2869:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****       wsptr[DCTSIZE*7] = dcval;
2870:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****       
2871:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****       inptr++;			/* advance pointers to next column */
2872:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****       quantptr++;
2873:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****       wsptr++;
2874:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****       continue;
2875:Middlewares/Third_Party/LibJPEG/source/jidctint.c ****     }
