 111:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** /*
 112:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * Macros for fetching data from the data source module.
 113:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  *
 114:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * At all times, cinfo->src->next_input_byte and ->bytes_in_buffer reflect
 115:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * the current restart point; we update them only when we have reached a
 116:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * suitable place to restart if a suspension occurs.
 117:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  */
 118:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** 
 119:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** /* Declare and initialize local copies of input pointer/count */
 120:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** #define INPUT_VARS(cinfo)  \
 121:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** 	struct jpeg_source_mgr * datasrc = (cinfo)->src;  \
 122:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** 	const JOCTET * next_input_byte = datasrc->next_input_byte;  \
 123:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** 	size_t bytes_in_buffer = datasrc->bytes_in_buffer
 124:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** 
 125:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** /* Unload the local copies --- do this only at a restart boundary */
 126:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** #define INPUT_SYNC(cinfo)  \
 127:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** 	( datasrc->next_input_byte = next_input_byte,  \
 128:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** 	  datasrc->bytes_in_buffer = bytes_in_buffer )
 129:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** 
 130:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** /* Reload the local copies --- used only in MAKE_BYTE_AVAIL */
 131:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** #define INPUT_RELOAD(cinfo)  \
 132:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** 	( next_input_byte = datasrc->next_input_byte,  \
 133:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** 	  bytes_in_buffer = datasrc->bytes_in_buffer )
 134:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** 
 135:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** /* Internal macro for INPUT_BYTE and INPUT_2BYTES: make a byte available.
 136:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * Note we do *not* do INPUT_SYNC before calling fill_input_buffer,
 137:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * but we must reload the local copies after a successful fill.
 138:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  */
 139:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** #define MAKE_BYTE_AVAIL(cinfo,action)  \
 140:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** 	if (bytes_in_buffer == 0) {  \
 141:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** 	  if (! (*datasrc->fill_input_buffer) (cinfo))  \
 142:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** 	    { action; }  \
 143:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** 	  INPUT_RELOAD(cinfo);  \
 144:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** 	}
