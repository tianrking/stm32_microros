1187:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** 
1188:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** /*
1189:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * This is the default resync_to_restart method for data source managers
1190:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * to use if they don't have any better approach.  Some data source managers
1191:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * may be able to back up, or may have additional knowledge about the data
1192:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * which permits a more intelligent recovery strategy; such managers would
1193:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * presumably supply their own resync method.
1194:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  *
1195:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * read_restart_marker calls resync_to_restart if it finds a marker other than
1196:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * the restart marker it was expecting.  (This code is *not* used unless
1197:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * a nonzero restart interval has been declared.)  cinfo->unread_marker is
1198:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * the marker code actually found (might be anything, except 0 or FF).
1199:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * The desired restart marker number (0..7) is passed as a parameter.
1200:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * This routine is supposed to apply whatever error recovery strategy seems
1201:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * appropriate in order to position the input stream to the next data segment.
1202:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * Note that cinfo->unread_marker is treated as a marker appearing before
1203:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * the current data-source input point; usually it should be reset to zero
1204:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * before returning.
1205:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * Returns FALSE if suspension is required.
1206:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  *
1207:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * This implementation is substantially constrained by wanting to treat the
1208:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * input as a data stream; this means we can't back up.  Therefore, we have
1209:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * only the following actions to work with:
1210:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  *   1. Simply discard the marker and let the entropy decoder resume at next
1211:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  *      byte of file.
1212:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  *   2. Read forward until we find another marker, discarding intervening
1213:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  *      data.  (In theory we could look ahead within the current bufferload,
1214:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  *      without having to discard data if we don't find the desired marker.
1215:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  *      This idea is not implemented here, in part because it makes behavior
1216:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  *      dependent on buffer size and chance buffer-boundary positions.)
1217:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  *   3. Leave the marker unread (by failing to zero cinfo->unread_marker).
1218:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  *      This will cause the entropy decoder to process an empty data segment,
1219:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  *      inserting dummy zeroes, and then we will reprocess the marker.
1220:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  *
1221:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * #2 is appropriate if we think the desired marker lies ahead, while #3 is
1222:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * appropriate if the found marker is a future restart marker (indicating
1223:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * that we have missed the desired restart marker, probably because it got
1224:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * corrupted).
1225:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * We apply #2 or #3 if the found marker is a restart marker no more than
1226:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * two counts behind or ahead of the expected one.  We also apply #2 if the
ARM GAS  /tmp/ccgwehsM.s 			page 92


1227:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * found marker is not a legal JPEG marker code (it's certainly bogus data).
1228:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * If the found marker is a restart marker more than 2 counts away, we do #1
1229:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * (too much risk that the marker is erroneous; with luck we will be able to
1230:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * resync at some future point).
1231:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * For any valid non-restart JPEG marker, we apply #3.  This keeps us from
1232:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * overrunning the end of a scan.  An implementation limited to single-scan
1233:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * files might find it better to apply #2 for markers other than EOI, since
1234:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * any other marker would have to be bogus data in that case.
1235:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  */
1236:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** 
1237:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** GLOBAL(boolean)
1238:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** jpeg_resync_to_restart (j_decompress_ptr cinfo, int desired)
1239:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** {
1240:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****   int marker = cinfo->unread_marker;
1241:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****   int action = 1;
1242:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****   
1243:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****   /* Always put up a warning. */
1244:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****   WARNMS2(cinfo, JWRN_MUST_RESYNC, marker, desired);
1245:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****   
1246:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****   /* Outer loop handles repeated decision after scanning forward. */
1247:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****   for (;;) {
1248:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****     if (marker < (int) M_SOF0)
1249:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****       action = 2;		/* invalid marker */
1250:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****     else if (marker < (int) M_RST0 || marker > (int) M_RST7)
1251:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****       action = 3;		/* valid non-restart marker */
1252:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****     else {
1253:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****       if (marker == ((int) M_RST0 + ((desired+1) & 7)) ||
1254:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** 	  marker == ((int) M_RST0 + ((desired+2) & 7)))
1255:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** 	action = 3;		/* one of the next two expected restarts */
1256:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****       else if (marker == ((int) M_RST0 + ((desired-1) & 7)) ||
1257:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** 	       marker == ((int) M_RST0 + ((desired-2) & 7)))
1258:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** 	action = 2;		/* a prior restart, so advance */
1259:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****       else
1260:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** 	action = 1;		/* desired restart or too far away */
1261:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****     }
1262:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****     TRACEMS2(cinfo, 4, JTRC_RECOVERY_ACTION, marker, action);
1263:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****     switch (action) {
1264:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****     case 1:
1265:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****       /* Discard marker and let entropy decoder resume processing. */
1266:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****       cinfo->unread_marker = 0;
1267:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****       return TRUE;
1268:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****     case 2:
1269:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****       /* Scan to the next marker, and repeat the decision loop. */
1270:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****       if (! next_marker(cinfo))
1271:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** 	return FALSE;
1272:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****       marker = cinfo->unread_marker;
1273:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****       break;
1274:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****     case 3:
1275:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****       /* Return without advancing past this marker. */
1276:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****       /* Entropy decoder will be forced to process an empty segment. */
1277:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****       return TRUE;
1278:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****     }
1279:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****   } /* end loop */
1280:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** }
1281:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** 
