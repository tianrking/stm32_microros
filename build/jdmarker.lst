1000:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****     if (cinfo->unread_marker == 0) {
1001:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****       if (! cinfo->marker->saw_SOI) {
1002:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** 	if (! first_marker(cinfo))
1003:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** 	  return JPEG_SUSPENDED;
1004:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****       } else {
1005:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** 	if (! next_marker(cinfo))
1006:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** 	  return JPEG_SUSPENDED;
1007:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****       }
1008:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****     }
1009:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****     /* At this point cinfo->unread_marker contains the marker code and the
1010:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****      * input point is just past the marker proper, but before any parameters.
