 145:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** 
 146:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** /* Read a byte into variable V.
 147:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * If must suspend, take the specified action (typically "return FALSE").
 148:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  */
 149:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** #define INPUT_BYTE(cinfo,V,action)  \
 150:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** 	MAKESTMT( MAKE_BYTE_AVAIL(cinfo,action); \
 151:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** 		  bytes_in_buffer--; \
 152:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** 		  V = GETJOCTET(*next_input_byte++); )
 153:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** 
 154:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** /* As above, but read two bytes interpreted as an unsigned 16-bit integer.
 155:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * V should be declared unsigned int or perhaps INT32.
 156:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  */
 157:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** #define INPUT_2BYTES(cinfo,V,action)  \
 158:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** 	MAKESTMT( MAKE_BYTE_AVAIL(cinfo,action); \
 159:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** 		  bytes_in_buffer--; \
 160:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** 		  V = ((unsigned int) GETJOCTET(*next_input_byte++)) << 8; \
 161:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** 		  MAKE_BYTE_AVAIL(cinfo,action); \
 162:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** 		  bytes_in_buffer--; \
 163:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** 		  V += GETJOCTET(*next_input_byte++); )
 164:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** 
 165:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** 
 166:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** /*
 167:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * Routines to process JPEG markers.
 168:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  *
 169:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * Entry condition: JPEG marker itself has been read and its code saved
 170:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  *   in cinfo->unread_marker; input restart point is just after the marker.
 171:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  *
 172:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * Exit: if return TRUE, have read and processed any parameters, and have
 173:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  *   updated the restart point to point after the parameters.
 174:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  *   If return FALSE, was forced to suspend before reaching end of
 175:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  *   marker parameters; restart point has not been moved.  Same routine
 176:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  *   will be called again after application supplies more input data.
 177:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  *
 178:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * This approach to suspension assumes that all of a marker's parameters
 179:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * can fit into a single input bufferload.  This should hold for "normal"
 180:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * markers.  Some COM/APPn markers might have large parameter segments
 181:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * that might not fit.  If we are simply dropping such a marker, we use
 182:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * skip_input_data to get past it, and thereby put the problem on the
 183:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * source manager's shoulders.  If we are saving the marker's contents
 184:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * into memory, we use a slightly different convention: when forced to
 185:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * suspend, the marker processor updates the restart point to the end of
 186:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * what it's consumed (ie, the end of the buffer) before returning FALSE.
 187:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * On resumption, cinfo->unread_marker still contains the marker code,
 188:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * but the data source will point to the next chunk of marker data.
 189:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * The marker processor must retain internal state to deal with this.
 190:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  *
 191:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * Note that we don't bother to avoid duplicate trace messages if a
 192:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * suspension occurs within marker parameters.  Other side effects
 193:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  * require more care.
 194:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****  */
 195:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** 
 196:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** 
