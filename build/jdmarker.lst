1012:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****      */
1013:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****     switch (cinfo->unread_marker) {
1014:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****     case M_SOI:
1015:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****       if (! get_soi(cinfo))
1016:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** 	return JPEG_SUSPENDED;
