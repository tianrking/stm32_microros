 995:Middlewares/Third_Party/LibJPEG/source/jdmarker.c **** {
 996:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****   /* Outer loop repeats once for each marker. */
 997:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****   for (;;) {
 998:Middlewares/Third_Party/LibJPEG/source/jdmarker.c ****     /* Collect the marker proper, unless we already did. */
