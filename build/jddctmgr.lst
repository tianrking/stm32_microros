   8:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c ****  *
   9:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c ****  * This file contains the inverse-DCT management logic.
  10:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c ****  * This code selects a particular IDCT implementation to be used,
  11:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c ****  * and it performs related housekeeping chores.  No code in this file
  12:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c ****  * is executed per IDCT step, only during output pass setup.
  13:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c ****  *
  14:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c ****  * Note that the IDCT routines are responsible for performing coefficient
  15:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c ****  * dequantization as well as the IDCT proper.  This module sets up the
  16:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c ****  * dequantization multiplier table needed by the IDCT routine.
  17:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c ****  */
  18:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c **** 
  19:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c **** #define JPEG_INTERNALS
  20:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c **** #include "jinclude.h"
  21:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c **** #include "jpeglib.h"
  22:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c **** #include "jdct.h"		/* Private declarations for DCT subsystem */
  23:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c **** 
  24:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c **** 
  25:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c **** /*
  26:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c ****  * The decompressor input side (jdinput.c) saves away the appropriate
  27:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c ****  * quantization table for each component at the start of the first scan
ARM GAS  /tmp/ccxjlwcY.s 			page 2


  28:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c ****  * involving that component.  (This is necessary in order to correctly
  29:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c ****  * decode files that reuse Q-table slots.)
  30:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c ****  * When we are ready to make an output pass, the saved Q-table is converted
  31:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c ****  * to a multiplier table that will actually be used by the IDCT routine.
  32:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c ****  * The multiplier table contents are IDCT-method-dependent.  To support
  33:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c ****  * application changes in IDCT method between scans, we can remake the
  34:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c ****  * multiplier tables if necessary.
  35:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c ****  * In buffered-image mode, the first output pass may occur before any data
  36:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c ****  * has been seen for some components, and thus before their Q-tables have
  37:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c ****  * been saved away.  To handle this case, multiplier tables are preset
  38:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c ****  * to zeroes; the result of the IDCT will be a neutral gray level.
  39:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c ****  */
  40:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c **** 
  41:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c **** 
  42:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c **** /* Private subobject for this module */
  43:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c **** 
  44:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c **** typedef struct {
  45:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c ****   struct jpeg_inverse_dct pub;	/* public fields */
  46:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c **** 
  47:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c ****   /* This array contains the IDCT method code that each multiplier table
  48:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c ****    * is currently set up for, or -1 if it's not yet set up.
  49:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c ****    * The actual multiplier tables are pointed to by dct_table in the
  50:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c ****    * per-component comp_info structures.
  51:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c ****    */
  52:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c ****   int cur_method[MAX_COMPONENTS];
  53:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c **** } my_idct_controller;
  54:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c **** 
  55:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c **** typedef my_idct_controller * my_idct_ptr;
  56:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c **** 
  57:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c **** 
  58:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c **** /* Allocated multiplier tables: big enough for any supported variant */
  59:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c **** 
  60:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c **** typedef union {
  61:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c ****   ISLOW_MULT_TYPE islow_array[DCTSIZE2];
  62:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c **** #ifdef DCT_IFAST_SUPPORTED
  63:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c ****   IFAST_MULT_TYPE ifast_array[DCTSIZE2];
  64:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c **** #endif
  65:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c **** #ifdef DCT_FLOAT_SUPPORTED
  66:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c ****   FLOAT_MULT_TYPE float_array[DCTSIZE2];
  67:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c **** #endif
  68:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c **** } multiplier_table;
  69:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c **** 
  70:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c **** 
  71:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c **** /* The current scaled-IDCT routines require ISLOW-style multiplier tables,
  72:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c ****  * so be sure to compile that code if either ISLOW or SCALING is requested.
  73:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c ****  */
