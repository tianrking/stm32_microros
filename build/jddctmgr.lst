  78:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c **** #define PROVIDE_ISLOW_TABLES
  79:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c **** #endif
  80:Middlewares/Third_Party/LibJPEG/source/jddctmgr.c **** #endif
