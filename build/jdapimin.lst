 212:Middlewares/Third_Party/LibJPEG/source/jdapimin.c **** 
 213:Middlewares/Third_Party/LibJPEG/source/jdapimin.c **** 
 214:Middlewares/Third_Party/LibJPEG/source/jdapimin.c **** /*
 215:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****  * Decompression startup: read start of JPEG datastream to see what's there.
 216:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****  * Need only initialize JPEG object and supply a data source before calling.
 217:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****  *
 218:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****  * This routine will read as far as the first SOS marker (ie, actual start of
 219:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****  * compressed data), and will save all tables and parameters in the JPEG
 220:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****  * object.  It will also initialize the decompression parameters to default
 221:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****  * values, and finally return JPEG_HEADER_OK.  On return, the application may
 222:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****  * adjust the decompression parameters and then call jpeg_start_decompress.
 223:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****  * (Or, if the application only wanted to determine the image parameters,
 224:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****  * the data need not be decompressed.  In that case, call jpeg_abort or
 225:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****  * jpeg_destroy to release any temporary space.)
 226:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****  * If an abbreviated (tables only) datastream is presented, the routine will
 227:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****  * return JPEG_HEADER_TABLES_ONLY upon reaching EOI.  The application may then
 228:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****  * re-use the JPEG object to read the abbreviated image datastream(s).
 229:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****  * It is unnecessary (but OK) to call jpeg_abort in this case.
 230:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****  * The JPEG_SUSPENDED return code only occurs if the data source module
 231:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****  * requests suspension of the decompressor.  In this case the application
 232:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****  * should load more source data and then re-call jpeg_read_header to resume
 233:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****  * processing.
 234:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****  * If a non-suspending data source is used and require_image is TRUE, then the
 235:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****  * return code need not be inspected since only JPEG_HEADER_OK is possible.
 236:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****  *
 237:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****  * This routine is now just a front end to jpeg_consume_input, with some
 238:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****  * extra error checking.
 239:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****  */
 240:Middlewares/Third_Party/LibJPEG/source/jdapimin.c **** 
 241:Middlewares/Third_Party/LibJPEG/source/jdapimin.c **** GLOBAL(int)
ARM GAS  /tmp/ccEheNME.s 			page 18


 242:Middlewares/Third_Party/LibJPEG/source/jdapimin.c **** jpeg_read_header (j_decompress_ptr cinfo, boolean require_image)
 243:Middlewares/Third_Party/LibJPEG/source/jdapimin.c **** {
 244:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****   int retcode;
 245:Middlewares/Third_Party/LibJPEG/source/jdapimin.c **** 
 246:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****   if (cinfo->global_state != DSTATE_START &&
 247:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****       cinfo->global_state != DSTATE_INHEADER)
 248:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****     ERREXIT1(cinfo, JERR_BAD_STATE, cinfo->global_state);
 249:Middlewares/Third_Party/LibJPEG/source/jdapimin.c **** 
 250:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****   retcode = jpeg_consume_input(cinfo);
 251:Middlewares/Third_Party/LibJPEG/source/jdapimin.c **** 
 252:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****   switch (retcode) {
 253:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****   case JPEG_REACHED_SOS:
 254:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****     retcode = JPEG_HEADER_OK;
 255:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****     break;
 256:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****   case JPEG_REACHED_EOI:
 257:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****     if (require_image)		/* Complain if application wanted an image */
 258:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****       ERREXIT(cinfo, JERR_NO_IMAGE);
 259:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****     /* Reset to start state; it would be safer to require the application to
 260:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****      * call jpeg_abort, but we can't change it now for compatibility reasons.
 261:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****      * A side effect is to free any temporary memory (there shouldn't be any).
 262:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****      */
 263:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****     jpeg_abort((j_common_ptr) cinfo); /* sets state = DSTATE_START */
 264:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****     retcode = JPEG_HEADER_TABLES_ONLY;
 265:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****     break;
 266:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****   case JPEG_SUSPENDED:
 267:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****     /* no work */
 268:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****     break;
 269:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****   }
 270:Middlewares/Third_Party/LibJPEG/source/jdapimin.c **** 
 271:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****   return retcode;
 272:Middlewares/Third_Party/LibJPEG/source/jdapimin.c **** }
