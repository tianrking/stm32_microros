  71:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****   }
  72:Middlewares/Third_Party/LibJPEG/source/jdapimin.c **** 
  73:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****   /* Initialize marker processor so application can override methods
  74:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****    * for COM, APPn markers before calling jpeg_read_header.
  75:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****    */
