  78:Middlewares/Third_Party/LibJPEG/source/jdapimin.c **** 
  79:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****   /* And initialize the overall input controller. */
  80:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****   jinit_input_controller(cinfo);
  81:Middlewares/Third_Party/LibJPEG/source/jdapimin.c **** 
  82:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****   /* OK, I'm ready */
  83:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****   cinfo->global_state = DSTATE_START;
  84:Middlewares/Third_Party/LibJPEG/source/jdapimin.c **** }
