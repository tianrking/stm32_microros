  35:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****   /* Guard against version mismatches between library and caller. */
  36:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****   cinfo->mem = NULL;		/* so jpeg_destroy knows mem mgr not called */
  37:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****   if (version != JPEG_LIB_VERSION)
  38:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****     ERREXIT2(cinfo, JERR_BAD_LIB_VERSION, JPEG_LIB_VERSION, version);
  39:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****   if (structsize != SIZEOF(struct jpeg_decompress_struct))
  40:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****     ERREXIT2(cinfo, JERR_BAD_STRUCT_SIZE, 
  41:Middlewares/Third_Party/LibJPEG/source/jdapimin.c **** 	     (int) SIZEOF(struct jpeg_decompress_struct), (int) structsize);
  42:Middlewares/Third_Party/LibJPEG/source/jdapimin.c **** 
  43:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****   /* For debugging purposes, we zero the whole master structure.
  44:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****    * But the application has already set the err pointer, and may have set
  45:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****    * client_data, so we have to save and restore those fields.
  46:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****    * Note: if application hasn't set client_data, tools like Purify may
  47:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****    * complain here.
  48:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****    */
  49:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****   {
  50:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****     struct jpeg_error_mgr * err = cinfo->err;
  51:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****     void * client_data = cinfo->client_data; /* ignore Purify complaint here */
  52:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****     MEMZERO(cinfo, SIZEOF(struct jpeg_decompress_struct));
  53:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****     cinfo->err = err;
  54:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****     cinfo->client_data = client_data;
  55:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****   }
  56:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****   cinfo->is_decompressor = TRUE;
  57:Middlewares/Third_Party/LibJPEG/source/jdapimin.c **** 
  58:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****   /* Initialize a memory manager instance for this object */
  59:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****   jinit_memory_mgr((j_common_ptr) cinfo);
  60:Middlewares/Third_Party/LibJPEG/source/jdapimin.c **** 
  61:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****   /* Zero out pointers to permanent structures. */
  62:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****   cinfo->progress = NULL;
  63:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****   cinfo->src = NULL;
  64:Middlewares/Third_Party/LibJPEG/source/jdapimin.c **** 
  65:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****   for (i = 0; i < NUM_QUANT_TBLS; i++)
  66:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****     cinfo->quant_tbl_ptrs[i] = NULL;
  67:Middlewares/Third_Party/LibJPEG/source/jdapimin.c **** 
  68:Middlewares/Third_Party/LibJPEG/source/jdapimin.c ****   for (i = 0; i < NUM_HUFF_TBLS; i++) {
