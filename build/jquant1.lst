 170:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** 
 171:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** /*
 172:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * Policy-making subroutines for create_colormap and create_colorindex.
 173:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * These routines determine the colormap to be used.  The rest of the module
 174:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * only assumes that the colormap is orthogonal.
 175:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  *
 176:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  *  * select_ncolors decides how to divvy up the available colors
 177:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  *    among the components.
 178:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  *  * output_value defines the set of representative values for a component.
 179:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  *  * largest_input_value defines the mapping from input values to
 180:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  *    representative values for a component.
 181:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * Note that the latter two routines may impose different policies for
 182:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * different components, though this is not currently done.
 183:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  */
 184:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** 
 185:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** 
 186:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** LOCAL(int)
 187:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** select_ncolors (j_decompress_ptr cinfo, int Ncolors[])
 188:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** /* Determine allocation of desired colors to components, */
 189:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** /* and fill in Ncolors[] array to indicate choice. */
 190:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** /* Return value is total number of colors (product of Ncolors[] values). */
 191:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** {
