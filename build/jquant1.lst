 704:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** 	output_ptr += dir;	/* advance output ptr to next column */
 705:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** 	errorptr += dir;	/* advance errorptr to current column */
