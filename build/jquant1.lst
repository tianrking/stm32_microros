 671:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** 	 * Note: errorptr points to *previous* column's array entry.
 672:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** 	 */
 673:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** 	cur = RIGHT_SHIFT(cur + errorptr[dir] + 8, 4);
