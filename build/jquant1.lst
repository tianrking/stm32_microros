   1:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** /*
   2:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * jquant1.c
   3:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  *
   4:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * Copyright (C) 1991-1996, Thomas G. Lane.
   5:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * Modified 2011 by Guido Vollbeding.
   6:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * This file is part of the Independent JPEG Group's software.
   7:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * For conditions of distribution and use, see the accompanying README file.
   8:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  *
   9:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * This file contains 1-pass color quantization (color mapping) routines.
  10:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * These routines provide mapping to a fixed color map using equally spaced
  11:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * color values.  Optional Floyd-Steinberg or ordered dithering is available.
  12:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  */
  13:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** 
  14:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** #define JPEG_INTERNALS
  15:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** #include "jinclude.h"
  16:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** #include "jpeglib.h"
  17:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** 
  18:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** #ifdef QUANT_1PASS_SUPPORTED
  19:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** 
  20:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** 
  21:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** /*
  22:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * The main purpose of 1-pass quantization is to provide a fast, if not very
  23:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * high quality, colormapped output capability.  A 2-pass quantizer usually
  24:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * gives better visual quality; however, for quantized grayscale output this
  25:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * quantizer is perfectly adequate.  Dithering is highly recommended with this
  26:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * quantizer, though you can turn it off if you really want to.
  27:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  *
  28:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * In 1-pass quantization the colormap must be chosen in advance of seeing the
  29:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * image.  We use a map consisting of all combinations of Ncolors[i] color
  30:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * values for the i'th component.  The Ncolors[] values are chosen so that
ARM GAS  /tmp/ccNQr1EQ.s 			page 2


  31:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * their product, the total number of colors, is no more than that requested.
  32:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * (In most cases, the product will be somewhat less.)
  33:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  *
  34:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * Since the colormap is orthogonal, the representative value for each color
  35:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * component can be determined without considering the other components;
  36:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * then these indexes can be combined into a colormap index by a standard
  37:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * N-dimensional-array-subscript calculation.  Most of the arithmetic involved
  38:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * can be precalculated and stored in the lookup table colorindex[].
  39:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * colorindex[i][j] maps pixel value j in component i to the nearest
  40:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * representative value (grid plane) for that component; this index is
  41:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * multiplied by the array stride for component i, so that the
  42:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * index of the colormap entry closest to a given pixel value is just
  43:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  *    sum( colorindex[component-number][pixel-component-value] )
  44:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * Aside from being fast, this scheme allows for variable spacing between
  45:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * representative values with no additional lookup cost.
  46:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  *
  47:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * If gamma correction has been applied in color conversion, it might be wise
  48:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * to adjust the color grid spacing so that the representative colors are
  49:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * equidistant in linear space.  At this writing, gamma correction is not
  50:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * implemented by jdcolor, so nothing is done here.
  51:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  */
  52:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** 
  53:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** 
  54:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** /* Declarations for ordered dithering.
  55:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  *
  56:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * We use a standard 16x16 ordered dither array.  The basic concept of ordered
  57:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * dithering is described in many references, for instance Dale Schumacher's
  58:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * chapter II.2 of Graphics Gems II (James Arvo, ed. Academic Press, 1991).
  59:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * In place of Schumacher's comparisons against a "threshold" value, we add a
  60:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * "dither" value to the input pixel and then round the result to the nearest
  61:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * output value.  The dither value is equivalent to (0.5 - threshold) times
  62:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * the distance between output values.  For ordered dithering, we assume that
  63:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * the output colors are equally spaced; if not, results will probably be
  64:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * worse, since the dither may be too much or too little at a given point.
  65:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  *
  66:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * The normal calculation would be to form pixel value + dither, range-limit
  67:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * this to 0..MAXJSAMPLE, and then index into the colorindex table as usual.
  68:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * We can skip the separate range-limiting step by extending the colorindex
  69:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * table in both directions.
  70:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  */
  71:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** 
  72:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** #define ODITHER_SIZE  16	/* dimension of dither matrix */
  73:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** /* NB: if ODITHER_SIZE is not a power of 2, ODITHER_MASK uses will break */
  74:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** #define ODITHER_CELLS (ODITHER_SIZE*ODITHER_SIZE)	/* # cells in matrix */
  75:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** #define ODITHER_MASK  (ODITHER_SIZE-1) /* mask for wrapping around counters */
  76:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** 
  77:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** typedef int ODITHER_MATRIX[ODITHER_SIZE][ODITHER_SIZE];
  78:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** typedef int (*ODITHER_MATRIX_PTR)[ODITHER_SIZE];
  79:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** 
  80:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** static const UINT8 base_dither_matrix[ODITHER_SIZE][ODITHER_SIZE] = {
  81:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****   /* Bayer's order-4 dither array.  Generated by the code given in
  82:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****    * Stephen Hawley's article "Ordered Dithering" in Graphics Gems I.
  83:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****    * The values in this array must range from 0 to ODITHER_CELLS-1.
  84:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****    */
  85:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****   {   0,192, 48,240, 12,204, 60,252,  3,195, 51,243, 15,207, 63,255 },
  86:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****   { 128, 64,176,112,140, 76,188,124,131, 67,179,115,143, 79,191,127 },
  87:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****   {  32,224, 16,208, 44,236, 28,220, 35,227, 19,211, 47,239, 31,223 },
ARM GAS  /tmp/ccNQr1EQ.s 			page 3


  88:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****   { 160, 96,144, 80,172,108,156, 92,163, 99,147, 83,175,111,159, 95 },
  89:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****   {   8,200, 56,248,  4,196, 52,244, 11,203, 59,251,  7,199, 55,247 },
  90:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****   { 136, 72,184,120,132, 68,180,116,139, 75,187,123,135, 71,183,119 },
  91:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****   {  40,232, 24,216, 36,228, 20,212, 43,235, 27,219, 39,231, 23,215 },
