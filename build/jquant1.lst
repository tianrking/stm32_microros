 697:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** 	belowerr = bnexterr;
 698:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** 	cur += delta;		/* form error * 7 */
 699:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** 	/* At this point cur contains the 7/16 error value to be propagated
 700:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** 	 * to the next pixel on the current line, and all the errors for the
 701:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** 	 * next line have been shifted over. We are therefore ready to move on.
 702:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** 	 */
