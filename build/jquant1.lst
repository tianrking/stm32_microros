 103:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** 
 104:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** /* Declarations for Floyd-Steinberg dithering.
 105:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  *
 106:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * Errors are accumulated into the array fserrors[], at a resolution of
 107:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * 1/16th of a pixel count.  The error at a given pixel is propagated
 108:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * to its not-yet-processed neighbors using the standard F-S fractions,
 109:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  *		...	(here)	7/16
 110:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  *		3/16	5/16	1/16
 111:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * We work left-to-right on even rows, right-to-left on odd rows.
 112:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  *
 113:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * We can get away with a single array (holding one row's worth of errors)
 114:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * by using it to store the current row's errors at pixel columns not yet
 115:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * processed, but the next row's errors at columns already processed.  We
 116:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * need only a few extra variables to hold the errors immediately around the
 117:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * current column.  (If we are lucky, those variables are in registers, but
 118:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * even if not, they're probably cheaper to access than array elements are.)
 119:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  *
 120:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * The fserrors[] array is indexed [component#][position].
 121:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * We provide (#columns + 2) entries per component; the extra entry at each
 122:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * end saves us from special-casing the first and last pixels.
 123:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  *
 124:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * Note: on a wide image, we might not have enough room in a PC's near data
 125:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  * segment to hold the error array; so it is allocated with alloc_large.
 126:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****  */
 127:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** 
 128:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** #if BITS_IN_JSAMPLE == 8
 129:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** typedef INT16 FSERROR;		/* 16 bits should be enough */
 130:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** typedef int LOCFSERROR;		/* use 'int' for calculation temps */
 131:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** #else
 132:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** typedef INT32 FSERROR;		/* may need more than 16 bits */
 133:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** typedef INT32 LOCFSERROR;	/* be sure calculation temps are big enough */
 134:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** #endif
 135:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** 
 136:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** typedef FSERROR FAR *FSERRPTR;	/* pointer to error array (in FAR storage!) */
 137:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** 
 138:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** 
 139:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** /* Private subobject */
 140:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** 
 141:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** #define MAX_Q_COMPS 4		/* max components I can handle */
 142:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** 
 143:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** typedef struct {
 144:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****   struct jpeg_color_quantizer pub; /* public fields */
ARM GAS  /tmp/ccNQr1EQ.s 			page 4


 145:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** 
 146:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****   /* Initially allocated colormap is saved here */
 147:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****   JSAMPARRAY sv_colormap;	/* The color map as a 2-D pixel array */
 148:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****   int sv_actual;		/* number of entries in use */
 149:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** 
 150:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****   JSAMPARRAY colorindex;	/* Precomputed mapping for speed */
 151:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****   /* colorindex[i][j] = index of color closest to pixel value j in component i,
 152:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****    * premultiplied as described above.  Since colormap indexes must fit into
 153:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****    * JSAMPLEs, the entries of this array will too.
 154:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****    */
 155:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****   boolean is_padded;		/* is the colorindex padded for odither? */
 156:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** 
 157:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****   int Ncolors[MAX_Q_COMPS];	/* # of values alloced to each component */
 158:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** 
 159:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****   /* Variables for ordered dithering */
 160:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****   int row_index;		/* cur row's vertical index in dither matrix */
 161:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****   ODITHER_MATRIX_PTR odither[MAX_Q_COMPS]; /* one dither array per component */
 162:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** 
 163:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****   /* Variables for Floyd-Steinberg dithering */
 164:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****   FSERRPTR fserrors[MAX_Q_COMPS]; /* accumulated errors */
 165:Middlewares/Third_Party/LibJPEG/source/jquant1.c ****   boolean on_odd_row;		/* flag to remember which row we are on */
 166:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** } my_cquantizer;
 167:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** 
 168:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** typedef my_cquantizer * my_cquantize_ptr;
