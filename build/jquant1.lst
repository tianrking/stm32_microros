 683:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** 	/* Compute actual representation error at this pixel */
 684:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** 	/* Note: we can do this even though we don't have the final */
 685:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** 	/* pixel code, because the colormap is orthogonal. */
 686:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** 	cur -= GETJSAMPLE(colormap_ci[pixcode]);
