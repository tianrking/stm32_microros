 688:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** 	 * Add these into the running sums, and simultaneously shift the
 689:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** 	 * next-line error sums left by 1 column.
 690:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** 	 */
 691:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** 	bnexterr = cur;
 692:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** 	delta = cur * 2;
 693:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** 	cur += delta;		/* form error * 3 */
 694:Middlewares/Third_Party/LibJPEG/source/jquant1.c **** 	errorptr[0] = (FSERROR) (bpreverr + cur);
