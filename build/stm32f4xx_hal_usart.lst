 659:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c **** /** @defgroup USART_Exported_Functions_Group2 IO operation functions
 660:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****   *  @brief   USART Transmit and Receive functions
 661:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****   *
 662:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c **** @verbatim
 663:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****   ==============================================================================
 664:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****                          ##### IO operation functions #####
 665:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****   ==============================================================================
 666:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****   [..]
 667:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****     This subsection provides a set of functions allowing to manage the USART synchronous
 668:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****     data transfers.
 669:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c **** 
 670:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****   [..]
 671:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****     The USART supports master mode only: it cannot receive or send data related to an input
 672:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****     clock (SCLK is always an output).
 673:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c **** 
 674:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****     (#) There are two modes of transfer:
 675:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****         (++) Blocking mode: The communication is performed in polling mode.
 676:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****              The HAL status of all data processing is returned by the same function
 677:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****              after finishing transfer.
 678:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****         (++) No-Blocking mode: The communication is performed using Interrupts
 679:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****              or DMA, These API's return the HAL status.
 680:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****              The end of the data processing will be indicated through the
 681:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****              dedicated USART IRQ when using Interrupt mode or the DMA IRQ when
 682:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****              using DMA mode.
 683:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****              The HAL_USART_TxCpltCallback(), HAL_USART_RxCpltCallback() and HAL_USART_TxRxCpltCallb
 684:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****               user callbacks
 685:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****              will be executed respectively at the end of the transmit or Receive process
 686:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****              The HAL_USART_ErrorCallback() user callback will be executed when a communication
 687:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****              error is detected
 688:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c **** 
 689:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****     (#) Blocking mode APIs are :
 690:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****         (++) HAL_USART_Transmit() in simplex mode
 691:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****         (++) HAL_USART_Receive() in full duplex receive only
 692:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****         (++) HAL_USART_TransmitReceive() in full duplex mode
 693:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c **** 
 694:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****     (#) Non Blocking mode APIs with Interrupt are :
 695:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****         (++) HAL_USART_Transmit_IT()in simplex mode
 696:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****         (++) HAL_USART_Receive_IT() in full duplex receive only
 697:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****         (++) HAL_USART_TransmitReceive_IT() in full duplex mode
 698:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****         (++) HAL_USART_IRQHandler()
 699:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c **** 
 700:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****     (#) Non Blocking mode functions with DMA are :
 701:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****         (++) HAL_USART_Transmit_DMA()in simplex mode
 702:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****         (++) HAL_USART_Receive_DMA() in full duplex receive only
 703:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****         (++) HAL_USART_TransmitReceive_DMA() in full duplex mode
 704:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****         (++) HAL_USART_DMAPause()
 705:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****         (++) HAL_USART_DMAResume()
 706:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****         (++) HAL_USART_DMAStop()
 707:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c **** 
 708:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****     (#) A set of Transfer Complete Callbacks are provided in non Blocking mode:
 709:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****         (++) HAL_USART_TxHalfCpltCallback()
 710:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****         (++) HAL_USART_TxCpltCallback()
 711:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****         (++) HAL_USART_RxHalfCpltCallback()
 712:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****         (++) HAL_USART_RxCpltCallback()
 713:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****         (++) HAL_USART_ErrorCallback()
 714:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****         (++) HAL_USART_TxRxCpltCallback()
ARM GAS  /tmp/ccJhGLzv.s 			page 14


 715:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c **** 
 716:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****     (#) Non-Blocking mode transfers could be aborted using Abort API's :
 717:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****         (++) HAL_USART_Abort()
 718:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****         (++) HAL_USART_Abort_IT()
 719:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c **** 
 720:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****     (#) For Abort services based on interrupts (HAL_USART_Abort_IT), a Abort Complete Callbacks is 
 721:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****         (++) HAL_USART_AbortCpltCallback()
 722:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c **** 
 723:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****     (#) In Non-Blocking mode transfers, possible errors are split into 2 categories.
 724:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****         Errors are handled as follows :
 725:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****         (++) Error is considered as Recoverable and non blocking : Transfer could go till end, but 
 726:Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c ****              to be evaluated by user : this concerns Frame Error, Parity Error or Noise Error in In
