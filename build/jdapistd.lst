   7:Middlewares/Third_Party/LibJPEG/source/jdapistd.c ****  *
   8:Middlewares/Third_Party/LibJPEG/source/jdapistd.c ****  * This file contains application interface code for the decompression half
   9:Middlewares/Third_Party/LibJPEG/source/jdapistd.c ****  * of the JPEG library.  These are the "standard" API routines that are
  10:Middlewares/Third_Party/LibJPEG/source/jdapistd.c ****  * used in the normal full-decompression case.  They are not used by a
  11:Middlewares/Third_Party/LibJPEG/source/jdapistd.c ****  * transcoding-only application.  Note that if an application links in
  12:Middlewares/Third_Party/LibJPEG/source/jdapistd.c ****  * jpeg_start_decompress, it will end up linking in the entire decompressor.
  13:Middlewares/Third_Party/LibJPEG/source/jdapistd.c ****  * We thus must separate this file from jdapimin.c to avoid linking the
  14:Middlewares/Third_Party/LibJPEG/source/jdapistd.c ****  * whole decompression library into a transcoder.
  15:Middlewares/Third_Party/LibJPEG/source/jdapistd.c ****  */
  16:Middlewares/Third_Party/LibJPEG/source/jdapistd.c **** 
  17:Middlewares/Third_Party/LibJPEG/source/jdapistd.c **** #define JPEG_INTERNALS
  18:Middlewares/Third_Party/LibJPEG/source/jdapistd.c **** #include "jinclude.h"
  19:Middlewares/Third_Party/LibJPEG/source/jdapistd.c **** #include "jpeglib.h"
  20:Middlewares/Third_Party/LibJPEG/source/jdapistd.c **** 
  21:Middlewares/Third_Party/LibJPEG/source/jdapistd.c **** 
  22:Middlewares/Third_Party/LibJPEG/source/jdapistd.c **** /* Forward declarations */
  23:Middlewares/Third_Party/LibJPEG/source/jdapistd.c **** LOCAL(boolean) output_pass_setup JPP((j_decompress_ptr cinfo));
  24:Middlewares/Third_Party/LibJPEG/source/jdapistd.c **** 
  25:Middlewares/Third_Party/LibJPEG/source/jdapistd.c **** 
  26:Middlewares/Third_Party/LibJPEG/source/jdapistd.c **** /*
  27:Middlewares/Third_Party/LibJPEG/source/jdapistd.c ****  * Decompression initialization.
  28:Middlewares/Third_Party/LibJPEG/source/jdapistd.c ****  * jpeg_read_header must be completed before calling this.
  29:Middlewares/Third_Party/LibJPEG/source/jdapistd.c ****  *
  30:Middlewares/Third_Party/LibJPEG/source/jdapistd.c ****  * If a multipass operating mode was selected, this will do all but the
ARM GAS  /tmp/ccSsLztk.s 			page 2


  31:Middlewares/Third_Party/LibJPEG/source/jdapistd.c ****  * last pass, and thus may take a great deal of time.
  32:Middlewares/Third_Party/LibJPEG/source/jdapistd.c ****  *
  33:Middlewares/Third_Party/LibJPEG/source/jdapistd.c ****  * Returns FALSE if suspended.  The return value need be inspected only if
  34:Middlewares/Third_Party/LibJPEG/source/jdapistd.c ****  * a suspending data source is used.
  35:Middlewares/Third_Party/LibJPEG/source/jdapistd.c ****  */
  36:Middlewares/Third_Party/LibJPEG/source/jdapistd.c **** 
  37:Middlewares/Third_Party/LibJPEG/source/jdapistd.c **** GLOBAL(boolean)
  38:Middlewares/Third_Party/LibJPEG/source/jdapistd.c **** jpeg_start_decompress (j_decompress_ptr cinfo)
  39:Middlewares/Third_Party/LibJPEG/source/jdapistd.c **** {
  40:Middlewares/Third_Party/LibJPEG/source/jdapistd.c ****   if (cinfo->global_state == DSTATE_READY) {
  41:Middlewares/Third_Party/LibJPEG/source/jdapistd.c ****     /* First call: initialize master control, select active modules */
  42:Middlewares/Third_Party/LibJPEG/source/jdapistd.c ****     jinit_master_decompress(cinfo);
  43:Middlewares/Third_Party/LibJPEG/source/jdapistd.c ****     if (cinfo->buffered_image) {
  44:Middlewares/Third_Party/LibJPEG/source/jdapistd.c ****       /* No more work here; expecting jpeg_start_output next */
  45:Middlewares/Third_Party/LibJPEG/source/jdapistd.c ****       cinfo->global_state = DSTATE_BUFIMAGE;
  46:Middlewares/Third_Party/LibJPEG/source/jdapistd.c ****       return TRUE;
  47:Middlewares/Third_Party/LibJPEG/source/jdapistd.c ****     }
  48:Middlewares/Third_Party/LibJPEG/source/jdapistd.c ****     cinfo->global_state = DSTATE_PRELOAD;
  49:Middlewares/Third_Party/LibJPEG/source/jdapistd.c ****   }
  50:Middlewares/Third_Party/LibJPEG/source/jdapistd.c ****   if (cinfo->global_state == DSTATE_PRELOAD) {
  51:Middlewares/Third_Party/LibJPEG/source/jdapistd.c ****     /* If file has multiple scans, absorb them all into the coef buffer */
  52:Middlewares/Third_Party/LibJPEG/source/jdapistd.c ****     if (cinfo->inputctl->has_multiple_scans) {
  53:Middlewares/Third_Party/LibJPEG/source/jdapistd.c **** #ifdef D_MULTISCAN_FILES_SUPPORTED
  54:Middlewares/Third_Party/LibJPEG/source/jdapistd.c ****       for (;;) {
  55:Middlewares/Third_Party/LibJPEG/source/jdapistd.c **** 	int retcode;
  56:Middlewares/Third_Party/LibJPEG/source/jdapistd.c **** 	/* Call progress monitor hook if present */
  57:Middlewares/Third_Party/LibJPEG/source/jdapistd.c **** 	if (cinfo->progress != NULL)
  58:Middlewares/Third_Party/LibJPEG/source/jdapistd.c **** 	  (*cinfo->progress->progress_monitor) ((j_common_ptr) cinfo);
  59:Middlewares/Third_Party/LibJPEG/source/jdapistd.c **** 	/* Absorb some more input */
  60:Middlewares/Third_Party/LibJPEG/source/jdapistd.c **** 	retcode = (*cinfo->inputctl->consume_input) (cinfo);
  61:Middlewares/Third_Party/LibJPEG/source/jdapistd.c **** 	if (retcode == JPEG_SUSPENDED)
  62:Middlewares/Third_Party/LibJPEG/source/jdapistd.c **** 	  return FALSE;
  63:Middlewares/Third_Party/LibJPEG/source/jdapistd.c **** 	if (retcode == JPEG_REACHED_EOI)
  64:Middlewares/Third_Party/LibJPEG/source/jdapistd.c **** 	  break;
  65:Middlewares/Third_Party/LibJPEG/source/jdapistd.c **** 	/* Advance progress counter if appropriate */
  66:Middlewares/Third_Party/LibJPEG/source/jdapistd.c **** 	if (cinfo->progress != NULL &&
  67:Middlewares/Third_Party/LibJPEG/source/jdapistd.c **** 	    (retcode == JPEG_ROW_COMPLETED || retcode == JPEG_REACHED_SOS)) {
  68:Middlewares/Third_Party/LibJPEG/source/jdapistd.c **** 	  if (++cinfo->progress->pass_counter >= cinfo->progress->pass_limit) {
  69:Middlewares/Third_Party/LibJPEG/source/jdapistd.c **** 	    /* jdmaster underestimated number of scans; ratchet up one scan */
  70:Middlewares/Third_Party/LibJPEG/source/jdapistd.c **** 	    cinfo->progress->pass_limit += (long) cinfo->total_iMCU_rows;
  71:Middlewares/Third_Party/LibJPEG/source/jdapistd.c **** 	  }
  72:Middlewares/Third_Party/LibJPEG/source/jdapistd.c **** 	}
  73:Middlewares/Third_Party/LibJPEG/source/jdapistd.c ****       }
  74:Middlewares/Third_Party/LibJPEG/source/jdapistd.c **** #else
  75:Middlewares/Third_Party/LibJPEG/source/jdapistd.c ****       ERREXIT(cinfo, JERR_NOT_COMPILED);
  76:Middlewares/Third_Party/LibJPEG/source/jdapistd.c **** #endif /* D_MULTISCAN_FILES_SUPPORTED */
  77:Middlewares/Third_Party/LibJPEG/source/jdapistd.c ****     }
  78:Middlewares/Third_Party/LibJPEG/source/jdapistd.c ****     cinfo->output_scan_number = cinfo->input_scan_number;
  79:Middlewares/Third_Party/LibJPEG/source/jdapistd.c ****   } else if (cinfo->global_state != DSTATE_PRESCAN)
  80:Middlewares/Third_Party/LibJPEG/source/jdapistd.c ****     ERREXIT1(cinfo, JERR_BAD_STATE, cinfo->global_state);
  81:Middlewares/Third_Party/LibJPEG/source/jdapistd.c ****   /* Perform any dummy output passes, and set up for the final pass */
  82:Middlewares/Third_Party/LibJPEG/source/jdapistd.c ****   return output_pass_setup(cinfo);
  83:Middlewares/Third_Party/LibJPEG/source/jdapistd.c **** }
