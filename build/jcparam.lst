  19:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** /*
  20:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****  * Quantization table setup routines
  21:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****  */
  22:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** 
  23:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** GLOBAL(void)
  24:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** jpeg_add_quant_table (j_compress_ptr cinfo, int which_tbl,
  25:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** 		      const unsigned int *basic_table,
  26:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** 		      int scale_factor, boolean force_baseline)
  27:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** /* Define a quantization table equal to the basic_table times
  28:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****  * a scale factor (given as a percentage).
  29:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****  * If force_baseline is TRUE, the computed quantization table entries
  30:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****  * are limited to 1..255 for JPEG baseline compatibility.
ARM GAS  /tmp/ccROVWcA.s 			page 2


  31:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****  */
  32:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** {
  33:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   JQUANT_TBL ** qtblptr;
  34:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   int i;
  35:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   long temp;
  36:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** 
  37:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   /* Safety check to ensure start_compress not called yet. */
  38:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   if (cinfo->global_state != CSTATE_START)
  39:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****     ERREXIT1(cinfo, JERR_BAD_STATE, cinfo->global_state);
  40:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** 
  41:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   if (which_tbl < 0 || which_tbl >= NUM_QUANT_TBLS)
  42:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****     ERREXIT1(cinfo, JERR_DQT_INDEX, which_tbl);
  43:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** 
  44:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   qtblptr = & cinfo->quant_tbl_ptrs[which_tbl];
  45:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** 
  46:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   if (*qtblptr == NULL)
  47:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****     *qtblptr = jpeg_alloc_quant_table((j_common_ptr) cinfo);
  48:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** 
  49:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   for (i = 0; i < DCTSIZE2; i++) {
  50:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****     temp = ((long) basic_table[i] * scale_factor + 50L) / 100L;
  51:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****     /* limit the values to the valid range */
  52:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****     if (temp <= 0L) temp = 1L;
  53:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****     if (temp > 32767L) temp = 32767L; /* max quantizer needed for 12 bits */
  54:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****     if (force_baseline && temp > 255L)
  55:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****       temp = 255L;		/* limit to baseline range if requested */
  56:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****     (*qtblptr)->quantval[i] = (UINT16) temp;
  57:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   }
  58:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** 
  59:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   /* Initialize sent_table FALSE so table will be written to JPEG file. */
  60:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   (*qtblptr)->sent_table = FALSE;
  61:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** }
