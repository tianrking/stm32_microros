  88:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** 
  89:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** 
  90:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** GLOBAL(void)
  91:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** jpeg_default_qtables (j_compress_ptr cinfo, boolean force_baseline)
  92:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** /* Set or change the 'quality' (quantization) setting, using default tables
  93:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****  * and straight percentage-scaling quality scales.
  94:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****  * This entry point allows different scalings for luminance and chrominance.
  95:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****  */
  96:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** {
  97:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   /* Set up two quantization tables using the specified scaling */
  98:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   jpeg_add_quant_table(cinfo, 0, std_luminance_quant_tbl,
  99:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** 		       cinfo->q_scale_factor[0], force_baseline);
 100:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   jpeg_add_quant_table(cinfo, 1, std_chrominance_quant_tbl,
 101:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** 		       cinfo->q_scale_factor[1], force_baseline);
 102:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** }
 103:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** 
 104:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** 
 105:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** GLOBAL(void)
 106:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** jpeg_set_linear_quality (j_compress_ptr cinfo, int scale_factor,
 107:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** 			 boolean force_baseline)
 108:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** /* Set or change the 'quality' (quantization) setting, using default tables
 109:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****  * and a straight percentage-scaling quality scale.  In most cases it's better
 110:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****  * to use jpeg_set_quality (below); this entry point is provided for
 111:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****  * applications that insist on a linear percentage scaling.
 112:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****  */
 113:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** {
 114:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   /* Set up two quantization tables using the specified scaling */
 115:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   jpeg_add_quant_table(cinfo, 0, std_luminance_quant_tbl,
 116:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** 		       scale_factor, force_baseline);
 117:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   jpeg_add_quant_table(cinfo, 1, std_chrominance_quant_tbl,
 118:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** 		       scale_factor, force_baseline);
 119:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** }
 120:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** 
 121:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** 
 122:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** GLOBAL(int)
 123:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** jpeg_quality_scaling (int quality)
 124:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** /* Convert a user-specified quality rating to a percentage scaling factor
 125:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****  * for an underlying quantization table, using our recommended scaling curve.
 126:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****  * The input 'quality' factor should be 0 (terrible) to 100 (very good).
 127:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****  */
 128:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** {
 129:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   /* Safety limit on quality factor.  Convert 0 to 1 to avoid zero divide. */
 130:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   if (quality <= 0) quality = 1;
 131:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   if (quality > 100) quality = 100;
 132:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** 
 133:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   /* The basic table is used as-is (scaling 100) for a quality of 50.
 134:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****    * Qualities 50..100 are converted to scaling percentage 200 - 2*Q;
 135:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****    * note that at Q=100 the scaling is 0, which will cause jpeg_add_quant_table
 136:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****    * to make all the table entries 1 (hence, minimum quantization loss).
 137:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****    * Qualities 1..50 are converted to scaling percentage 5000/Q.
 138:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****    */
 139:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   if (quality < 50)
 140:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****     quality = 5000 / quality;
 141:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   else
 142:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****     quality = 200 - quality*2;
 143:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** 
 144:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   return quality;
ARM GAS  /tmp/ccROVWcA.s 			page 4


 145:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** }
 146:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** 
 147:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** 
 148:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** GLOBAL(void)
 149:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** jpeg_set_quality (j_compress_ptr cinfo, int quality, boolean force_baseline)
 150:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** /* Set or change the 'quality' (quantization) setting, using default tables.
 151:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****  * This is the standard quality-adjusting entry point for typical user
 152:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****  * interfaces; only those who want detailed control over quantization tables
 153:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****  * would use the preceding three routines directly.
 154:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****  */
 155:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** {
 156:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   /* Convert user 0-100 rating to percentage scaling */
 157:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   quality = jpeg_quality_scaling(quality);
 158:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** 
 159:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   /* Set up standard quality tables */
 160:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   jpeg_set_linear_quality(cinfo, quality, force_baseline);
 161:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** }
 162:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** 
 163:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** 
 164:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** /*
 165:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****  * Huffman table setup routines
 166:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****  */
 167:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** 
 168:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** LOCAL(void)
 169:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** add_huff_table (j_compress_ptr cinfo,
 170:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** 		JHUFF_TBL **htblptr, const UINT8 *bits, const UINT8 *val)
 171:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** /* Define a Huffman table */
 172:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** {
 173:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   int nsymbols, len;
 174:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** 
 175:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   if (*htblptr == NULL)
 176:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****     *htblptr = jpeg_alloc_huff_table((j_common_ptr) cinfo);
 177:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** 
 178:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   /* Copy the number-of-symbols-of-each-code-length counts */
 179:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   MEMCOPY((*htblptr)->bits, bits, SIZEOF((*htblptr)->bits));
 180:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** 
 181:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   /* Validate the counts.  We do this here mainly so we can copy the right
 182:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****    * number of symbols from the val[] array, without risking marching off
 183:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****    * the end of memory.  jchuff.c will do a more thorough test later.
 184:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****    */
 185:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   nsymbols = 0;
 186:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   for (len = 1; len <= 16; len++)
 187:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****     nsymbols += bits[len];
 188:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   if (nsymbols < 1 || nsymbols > 256)
 189:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****     ERREXIT(cinfo, JERR_BAD_HUFF_TABLE);
 190:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** 
 191:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   MEMCOPY((*htblptr)->huffval, val, nsymbols * SIZEOF(UINT8));
 192:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** 
 193:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   /* Initialize sent_table FALSE so table will be written to JPEG file. */
 194:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   (*htblptr)->sent_table = FALSE;
 195:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** }
 196:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** 
 197:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** 
 198:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** LOCAL(void)
 199:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** std_huff_tables (j_compress_ptr cinfo)
 200:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** /* Set up the standard Huffman tables (cf. JPEG standard section K.3) */
 201:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** /* IMPORTANT: these are only valid for 8-bit data precision! */
