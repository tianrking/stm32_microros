  63:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** 
  64:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** /* These are the sample quantization tables given in JPEG spec section K.1.
  65:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****  * The spec says that the values given produce "good" quality, and
  66:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****  * when divided by 2, "very good" quality.
  67:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****  */
  68:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** static const unsigned int std_luminance_quant_tbl[DCTSIZE2] = {
  69:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   16,  11,  10,  16,  24,  40,  51,  61,
  70:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   12,  12,  14,  19,  26,  58,  60,  55,
  71:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   14,  13,  16,  24,  40,  57,  69,  56,
  72:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   14,  17,  22,  29,  51,  87,  80,  62,
  73:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   18,  22,  37,  56,  68, 109, 103,  77,
  74:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   24,  35,  55,  64,  81, 104, 113,  92,
  75:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   49,  64,  78,  87, 103, 121, 120, 101,
  76:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   72,  92,  95,  98, 112, 100, 103,  99
  77:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** };
  78:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** static const unsigned int std_chrominance_quant_tbl[DCTSIZE2] = {
  79:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   17,  18,  24,  47,  99,  99,  99,  99,
  80:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   18,  21,  26,  66,  99,  99,  99,  99,
  81:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   24,  26,  56,  99,  99,  99,  99,  99,
  82:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   47,  66,  99,  99,  99,  99,  99,  99,
  83:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   99,  99,  99,  99,  99,  99,  99,  99,
  84:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   99,  99,  99,  99,  99,  99,  99,  99,
  85:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   99,  99,  99,  99,  99,  99,  99,  99,
  86:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   99,  99,  99,  99,  99,  99,  99,  99
  87:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** };
