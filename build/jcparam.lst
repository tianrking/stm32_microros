 432:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****    * tables 1 for chrominance components.
 433:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****    */
 434:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** 
 435:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   cinfo->jpeg_color_space = colorspace;
 436:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** 
 437:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   cinfo->write_JFIF_header = FALSE; /* No marker for non-JFIF colorspaces */
 438:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   cinfo->write_Adobe_marker = FALSE; /* write no Adobe marker by default */
 439:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** 
 440:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   switch (colorspace) {
 441:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   case JCS_GRAYSCALE:
 442:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****     cinfo->write_JFIF_header = TRUE; /* Write a JFIF marker */
 443:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****     cinfo->num_components = 1;
 444:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****     /* JFIF specifies component ID 1 */
 445:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****     SET_COMP(0, 1, 1,1, 0, 0,0);
 446:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****     break;
 447:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   case JCS_RGB:
 448:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****     cinfo->write_Adobe_marker = TRUE; /* write Adobe marker to flag RGB */
 449:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****     cinfo->num_components = 3;
 450:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****     SET_COMP(0, 0x52 /* 'R' */, 1,1, 0, 0,0);
 451:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****     SET_COMP(1, 0x47 /* 'G' */, 1,1, 0, 0,0);
 452:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****     SET_COMP(2, 0x42 /* 'B' */, 1,1, 0, 0,0);
 453:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****     break;
 454:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   case JCS_YCbCr:
 455:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****     cinfo->write_JFIF_header = TRUE; /* Write a JFIF marker */
 456:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****     cinfo->num_components = 3;
 457:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****     /* JFIF specifies component IDs 1,2,3 */
 458:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****     /* We default to 2x2 subsamples of chrominance */
 459:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****     SET_COMP(0, 1, 2,2, 0, 0,0);
 460:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****     SET_COMP(1, 2, 1,1, 1, 1,1);
 461:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****     SET_COMP(2, 3, 1,1, 1, 1,1);
 462:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****     break;
 463:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   case JCS_CMYK:
 464:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****     cinfo->write_Adobe_marker = TRUE; /* write Adobe marker to flag CMYK */
 465:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****     cinfo->num_components = 4;
 466:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****     SET_COMP(0, 0x43 /* 'C' */, 1,1, 0, 0,0);
 467:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****     SET_COMP(1, 0x4D /* 'M' */, 1,1, 0, 0,0);
 468:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****     SET_COMP(2, 0x59 /* 'Y' */, 1,1, 0, 0,0);
 469:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****     SET_COMP(3, 0x4B /* 'K' */, 1,1, 0, 0,0);
 470:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****     break;
 471:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   case JCS_YCCK:
 472:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****     cinfo->write_Adobe_marker = TRUE; /* write Adobe marker to flag YCCK */
 473:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****     cinfo->num_components = 4;
 474:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****     SET_COMP(0, 1, 2,2, 0, 0,0);
 475:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****     SET_COMP(1, 2, 1,1, 1, 1,1);
 476:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****     SET_COMP(2, 3, 1,1, 1, 1,1);
 477:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****     SET_COMP(3, 4, 2,2, 0, 0,0);
 478:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****     break;
 479:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****   case JCS_UNKNOWN:
 480:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****     cinfo->num_components = cinfo->input_components;
 481:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****     if (cinfo->num_components < 1 || cinfo->num_components > MAX_COMPONENTS)
 482:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****       ERREXIT2(cinfo, JERR_COMPONENT_COUNT, cinfo->num_components,
 483:Middlewares/Third_Party/LibJPEG/source/jcparam.c **** 	       MAX_COMPONENTS);
 484:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****     for (ci = 0; ci < cinfo->num_components; ci++) {
 485:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****       SET_COMP(ci, ci, 1,1, 0, 0,0);
 486:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****     }
ARM GAS  /tmp/ccROVWcA.s 			page 10


 487:Middlewares/Third_Party/LibJPEG/source/jcparam.c ****     break;
