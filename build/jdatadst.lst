  87:Middlewares/Third_Party/LibJPEG/source/jdatadst.c **** /*
  88:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****  * Empty the output buffer --- called whenever buffer fills up.
  89:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****  *
  90:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****  * In typical applications, this should write the entire output buffer
  91:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****  * (ignoring the current state of next_output_byte & free_in_buffer),
  92:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****  * reset the pointer & count to the start of the buffer, and return TRUE
  93:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****  * indicating that the buffer has been dumped.
  94:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****  *
  95:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****  * In applications that need to be able to suspend compression due to output
  96:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****  * overrun, a FALSE return indicates that the buffer cannot be emptied now.
  97:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****  * In this situation, the compressor will return to its caller (possibly with
  98:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****  * an indication that it has not accepted all the supplied scanlines).  The
  99:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****  * application should resume compression after it has made more room in the
 100:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****  * output buffer.  Note that there are substantial restrictions on the use of
 101:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****  * suspension --- see the documentation.
 102:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****  *
 103:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****  * When suspending, the compressor will back up to a convenient restart point
 104:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****  * (typically the start of the current MCU). next_output_byte & free_in_buffer
 105:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****  * indicate where the restart point will be if the current call returns FALSE.
 106:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****  * Data beyond this point will be regenerated after resumption, so do not
 107:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****  * write it out when emptying the buffer externally.
 108:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****  */
 109:Middlewares/Third_Party/LibJPEG/source/jdatadst.c **** #ifdef JFILE
 110:Middlewares/Third_Party/LibJPEG/source/jdatadst.c **** METHODDEF(boolean)
 111:Middlewares/Third_Party/LibJPEG/source/jdatadst.c **** empty_output_buffer (j_compress_ptr cinfo)
 112:Middlewares/Third_Party/LibJPEG/source/jdatadst.c **** {
 113:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****   my_dest_ptr dest = (my_dest_ptr) cinfo->dest;
 114:Middlewares/Third_Party/LibJPEG/source/jdatadst.c **** 
 115:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****   if (JFWRITE(dest->outfile, dest->buffer, OUTPUT_BUF_SIZE) !=
 116:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****       (size_t) OUTPUT_BUF_SIZE)
 117:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****     ERREXIT(cinfo, JERR_FILE_WRITE);
 118:Middlewares/Third_Party/LibJPEG/source/jdatadst.c **** 
 119:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****   dest->pub.next_output_byte = dest->buffer;
 120:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****   dest->pub.free_in_buffer = OUTPUT_BUF_SIZE;
 121:Middlewares/Third_Party/LibJPEG/source/jdatadst.c **** 
 122:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****   return TRUE;
 123:Middlewares/Third_Party/LibJPEG/source/jdatadst.c **** }
 124:Middlewares/Third_Party/LibJPEG/source/jdatadst.c **** #endif /* JFILE */
 125:Middlewares/Third_Party/LibJPEG/source/jdatadst.c **** 
 126:Middlewares/Third_Party/LibJPEG/source/jdatadst.c **** METHODDEF(boolean)
 127:Middlewares/Third_Party/LibJPEG/source/jdatadst.c **** empty_mem_output_buffer (j_compress_ptr cinfo)
 128:Middlewares/Third_Party/LibJPEG/source/jdatadst.c **** {
 129:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****   size_t nextsize;
 130:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****   JOCTET * nextbuffer;
 131:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****   my_mem_dest_ptr dest = (my_mem_dest_ptr) cinfo->dest;
 132:Middlewares/Third_Party/LibJPEG/source/jdatadst.c **** 
 133:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****   /* Try to allocate new buffer with double size */
 134:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****   nextsize = dest->bufsize * 2;
 135:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****   nextbuffer = (JOCTET *) malloc(nextsize);
 136:Middlewares/Third_Party/LibJPEG/source/jdatadst.c **** 
ARM GAS  /tmp/ccRfMl7w.s 			page 5


 137:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****   if (nextbuffer == NULL)
 138:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****     ERREXIT1(cinfo, JERR_OUT_OF_MEMORY, 10);
 139:Middlewares/Third_Party/LibJPEG/source/jdatadst.c **** 
 140:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****   MEMCOPY(nextbuffer, dest->buffer, dest->bufsize);
 141:Middlewares/Third_Party/LibJPEG/source/jdatadst.c **** 
 142:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****   if (dest->newbuffer != NULL)
 143:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****     free(dest->newbuffer);
 144:Middlewares/Third_Party/LibJPEG/source/jdatadst.c **** 
 145:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****   dest->newbuffer = nextbuffer;
 146:Middlewares/Third_Party/LibJPEG/source/jdatadst.c **** 
 147:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****   dest->pub.next_output_byte = nextbuffer + dest->bufsize;
 148:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****   dest->pub.free_in_buffer = dest->bufsize;
 149:Middlewares/Third_Party/LibJPEG/source/jdatadst.c **** 
 150:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****   dest->buffer = nextbuffer;
 151:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****   dest->bufsize = nextsize;
 152:Middlewares/Third_Party/LibJPEG/source/jdatadst.c **** 
 153:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****   return TRUE;
 154:Middlewares/Third_Party/LibJPEG/source/jdatadst.c **** }
 155:Middlewares/Third_Party/LibJPEG/source/jdatadst.c **** 
 156:Middlewares/Third_Party/LibJPEG/source/jdatadst.c **** 
 157:Middlewares/Third_Party/LibJPEG/source/jdatadst.c **** /*
 158:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****  * Terminate destination --- called by jpeg_finish_compress
 159:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****  * after all data has been written.  Usually needs to flush buffer.
 160:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****  *
 161:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****  * NB: *not* called by jpeg_abort or jpeg_destroy; surrounding
 162:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****  * application must deal with any cleanup that should happen even
 163:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****  * for error exit.
 164:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****  */
 165:Middlewares/Third_Party/LibJPEG/source/jdatadst.c **** #ifdef JFILE
 166:Middlewares/Third_Party/LibJPEG/source/jdatadst.c **** METHODDEF(void)
 167:Middlewares/Third_Party/LibJPEG/source/jdatadst.c **** term_destination (j_compress_ptr cinfo)
 168:Middlewares/Third_Party/LibJPEG/source/jdatadst.c **** {
 169:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****   my_dest_ptr dest = (my_dest_ptr) cinfo->dest;
 170:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****   size_t datacount = OUTPUT_BUF_SIZE - dest->pub.free_in_buffer;
 171:Middlewares/Third_Party/LibJPEG/source/jdatadst.c **** 
 172:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****   /* Write any data remaining in the buffer */
 173:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****   if (datacount > 0) {
 174:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****     if (JFWRITE(dest->outfile, dest->buffer, datacount) != datacount)
 175:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****       ERREXIT(cinfo, JERR_FILE_WRITE);
 176:Middlewares/Third_Party/LibJPEG/source/jdatadst.c ****   }
 177:Middlewares/Third_Party/LibJPEG/source/jdatadst.c **** }
 178:Middlewares/Third_Party/LibJPEG/source/jdatadst.c **** #endif /* JFILE */
