  53:Middlewares/Third_Party/LibJPEG/source/jidctflt.c ****   Sorry, this code only copes with 8x8 DCTs. /* deliberate syntax err */
  54:Middlewares/Third_Party/LibJPEG/source/jidctflt.c **** #endif
