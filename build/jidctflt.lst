  57:Middlewares/Third_Party/LibJPEG/source/jidctflt.c **** /* Dequantize a coefficient by multiplying it by the multiplier-table
  58:Middlewares/Third_Party/LibJPEG/source/jidctflt.c ****  * entry; produce a float result.
  59:Middlewares/Third_Party/LibJPEG/source/jidctflt.c ****  */
  60:Middlewares/Third_Party/LibJPEG/source/jidctflt.c **** 
  61:Middlewares/Third_Party/LibJPEG/source/jidctflt.c **** #define DEQUANTIZE(coef,quantval)  (((FAST_FLOAT) (coef)) * (quantval))
