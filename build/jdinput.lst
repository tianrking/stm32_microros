 489:Middlewares/Third_Party/LibJPEG/source/jdinput.c ****   int ci, qtblno;
 490:Middlewares/Third_Party/LibJPEG/source/jdinput.c ****   jpeg_component_info *compptr;
 491:Middlewares/Third_Party/LibJPEG/source/jdinput.c ****   JQUANT_TBL * qtbl;
 492:Middlewares/Third_Party/LibJPEG/source/jdinput.c **** 
 493:Middlewares/Third_Party/LibJPEG/source/jdinput.c ****   for (ci = 0; ci < cinfo->comps_in_scan; ci++) {
 494:Middlewares/Third_Party/LibJPEG/source/jdinput.c ****     compptr = cinfo->cur_comp_info[ci];
 495:Middlewares/Third_Party/LibJPEG/source/jdinput.c ****     /* No work if we already saved Q-table for this component */
 496:Middlewares/Third_Party/LibJPEG/source/jdinput.c ****     if (compptr->quant_table != NULL)
