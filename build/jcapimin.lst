 240:Middlewares/Third_Party/LibJPEG/source/jcapimin.c **** /*
 241:Middlewares/Third_Party/LibJPEG/source/jcapimin.c ****  * Alternate compression function: just write an abbreviated table file.
 242:Middlewares/Third_Party/LibJPEG/source/jcapimin.c ****  * Before calling this, all parameters and a data destination must be set up.
 243:Middlewares/Third_Party/LibJPEG/source/jcapimin.c ****  *
 244:Middlewares/Third_Party/LibJPEG/source/jcapimin.c ****  * To produce a pair of files containing abbreviated tables and abbreviated
 245:Middlewares/Third_Party/LibJPEG/source/jcapimin.c ****  * image data, one would proceed as follows:
 246:Middlewares/Third_Party/LibJPEG/source/jcapimin.c ****  *
 247:Middlewares/Third_Party/LibJPEG/source/jcapimin.c ****  *		initialize JPEG object
 248:Middlewares/Third_Party/LibJPEG/source/jcapimin.c ****  *		set JPEG parameters
 249:Middlewares/Third_Party/LibJPEG/source/jcapimin.c ****  *		set destination to table file
 250:Middlewares/Third_Party/LibJPEG/source/jcapimin.c ****  *		jpeg_write_tables(cinfo);
 251:Middlewares/Third_Party/LibJPEG/source/jcapimin.c ****  *		set destination to image file
 252:Middlewares/Third_Party/LibJPEG/source/jcapimin.c ****  *		jpeg_start_compress(cinfo, FALSE);
 253:Middlewares/Third_Party/LibJPEG/source/jcapimin.c ****  *		write data...
 254:Middlewares/Third_Party/LibJPEG/source/jcapimin.c ****  *		jpeg_finish_compress(cinfo);
 255:Middlewares/Third_Party/LibJPEG/source/jcapimin.c ****  *
 256:Middlewares/Third_Party/LibJPEG/source/jcapimin.c ****  * jpeg_write_tables has the side effect of marking all tables written
 257:Middlewares/Third_Party/LibJPEG/source/jcapimin.c ****  * (same as jpeg_suppress_tables(..., TRUE)).  Thus a subsequent start_compress
 258:Middlewares/Third_Party/LibJPEG/source/jcapimin.c ****  * will not re-emit the tables unless it is passed write_all_tables=TRUE.
 259:Middlewares/Third_Party/LibJPEG/source/jcapimin.c ****  */
 260:Middlewares/Third_Party/LibJPEG/source/jcapimin.c **** 
 261:Middlewares/Third_Party/LibJPEG/source/jcapimin.c **** GLOBAL(void)
 262:Middlewares/Third_Party/LibJPEG/source/jcapimin.c **** jpeg_write_tables (j_compress_ptr cinfo)
