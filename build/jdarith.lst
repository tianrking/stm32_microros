 185:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** /*
 186:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****  * Check for a restart marker & resynchronize decoder.
 187:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****  */
 188:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 
 189:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** LOCAL(void)
 190:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** process_restart (j_decompress_ptr cinfo)
 191:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** {
 192:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   arith_entropy_ptr entropy = (arith_entropy_ptr) cinfo->entropy;
 193:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   int ci;
 194:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   jpeg_component_info * compptr;
 195:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 
 196:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   /* Advance past the RSTn marker */
 197:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   if (! (*cinfo->marker->read_restart_marker) (cinfo))
 198:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     ERREXIT(cinfo, JERR_CANT_SUSPEND);
 199:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 
 200:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   /* Re-initialize statistics areas */
 201:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   for (ci = 0; ci < cinfo->comps_in_scan; ci++) {
 202:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     compptr = cinfo->cur_comp_info[ci];
 203:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     if (! cinfo->progressive_mode || (cinfo->Ss == 0 && cinfo->Ah == 0)) {
 204:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****       MEMZERO(entropy->dc_stats[compptr->dc_tbl_no], DC_STAT_BINS);
 205:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****       /* Reset DC predictions to 0 */
 206:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****       entropy->last_dc_val[ci] = 0;
 207:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****       entropy->dc_context[ci] = 0;
 208:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     }
 209:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     if ((! cinfo->progressive_mode && cinfo->lim_Se) ||
 210:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 	(cinfo->progressive_mode && cinfo->Ss)) {
 211:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****       MEMZERO(entropy->ac_stats[compptr->ac_tbl_no], AC_STAT_BINS);
 212:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     }
 213:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   }
 214:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 
 215:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   /* Reset arithmetic decoding variables */
ARM GAS  /tmp/ccRJf3no.s 			page 12


 216:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   entropy->c = 0;
 217:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   entropy->a = 0;
 218:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   entropy->ct = -16;	/* force reading 2 initial bytes to fill C */
 219:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 
 220:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   /* Reset restart counter */
 221:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   entropy->restarts_to_go = cinfo->restart_interval;
 222:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** }
