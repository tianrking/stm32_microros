  46:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 
  47:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** /* The following two definitions specify the allocation chunk size
  48:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****  * for the statistics area.
  49:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****  * According to sections F.1.4.4.1.3 and F.1.4.4.2, we need at least
  50:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****  * 49 statistics bins for DC, and 245 statistics bins for AC coding.
  51:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****  *
  52:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****  * We use a compact representation with 1 byte per statistics bin,
  53:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****  * thus the numbers directly represent byte sizes.
  54:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****  * This 1 byte per statistics bin contains the meaning of the MPS
  55:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****  * (more probable symbol) in the highest bit (mask 0x80), and the
  56:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****  * index into the probability estimation state machine table
  57:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****  * in the lower bits (mask 0x7F).
  58:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****  */
  59:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 
  60:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** #define DC_STAT_BINS 64
  61:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** #define AC_STAT_BINS 256
