 521:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 
 522:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   natural_order = cinfo->natural_order;
 523:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 
 524:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   /* Outer loop handles each block in the MCU */
 525:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 
 526:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   for (blkn = 0; blkn < cinfo->blocks_in_MCU; blkn++) {
 527:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     block = MCU_data[blkn];
 528:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     ci = cinfo->MCU_membership[blkn];
 529:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     compptr = cinfo->cur_comp_info[ci];
 530:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 
 531:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     /* Sections F.2.4.1 & F.1.4.4.1: Decoding of DC coefficients */
 532:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 
 533:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     tbl = compptr->dc_tbl_no;
 534:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 
 535:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     /* Table F.4: Point to statistics bin S0 for DC coefficient coding */
 536:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     st = entropy->dc_stats[tbl] + entropy->dc_context[ci];
