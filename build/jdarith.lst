 446:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   }
 447:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 
 448:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   if (entropy->ct == -1) return TRUE;	/* if error do nothing */
 449:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 
 450:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   natural_order = cinfo->natural_order;
 451:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 
 452:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   /* There is always only one block per MCU */
 453:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   block = MCU_data[0];
 454:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   tbl = cinfo->cur_comp_info[0]->ac_tbl_no;
