  19:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 
  20:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 
  21:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** /* Expanded entropy decoder object for arithmetic decoding. */
  22:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 
  23:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** typedef struct {
  24:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   struct jpeg_entropy_decoder pub; /* public fields */
  25:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 
  26:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   INT32 c;       /* C register, base of coding interval + input bit buffer */
  27:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   INT32 a;               /* A register, normalized size of coding interval */
  28:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   int ct;     /* bit shift counter, # of bits left in bit buffer part of C */
  29:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****                                                          /* init: ct = -16 */
  30:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****                                                          /* run: ct = 0..7 */
ARM GAS  /tmp/ccRJf3no.s 			page 2


  31:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****                                                          /* error: ct = -1 */
  32:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   int last_dc_val[MAX_COMPS_IN_SCAN]; /* last DC coef for each component */
  33:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   int dc_context[MAX_COMPS_IN_SCAN]; /* context index for DC conditioning */
  34:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 
  35:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   unsigned int restarts_to_go;	/* MCUs left in this restart interval */
  36:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 
  37:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   /* Pointers to statistics areas (these workspaces have image lifespan) */
  38:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   unsigned char * dc_stats[NUM_ARITH_TBLS];
  39:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   unsigned char * ac_stats[NUM_ARITH_TBLS];
  40:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 
  41:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   /* Statistics bin for coding with fixed probability 0.5 */
  42:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   unsigned char fixed_bin[4];
  43:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** } arith_entropy_decoder;
