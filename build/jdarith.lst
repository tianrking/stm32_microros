 320:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** METHODDEF(boolean)
 321:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** decode_mcu_AC_first (j_decompress_ptr cinfo, JBLOCKROW *MCU_data)
 322:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** {
 323:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   arith_entropy_ptr entropy = (arith_entropy_ptr) cinfo->entropy;
 324:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   JBLOCKROW block;
 325:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   unsigned char *st;
 326:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   int tbl, sign, k;
 327:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   int v, m;
 328:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   const int * natural_order;
 329:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 
ARM GAS  /tmp/ccRJf3no.s 			page 14


 330:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   /* Process restart marker if needed */
 331:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   if (cinfo->restart_interval) {
 332:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     if (entropy->restarts_to_go == 0)
 333:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****       process_restart(cinfo);
 334:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     entropy->restarts_to_go--;
 335:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   }
 336:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 
 337:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   if (entropy->ct == -1) return TRUE;	/* if error do nothing */
 338:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 
 339:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   natural_order = cinfo->natural_order;
 340:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 
 341:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   /* There is always only one block per MCU */
 342:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   block = MCU_data[0];
 343:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   tbl = cinfo->cur_comp_info[0]->ac_tbl_no;
 344:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 
 345:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   /* Sections F.2.4.2 & F.1.4.4.2: Decoding of AC coefficients */
 346:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 
 347:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   /* Figure F.20: Decode_AC_coefficients */
 348:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   for (k = cinfo->Ss; k <= cinfo->Se; k++) {
 349:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     st = entropy->ac_stats[tbl] + 3 * (k - 1);
 350:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     if (arith_decode(cinfo, st)) break;		/* EOB flag */
 351:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     while (arith_decode(cinfo, st + 1) == 0) {
 352:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****       st += 3; k++;
 353:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****       if (k > cinfo->Se) {
