 441:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   /* Process restart marker if needed */
 442:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   if (cinfo->restart_interval) {
 443:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     if (entropy->restarts_to_go == 0)
