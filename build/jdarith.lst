 384:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     v += 1; if (sign) v = -v;
 385:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     /* Scale and output coefficient in natural (dezigzagged) order */
 386:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     (*block)[natural_order[k]] = (JCOEF) (v << cinfo->Al);
ARM GAS  /tmp/ccRJf3no.s 			page 15


 387:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   }
 388:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 
 389:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   return TRUE;
