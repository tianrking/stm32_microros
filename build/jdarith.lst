 558:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****       /* Section F.1.4.4.1.2: Establish dc_context conditioning category */
 559:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****       if (m < (int) ((1L << cinfo->arith_dc_L[tbl]) >> 1))
