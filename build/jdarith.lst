 224:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 
 225:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** /*
 226:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****  * Arithmetic MCU decoding.
 227:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****  * Each of these routines decodes and returns one MCU's worth of
 228:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****  * arithmetic-compressed coefficients.
 229:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****  * The coefficients are reordered from zigzag order into natural array order,
 230:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****  * but are not dequantized.
 231:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****  *
 232:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****  * The i'th block of the MCU is stored into the block pointed to by
 233:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****  * MCU_data[i].  WE ASSUME THIS AREA IS INITIALLY ZEROED BY THE CALLER.
 234:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****  */
 235:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 
 236:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** /*
 237:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****  * MCU decoding for DC initial scan (either spectral selection,
 238:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****  * or first pass of successive approximation).
 239:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****  */
 240:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 
 241:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** METHODDEF(boolean)
 242:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** decode_mcu_DC_first (j_decompress_ptr cinfo, JBLOCKROW *MCU_data)
 243:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** {
 244:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   arith_entropy_ptr entropy = (arith_entropy_ptr) cinfo->entropy;
 245:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   JBLOCKROW block;
 246:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   unsigned char *st;
 247:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   int blkn, ci, tbl, sign;
 248:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   int v, m;
 249:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 
 250:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   /* Process restart marker if needed */
 251:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   if (cinfo->restart_interval) {
 252:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     if (entropy->restarts_to_go == 0)
 253:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****       process_restart(cinfo);
 254:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     entropy->restarts_to_go--;
 255:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   }
 256:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 
 257:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   if (entropy->ct == -1) return TRUE;	/* if error do nothing */
 258:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 
 259:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   /* Outer loop handles each block in the MCU */
 260:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 
 261:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   for (blkn = 0; blkn < cinfo->blocks_in_MCU; blkn++) {
 262:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     block = MCU_data[blkn];
 263:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     ci = cinfo->MCU_membership[blkn];
 264:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     tbl = cinfo->cur_comp_info[ci]->dc_tbl_no;
 265:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 
 266:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     /* Sections F.2.4.1 & F.1.4.4.1: Decoding of DC coefficients */
 267:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 
 268:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     /* Table F.4: Point to statistics bin S0 for DC coefficient coding */
 269:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     st = entropy->dc_stats[tbl] + entropy->dc_context[ci];
 270:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 
 271:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     /* Figure F.19: Decode_DC_DIFF */
 272:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     if (arith_decode(cinfo, st) == 0)
ARM GAS  /tmp/ccRJf3no.s 			page 13


 273:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****       entropy->dc_context[ci] = 0;
 274:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     else {
 275:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****       /* Figure F.21: Decoding nonzero value v */
 276:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****       /* Figure F.22: Decoding the sign of v */
 277:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****       sign = arith_decode(cinfo, st + 1);
 278:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****       st += 2; st += sign;
 279:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****       /* Figure F.23: Decoding the magnitude category of v */
 280:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****       if ((m = arith_decode(cinfo, st)) != 0) {
 281:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 	st = entropy->dc_stats[tbl] + 20;	/* Table F.4: X1 = 20 */
 282:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 	while (arith_decode(cinfo, st)) {
 283:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 	  if ((m <<= 1) == 0x8000) {
 284:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 	    WARNMS(cinfo, JWRN_ARITH_BAD_CODE);
 285:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 	    entropy->ct = -1;			/* magnitude overflow */
 286:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 	    return TRUE;
 287:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 	  }
 288:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 	  st += 1;
 289:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 	}
 290:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****       }
 291:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****       /* Section F.1.4.4.1.2: Establish dc_context conditioning category */
 292:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****       if (m < (int) ((1L << cinfo->arith_dc_L[tbl]) >> 1))
 293:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 	entropy->dc_context[ci] = 0;		   /* zero diff category */
 294:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****       else if (m > (int) ((1L << cinfo->arith_dc_U[tbl]) >> 1))
 295:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 	entropy->dc_context[ci] = 12 + (sign * 4); /* large diff category */
 296:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****       else
 297:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 	entropy->dc_context[ci] = 4 + (sign * 4);  /* small diff category */
 298:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****       v = m;
 299:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****       /* Figure F.24: Decoding the magnitude bit pattern of v */
 300:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****       st += 14;
 301:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****       while (m >>= 1)
 302:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 	if (arith_decode(cinfo, st)) v |= m;
 303:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****       v += 1; if (sign) v = -v;
 304:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****       entropy->last_dc_val[ci] += v;
 305:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     }
 306:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 
 307:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     /* Scale and output the DC coefficient (assumes jpeg_natural_order[0]=0) */
 308:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     (*block)[0] = (JCOEF) (entropy->last_dc_val[ci] << cinfo->Al);
 309:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   }
 310:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 
 311:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   return TRUE;
 312:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** }
 313:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 
 314:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 
 315:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** /*
 316:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****  * MCU decoding for AC initial scan (either spectral selection,
