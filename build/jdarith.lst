 393:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** /*
 394:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****  * MCU decoding for DC successive approximation refinement scan.
 395:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****  */
 396:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 
 397:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** METHODDEF(boolean)
 398:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** decode_mcu_DC_refine (j_decompress_ptr cinfo, JBLOCKROW *MCU_data)
 399:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** {
 400:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   arith_entropy_ptr entropy = (arith_entropy_ptr) cinfo->entropy;
 401:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   unsigned char *st;
 402:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   int p1, blkn;
 403:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 
 404:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   /* Process restart marker if needed */
 405:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   if (cinfo->restart_interval) {
 406:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     if (entropy->restarts_to_go == 0)
 407:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****       process_restart(cinfo);
 408:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     entropy->restarts_to_go--;
 409:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   }
 410:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 
 411:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   st = entropy->fixed_bin;	/* use fixed probability estimation */
 412:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   p1 = 1 << cinfo->Al;		/* 1 in the bit position being coded */
 413:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 
 414:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   /* Outer loop handles each block in the MCU */
 415:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 
 416:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   for (blkn = 0; blkn < cinfo->blocks_in_MCU; blkn++) {
 417:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     /* Encoded data is simply the next bit of the two's-complement DC value */
 418:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     if (arith_decode(cinfo, st))
 419:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****       MCU_data[blkn][0][0] |= p1;
 420:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   }
 421:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 
 422:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   return TRUE;
 423:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** }
