 574:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     (*block)[0] = (JCOEF) entropy->last_dc_val[ci];
 575:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 
 576:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     /* Sections F.2.4.2 & F.1.4.4.2: Decoding of AC coefficients */
 577:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 
 578:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     if (cinfo->lim_Se == 0) continue;
