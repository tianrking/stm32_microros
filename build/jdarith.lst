 597:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****       /* Figure F.22: Decoding the sign of v */
 598:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****       sign = arith_decode(cinfo, entropy->fixed_bin);
