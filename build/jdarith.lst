 463:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   for (k = cinfo->Ss; k <= cinfo->Se; k++) {
 464:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     st = entropy->ac_stats[tbl] + 3 * (k - 1);
