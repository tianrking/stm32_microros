 563:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****       else
 564:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 	entropy->dc_context[ci] = 4 + (sign * 4);  /* small diff category */
 565:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****       v = m;
 566:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****       /* Figure F.24: Decoding the magnitude bit pattern of v */
