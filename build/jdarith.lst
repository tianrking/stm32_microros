 356:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 	return TRUE;
 357:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****       }
 358:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     }
 359:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     /* Figure F.21: Decoding nonzero value v */
 360:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     /* Figure F.22: Decoding the sign of v */
 361:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     sign = arith_decode(cinfo, entropy->fixed_bin);
 362:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     st += 2;
 363:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     /* Figure F.23: Decoding the magnitude category of v */
 364:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     if ((m = arith_decode(cinfo, st)) != 0) {
 365:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****       if (arith_decode(cinfo, st)) {
 366:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 	m <<= 1;
