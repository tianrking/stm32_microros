 513:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   /* Process restart marker if needed */
 514:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   if (cinfo->restart_interval) {
 515:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     if (entropy->restarts_to_go == 0)
 516:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****       process_restart(cinfo);
 517:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     entropy->restarts_to_go--;
 518:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****   }
