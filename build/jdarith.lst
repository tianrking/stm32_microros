 370:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 	  if ((m <<= 1) == 0x8000) {
 371:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 	    WARNMS(cinfo, JWRN_ARITH_BAD_CODE);
 372:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 	    entropy->ct = -1;			/* magnitude overflow */
 373:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 	    return TRUE;
 374:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 	  }
 375:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 	  st += 1;
 376:Middlewares/Third_Party/LibJPEG/source/jdarith.c **** 	}
 377:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****       }
 378:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     }
 379:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     v = m;
 380:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     /* Figure F.24: Decoding the magnitude bit pattern of v */
 381:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     st += 14;
