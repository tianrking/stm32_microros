 538:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     /* Figure F.19: Decode_DC_DIFF */
 539:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     if (arith_decode(cinfo, st) == 0)
 540:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****       entropy->dc_context[ci] = 0;
 541:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****     else {
 542:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****       /* Figure F.21: Decoding nonzero value v */
 543:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****       /* Figure F.22: Decoding the sign of v */
 544:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****       sign = arith_decode(cinfo, st + 1);
 545:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****       st += 2; st += sign;
 546:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****       /* Figure F.23: Decoding the magnitude category of v */
 547:Middlewares/Third_Party/LibJPEG/source/jdarith.c ****       if ((m = arith_decode(cinfo, st)) != 0) {
