 137:Middlewares/Third_Party/LibJPEG/source/jdmerge.c **** /*
 138:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****  * Control routine to do upsampling (and color conversion).
 139:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****  *
 140:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****  * The control routine just handles the row buffering considerations.
 141:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****  */
 142:Middlewares/Third_Party/LibJPEG/source/jdmerge.c **** 
 143:Middlewares/Third_Party/LibJPEG/source/jdmerge.c **** METHODDEF(void)
 144:Middlewares/Third_Party/LibJPEG/source/jdmerge.c **** merged_2v_upsample (j_decompress_ptr cinfo,
 145:Middlewares/Third_Party/LibJPEG/source/jdmerge.c **** 		    JSAMPIMAGE input_buf, JDIMENSION *in_row_group_ctr,
 146:Middlewares/Third_Party/LibJPEG/source/jdmerge.c **** 		    JDIMENSION in_row_groups_avail,
 147:Middlewares/Third_Party/LibJPEG/source/jdmerge.c **** 		    JSAMPARRAY output_buf, JDIMENSION *out_row_ctr,
 148:Middlewares/Third_Party/LibJPEG/source/jdmerge.c **** 		    JDIMENSION out_rows_avail)
 149:Middlewares/Third_Party/LibJPEG/source/jdmerge.c **** /* 2:1 vertical sampling case: may need a spare row. */
 150:Middlewares/Third_Party/LibJPEG/source/jdmerge.c **** {
 151:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****   my_upsample_ptr upsample = (my_upsample_ptr) cinfo->upsample;
 152:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****   JSAMPROW work_ptrs[2];
 153:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****   JDIMENSION num_rows;		/* number of rows returned to caller */
 154:Middlewares/Third_Party/LibJPEG/source/jdmerge.c **** 
 155:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****   if (upsample->spare_full) {
 156:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****     /* If we have a spare row saved from a previous cycle, just return it. */
 157:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****     jcopy_sample_rows(& upsample->spare_row, 0, output_buf + *out_row_ctr, 0,
 158:Middlewares/Third_Party/LibJPEG/source/jdmerge.c **** 		      1, upsample->out_row_width);
 159:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****     num_rows = 1;
 160:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****     upsample->spare_full = FALSE;
 161:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****   } else {
 162:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****     /* Figure number of rows to return to caller. */
 163:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****     num_rows = 2;
 164:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****     /* Not more than the distance to the end of the image. */
 165:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****     if (num_rows > upsample->rows_to_go)
 166:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****       num_rows = upsample->rows_to_go;
 167:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****     /* And not more than what the client can accept: */
 168:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****     out_rows_avail -= *out_row_ctr;
 169:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****     if (num_rows > out_rows_avail)
 170:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****       num_rows = out_rows_avail;
 171:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****     /* Create output pointer array for upsampler. */
 172:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****     work_ptrs[0] = output_buf[*out_row_ctr];
 173:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****     if (num_rows > 1) {
 174:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****       work_ptrs[1] = output_buf[*out_row_ctr + 1];
 175:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****     } else {
 176:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****       work_ptrs[1] = upsample->spare_row;
 177:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****       upsample->spare_full = TRUE;
 178:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****     }
ARM GAS  /tmp/cc19aUNd.s 			page 8


 179:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****     /* Now do the upsampling. */
 180:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****     (*upsample->upmethod) (cinfo, input_buf, *in_row_group_ctr, work_ptrs);
 181:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****   }
 182:Middlewares/Third_Party/LibJPEG/source/jdmerge.c **** 
 183:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****   /* Adjust counts */
 184:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****   *out_row_ctr += num_rows;
 185:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****   upsample->rows_to_go -= num_rows;
 186:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****   /* When the buffer is emptied, declare this input row group consumed */
 187:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****   if (! upsample->spare_full)
 188:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****     (*in_row_group_ctr)++;
 189:Middlewares/Third_Party/LibJPEG/source/jdmerge.c **** }
