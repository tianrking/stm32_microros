   1:Middlewares/Third_Party/LibJPEG/source/jdmerge.c **** /*
   2:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****  * jdmerge.c
   3:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****  *
   4:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****  * Copyright (C) 1994-1996, Thomas G. Lane.
   5:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****  * This file is part of the Independent JPEG Group's software.
   6:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****  * For conditions of distribution and use, see the accompanying README file.
   7:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****  *
   8:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****  * This file contains code for merged upsampling/color conversion.
   9:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****  *
  10:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****  * This file combines functions from jdsample.c and jdcolor.c;
  11:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****  * read those files first to understand what's going on.
  12:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****  *
  13:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****  * When the chroma components are to be upsampled by simple replication
  14:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****  * (ie, box filtering), we can save some work in color conversion by
  15:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****  * calculating all the output pixels corresponding to a pair of chroma
  16:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****  * samples at one time.  In the conversion equations
  17:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****  *	R = Y           + K1 * Cr
  18:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****  *	G = Y + K2 * Cb + K3 * Cr
  19:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****  *	B = Y + K4 * Cb
  20:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****  * only the Y term varies among the group of pixels corresponding to a pair
  21:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****  * of chroma samples, so the rest of the terms can be calculated just once.
  22:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****  * At typical sampling ratios, this eliminates half or three-quarters of the
  23:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****  * multiplications needed for color conversion.
  24:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****  *
  25:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****  * This file currently provides implementations for the following cases:
  26:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****  *	YCbCr => RGB color conversion only.
  27:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****  *	Sampling ratios of 2h1v or 2h2v.
  28:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****  *	No scaling needed at upsample time.
  29:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****  *	Corner-aligned (non-CCIR601) sampling alignment.
  30:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****  * Other special cases could be added, but in most applications these are
ARM GAS  /tmp/cc19aUNd.s 			page 2


  31:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****  * the only common cases.  (For uncommon cases we fall back on the more
  32:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****  * general code in jdsample.c and jdcolor.c.)
  33:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****  */
  34:Middlewares/Third_Party/LibJPEG/source/jdmerge.c **** 
  35:Middlewares/Third_Party/LibJPEG/source/jdmerge.c **** #define JPEG_INTERNALS
  36:Middlewares/Third_Party/LibJPEG/source/jdmerge.c **** #include "jinclude.h"
  37:Middlewares/Third_Party/LibJPEG/source/jdmerge.c **** #include "jpeglib.h"
  38:Middlewares/Third_Party/LibJPEG/source/jdmerge.c **** 
  39:Middlewares/Third_Party/LibJPEG/source/jdmerge.c **** #ifdef UPSAMPLE_MERGING_SUPPORTED
  40:Middlewares/Third_Party/LibJPEG/source/jdmerge.c **** 
  41:Middlewares/Third_Party/LibJPEG/source/jdmerge.c **** 
  42:Middlewares/Third_Party/LibJPEG/source/jdmerge.c **** /* Private subobject */
  43:Middlewares/Third_Party/LibJPEG/source/jdmerge.c **** 
  44:Middlewares/Third_Party/LibJPEG/source/jdmerge.c **** typedef struct {
  45:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****   struct jpeg_upsampler pub;	/* public fields */
  46:Middlewares/Third_Party/LibJPEG/source/jdmerge.c **** 
  47:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****   /* Pointer to routine to do actual upsampling/conversion of one row group */
  48:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****   JMETHOD(void, upmethod, (j_decompress_ptr cinfo,
  49:Middlewares/Third_Party/LibJPEG/source/jdmerge.c **** 			   JSAMPIMAGE input_buf, JDIMENSION in_row_group_ctr,
  50:Middlewares/Third_Party/LibJPEG/source/jdmerge.c **** 			   JSAMPARRAY output_buf));
  51:Middlewares/Third_Party/LibJPEG/source/jdmerge.c **** 
  52:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****   /* Private state for YCC->RGB conversion */
  53:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****   int * Cr_r_tab;		/* => table for Cr to R conversion */
  54:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****   int * Cb_b_tab;		/* => table for Cb to B conversion */
  55:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****   INT32 * Cr_g_tab;		/* => table for Cr to G conversion */
  56:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****   INT32 * Cb_g_tab;		/* => table for Cb to G conversion */
  57:Middlewares/Third_Party/LibJPEG/source/jdmerge.c **** 
  58:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****   /* For 2:1 vertical sampling, we produce two output rows at a time.
  59:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****    * We need a "spare" row buffer to hold the second output row if the
  60:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****    * application provides just a one-row buffer; we also use the spare
  61:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****    * to discard the dummy last row if the image height is odd.
  62:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****    */
  63:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****   JSAMPROW spare_row;
  64:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****   boolean spare_full;		/* T if spare buffer is occupied */
  65:Middlewares/Third_Party/LibJPEG/source/jdmerge.c **** 
  66:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****   JDIMENSION out_row_width;	/* samples per output row */
  67:Middlewares/Third_Party/LibJPEG/source/jdmerge.c ****   JDIMENSION rows_to_go;	/* counts rows remaining in image */
  68:Middlewares/Third_Party/LibJPEG/source/jdmerge.c **** } my_upsampler;
  69:Middlewares/Third_Party/LibJPEG/source/jdmerge.c **** 
  70:Middlewares/Third_Party/LibJPEG/source/jdmerge.c **** typedef my_upsampler * my_upsample_ptr;
  71:Middlewares/Third_Party/LibJPEG/source/jdmerge.c **** 
  72:Middlewares/Third_Party/LibJPEG/source/jdmerge.c **** #define SCALEBITS	16	/* speediest right-shift on some machines */
