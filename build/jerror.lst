 150:Middlewares/Third_Party/LibJPEG/source/jerror.c **** /*
 151:Middlewares/Third_Party/LibJPEG/source/jerror.c ****  * Format a message string for the most recent JPEG error or message.
 152:Middlewares/Third_Party/LibJPEG/source/jerror.c ****  * The message is stored into buffer, which should be at least JMSG_LENGTH_MAX
 153:Middlewares/Third_Party/LibJPEG/source/jerror.c ****  * characters.  Note that no '\n' character is added to the string.
 154:Middlewares/Third_Party/LibJPEG/source/jerror.c ****  * Few applications should need to override this method.
 155:Middlewares/Third_Party/LibJPEG/source/jerror.c ****  */
 156:Middlewares/Third_Party/LibJPEG/source/jerror.c **** 
 157:Middlewares/Third_Party/LibJPEG/source/jerror.c **** METHODDEF(void)
 158:Middlewares/Third_Party/LibJPEG/source/jerror.c **** format_message (j_common_ptr cinfo, char * buffer)
 159:Middlewares/Third_Party/LibJPEG/source/jerror.c **** {
 160:Middlewares/Third_Party/LibJPEG/source/jerror.c ****   struct jpeg_error_mgr * err = cinfo->err;
 161:Middlewares/Third_Party/LibJPEG/source/jerror.c ****   int msg_code = err->msg_code;
 162:Middlewares/Third_Party/LibJPEG/source/jerror.c ****   const char * msgtext = NULL;
 163:Middlewares/Third_Party/LibJPEG/source/jerror.c ****   const char * msgptr;
 164:Middlewares/Third_Party/LibJPEG/source/jerror.c ****   char ch;
 165:Middlewares/Third_Party/LibJPEG/source/jerror.c ****   boolean isstring;
 166:Middlewares/Third_Party/LibJPEG/source/jerror.c **** 
 167:Middlewares/Third_Party/LibJPEG/source/jerror.c ****   /* Look up message string in proper table */
 168:Middlewares/Third_Party/LibJPEG/source/jerror.c ****   if (msg_code > 0 && msg_code <= err->last_jpeg_message) {
 169:Middlewares/Third_Party/LibJPEG/source/jerror.c ****     msgtext = err->jpeg_message_table[msg_code];
