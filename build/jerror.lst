  56:Middlewares/Third_Party/LibJPEG/source/jerror.c **** /*
  57:Middlewares/Third_Party/LibJPEG/source/jerror.c ****  * Error exit handler: must not return to caller.
  58:Middlewares/Third_Party/LibJPEG/source/jerror.c ****  *
  59:Middlewares/Third_Party/LibJPEG/source/jerror.c ****  * Applications may override this if they want to get control back after
  60:Middlewares/Third_Party/LibJPEG/source/jerror.c ****  * an error.  Typically one would longjmp somewhere instead of exiting.
  61:Middlewares/Third_Party/LibJPEG/source/jerror.c ****  * The setjmp buffer can be made a private field within an expanded error
  62:Middlewares/Third_Party/LibJPEG/source/jerror.c ****  * handler object.  Note that the info needed to generate an error message
  63:Middlewares/Third_Party/LibJPEG/source/jerror.c ****  * is stored in the error object, so you can generate the message now or
  64:Middlewares/Third_Party/LibJPEG/source/jerror.c ****  * later, at your convenience.
  65:Middlewares/Third_Party/LibJPEG/source/jerror.c ****  * You should make sure that the JPEG object is cleaned up (with jpeg_abort
  66:Middlewares/Third_Party/LibJPEG/source/jerror.c ****  * or jpeg_destroy) at some point.
  67:Middlewares/Third_Party/LibJPEG/source/jerror.c ****  */
  68:Middlewares/Third_Party/LibJPEG/source/jerror.c **** 
  69:Middlewares/Third_Party/LibJPEG/source/jerror.c **** METHODDEF(void)
  70:Middlewares/Third_Party/LibJPEG/source/jerror.c **** error_exit (j_common_ptr cinfo)
  71:Middlewares/Third_Party/LibJPEG/source/jerror.c **** {
  72:Middlewares/Third_Party/LibJPEG/source/jerror.c ****   /* Always display the message */
  73:Middlewares/Third_Party/LibJPEG/source/jerror.c ****   (*cinfo->err->output_message) (cinfo);
  74:Middlewares/Third_Party/LibJPEG/source/jerror.c **** 
  75:Middlewares/Third_Party/LibJPEG/source/jerror.c ****   /* Let the memory manager delete any temp files before we die */
  76:Middlewares/Third_Party/LibJPEG/source/jerror.c ****   jpeg_destroy(cinfo);
  77:Middlewares/Third_Party/LibJPEG/source/jerror.c **** 
  78:Middlewares/Third_Party/LibJPEG/source/jerror.c ****   //exit(EXIT_FAILURE);
  79:Middlewares/Third_Party/LibJPEG/source/jerror.c **** }
  80:Middlewares/Third_Party/LibJPEG/source/jerror.c **** 
  81:Middlewares/Third_Party/LibJPEG/source/jerror.c **** 
  82:Middlewares/Third_Party/LibJPEG/source/jerror.c **** /*
  83:Middlewares/Third_Party/LibJPEG/source/jerror.c ****  * Actual output of an error or trace message.
  84:Middlewares/Third_Party/LibJPEG/source/jerror.c ****  * Applications may override this method to send JPEG messages somewhere
  85:Middlewares/Third_Party/LibJPEG/source/jerror.c ****  * other than stderr.
  86:Middlewares/Third_Party/LibJPEG/source/jerror.c ****  *
  87:Middlewares/Third_Party/LibJPEG/source/jerror.c ****  * On Windows, printing to stderr is generally completely useless,
ARM GAS  /tmp/cc7pTYcq.s 			page 3


  88:Middlewares/Third_Party/LibJPEG/source/jerror.c ****  * so we provide optional code to produce an error-dialog popup.
