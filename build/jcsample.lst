  68:Middlewares/Third_Party/LibJPEG/source/jcsample.c **** 
  69:Middlewares/Third_Party/LibJPEG/source/jcsample.c ****   /* These arrays save pixel expansion factors so that int_downsample need not
  70:Middlewares/Third_Party/LibJPEG/source/jcsample.c ****    * recompute them each time.  They are unused for other downsampling methods.
  71:Middlewares/Third_Party/LibJPEG/source/jcsample.c ****    */
  72:Middlewares/Third_Party/LibJPEG/source/jcsample.c ****   UINT8 h_expand[MAX_COMPONENTS];
  73:Middlewares/Third_Party/LibJPEG/source/jcsample.c ****   UINT8 v_expand[MAX_COMPONENTS];
  74:Middlewares/Third_Party/LibJPEG/source/jcsample.c **** } my_downsampler;
