   1:Middlewares/Third_Party/LibJPEG/source/jcprepct.c **** /*
   2:Middlewares/Third_Party/LibJPEG/source/jcprepct.c ****  * jcprepct.c
   3:Middlewares/Third_Party/LibJPEG/source/jcprepct.c ****  *
   4:Middlewares/Third_Party/LibJPEG/source/jcprepct.c ****  * Copyright (C) 1994-1996, Thomas G. Lane.
   5:Middlewares/Third_Party/LibJPEG/source/jcprepct.c ****  * This file is part of the Independent JPEG Group's software.
   6:Middlewares/Third_Party/LibJPEG/source/jcprepct.c ****  * For conditions of distribution and use, see the accompanying README file.
   7:Middlewares/Third_Party/LibJPEG/source/jcprepct.c ****  *
   8:Middlewares/Third_Party/LibJPEG/source/jcprepct.c ****  * This file contains the compression preprocessing controller.
   9:Middlewares/Third_Party/LibJPEG/source/jcprepct.c ****  * This controller manages the color conversion, downsampling,
  10:Middlewares/Third_Party/LibJPEG/source/jcprepct.c ****  * and edge expansion steps.
  11:Middlewares/Third_Party/LibJPEG/source/jcprepct.c ****  *
  12:Middlewares/Third_Party/LibJPEG/source/jcprepct.c ****  * Most of the complexity here is associated with buffering input rows
  13:Middlewares/Third_Party/LibJPEG/source/jcprepct.c ****  * as required by the downsampler.  See the comments at the head of
  14:Middlewares/Third_Party/LibJPEG/source/jcprepct.c ****  * jcsample.c for the downsampler's needs.
  15:Middlewares/Third_Party/LibJPEG/source/jcprepct.c ****  */
  16:Middlewares/Third_Party/LibJPEG/source/jcprepct.c **** 
  17:Middlewares/Third_Party/LibJPEG/source/jcprepct.c **** #define JPEG_INTERNALS
  18:Middlewares/Third_Party/LibJPEG/source/jcprepct.c **** #include "jinclude.h"
  19:Middlewares/Third_Party/LibJPEG/source/jcprepct.c **** #include "jpeglib.h"
  20:Middlewares/Third_Party/LibJPEG/source/jcprepct.c **** 
  21:Middlewares/Third_Party/LibJPEG/source/jcprepct.c **** 
  22:Middlewares/Third_Party/LibJPEG/source/jcprepct.c **** /* At present, jcsample.c can request context rows only for smoothing.
  23:Middlewares/Third_Party/LibJPEG/source/jcprepct.c ****  * In the future, we might also need context rows for CCIR601 sampling
  24:Middlewares/Third_Party/LibJPEG/source/jcprepct.c ****  * or other more-complex downsampling procedures.  The code to support
  25:Middlewares/Third_Party/LibJPEG/source/jcprepct.c ****  * context rows should be compiled only if needed.
  26:Middlewares/Third_Party/LibJPEG/source/jcprepct.c ****  */
  27:Middlewares/Third_Party/LibJPEG/source/jcprepct.c **** #ifdef INPUT_SMOOTHING_SUPPORTED
  28:Middlewares/Third_Party/LibJPEG/source/jcprepct.c **** #define CONTEXT_ROWS_SUPPORTED
  29:Middlewares/Third_Party/LibJPEG/source/jcprepct.c **** #endif
  30:Middlewares/Third_Party/LibJPEG/source/jcprepct.c **** 
ARM GAS  /tmp/ccnT7xKv.s 			page 2


  31:Middlewares/Third_Party/LibJPEG/source/jcprepct.c **** 
  32:Middlewares/Third_Party/LibJPEG/source/jcprepct.c **** /*
  33:Middlewares/Third_Party/LibJPEG/source/jcprepct.c ****  * For the simple (no-context-row) case, we just need to buffer one
  34:Middlewares/Third_Party/LibJPEG/source/jcprepct.c ****  * row group's worth of pixels for the downsampling step.  At the bottom of
  35:Middlewares/Third_Party/LibJPEG/source/jcprepct.c ****  * the image, we pad to a full row group by replicating the last pixel row.
  36:Middlewares/Third_Party/LibJPEG/source/jcprepct.c ****  * The downsampler's last output row is then replicated if needed to pad
  37:Middlewares/Third_Party/LibJPEG/source/jcprepct.c ****  * out to a full iMCU row.
  38:Middlewares/Third_Party/LibJPEG/source/jcprepct.c ****  *
  39:Middlewares/Third_Party/LibJPEG/source/jcprepct.c ****  * When providing context rows, we must buffer three row groups' worth of
  40:Middlewares/Third_Party/LibJPEG/source/jcprepct.c ****  * pixels.  Three row groups are physically allocated, but the row pointer
  41:Middlewares/Third_Party/LibJPEG/source/jcprepct.c ****  * arrays are made five row groups high, with the extra pointers above and
  42:Middlewares/Third_Party/LibJPEG/source/jcprepct.c ****  * below "wrapping around" to point to the last and first real row groups.
  43:Middlewares/Third_Party/LibJPEG/source/jcprepct.c ****  * This allows the downsampler to access the proper context rows.
  44:Middlewares/Third_Party/LibJPEG/source/jcprepct.c ****  * At the top and bottom of the image, we create dummy context rows by
  45:Middlewares/Third_Party/LibJPEG/source/jcprepct.c ****  * copying the first or last real pixel row.  This copying could be avoided
  46:Middlewares/Third_Party/LibJPEG/source/jcprepct.c ****  * by pointer hacking as is done in jdmainct.c, but it doesn't seem worth the
  47:Middlewares/Third_Party/LibJPEG/source/jcprepct.c ****  * trouble on the compression side.
  48:Middlewares/Third_Party/LibJPEG/source/jcprepct.c ****  */
  49:Middlewares/Third_Party/LibJPEG/source/jcprepct.c **** 
  50:Middlewares/Third_Party/LibJPEG/source/jcprepct.c **** 
  51:Middlewares/Third_Party/LibJPEG/source/jcprepct.c **** /* Private buffer controller object */
  52:Middlewares/Third_Party/LibJPEG/source/jcprepct.c **** 
  53:Middlewares/Third_Party/LibJPEG/source/jcprepct.c **** typedef struct {
  54:Middlewares/Third_Party/LibJPEG/source/jcprepct.c ****   struct jpeg_c_prep_controller pub; /* public fields */
  55:Middlewares/Third_Party/LibJPEG/source/jcprepct.c **** 
  56:Middlewares/Third_Party/LibJPEG/source/jcprepct.c ****   /* Downsampling input buffer.  This buffer holds color-converted data
  57:Middlewares/Third_Party/LibJPEG/source/jcprepct.c ****    * until we have enough to do a downsample step.
  58:Middlewares/Third_Party/LibJPEG/source/jcprepct.c ****    */
  59:Middlewares/Third_Party/LibJPEG/source/jcprepct.c ****   JSAMPARRAY color_buf[MAX_COMPONENTS];
  60:Middlewares/Third_Party/LibJPEG/source/jcprepct.c **** 
  61:Middlewares/Third_Party/LibJPEG/source/jcprepct.c ****   JDIMENSION rows_to_go;	/* counts rows remaining in source image */
  62:Middlewares/Third_Party/LibJPEG/source/jcprepct.c ****   int next_buf_row;		/* index of next row to store in color_buf */
  63:Middlewares/Third_Party/LibJPEG/source/jcprepct.c **** 
  64:Middlewares/Third_Party/LibJPEG/source/jcprepct.c **** #ifdef CONTEXT_ROWS_SUPPORTED	/* only needed for context case */
  65:Middlewares/Third_Party/LibJPEG/source/jcprepct.c ****   int this_row_group;		/* starting row index of group to process */
  66:Middlewares/Third_Party/LibJPEG/source/jcprepct.c ****   int next_buf_stop;		/* downsample when we reach this index */
  67:Middlewares/Third_Party/LibJPEG/source/jcprepct.c **** #endif
  68:Middlewares/Third_Party/LibJPEG/source/jcprepct.c **** } my_prep_controller;
  69:Middlewares/Third_Party/LibJPEG/source/jcprepct.c **** 
  70:Middlewares/Third_Party/LibJPEG/source/jcprepct.c **** typedef my_prep_controller * my_prep_ptr;
