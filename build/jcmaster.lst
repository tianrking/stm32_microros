 611:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****     
 612:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****     /* Overall image size in MCUs */
 613:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****     cinfo->MCUs_per_row = (JDIMENSION)
 614:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****       jdiv_round_up((long) cinfo->jpeg_width,
 615:Middlewares/Third_Party/LibJPEG/source/jcmaster.c **** 		    (long) (cinfo->max_h_samp_factor * cinfo->block_size));
 616:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****     cinfo->MCU_rows_in_scan = (JDIMENSION)
 617:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****       jdiv_round_up((long) cinfo->jpeg_height,
