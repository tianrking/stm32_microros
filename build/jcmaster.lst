 580:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****     
 581:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****     /* Noninterleaved (single-component) scan */
 582:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****     compptr = cinfo->cur_comp_info[0];
 583:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****     
 584:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****     /* Overall image size in MCUs */
 585:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****     cinfo->MCUs_per_row = compptr->width_in_blocks;
 586:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****     cinfo->MCU_rows_in_scan = compptr->height_in_blocks;
 587:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****     
 588:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****     /* For noninterleaved scan, always one block per MCU */
 589:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****     compptr->MCU_width = 1;
 590:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****     compptr->MCU_height = 1;
 591:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****     compptr->MCU_blocks = 1;
 592:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****     compptr->MCU_sample_width = compptr->DCT_h_scaled_size;
 593:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****     compptr->last_col_width = 1;
