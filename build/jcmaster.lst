 572:Middlewares/Third_Party/LibJPEG/source/jcmaster.c **** per_scan_setup (j_compress_ptr cinfo)
 573:Middlewares/Third_Party/LibJPEG/source/jcmaster.c **** /* Do computations that are needed before processing a JPEG scan */
 574:Middlewares/Third_Party/LibJPEG/source/jcmaster.c **** /* cinfo->comps_in_scan and cinfo->cur_comp_info[] are already set */
 575:Middlewares/Third_Party/LibJPEG/source/jcmaster.c **** {
 576:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****   int ci, mcublks, tmp;
