 594:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****     /* For noninterleaved scans, it is convenient to define last_row_height
 595:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****      * as the number of block rows present in the last iMCU row.
 596:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****      */
 597:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****     tmp = (int) (compptr->height_in_blocks % compptr->v_samp_factor);
 598:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****     if (tmp == 0) tmp = compptr->v_samp_factor;
 599:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****     compptr->last_row_height = tmp;
 600:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****     
 601:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****     /* Prepare array describing MCU composition */
 602:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****     cinfo->blocks_in_MCU = 1;
