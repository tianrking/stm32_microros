  46:Middlewares/Third_Party/LibJPEG/source/jcmaster.c **** /*
  47:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****  * Compute JPEG image dimensions and related values.
  48:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****  * NOTE: this is exported for possible use by application.
  49:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****  * Hence it mustn't do anything that can't be done twice.
  50:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****  */
  51:Middlewares/Third_Party/LibJPEG/source/jcmaster.c **** 
  52:Middlewares/Third_Party/LibJPEG/source/jcmaster.c **** GLOBAL(void)
  53:Middlewares/Third_Party/LibJPEG/source/jcmaster.c **** jpeg_calc_jpeg_dimensions (j_compress_ptr cinfo)
  54:Middlewares/Third_Party/LibJPEG/source/jcmaster.c **** /* Do computations that are needed before master selection phase */
  55:Middlewares/Third_Party/LibJPEG/source/jcmaster.c **** {
  56:Middlewares/Third_Party/LibJPEG/source/jcmaster.c **** #ifdef DCT_SCALING_SUPPORTED
  57:Middlewares/Third_Party/LibJPEG/source/jcmaster.c **** 
  58:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****   /* Sanity check on input image dimensions to prevent overflow in
  59:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****    * following calculation.
  60:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****    * We do check jpeg_width and jpeg_height in initial_setup below,
  61:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****    * but image_width and image_height can come from arbitrary data,
  62:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****    * and we need some space for multiplication by block_size.
  63:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****    */
  64:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****   if (((long) cinfo->image_width >> 24) || ((long) cinfo->image_height >> 24))
  65:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****     ERREXIT1(cinfo, JERR_IMAGE_TOO_BIG, (unsigned int) JPEG_MAX_DIMENSION);
  66:Middlewares/Third_Party/LibJPEG/source/jcmaster.c **** 
  67:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****   /* Compute actual JPEG image dimensions and DCT scaling choices. */
  68:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****   if (cinfo->scale_num >= cinfo->scale_denom * cinfo->block_size) {
  69:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****     /* Provide block_size/1 scaling */
  70:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****     cinfo->jpeg_width = cinfo->image_width * cinfo->block_size;
  71:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****     cinfo->jpeg_height = cinfo->image_height * cinfo->block_size;
  72:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****     cinfo->min_DCT_h_scaled_size = 1;
  73:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****     cinfo->min_DCT_v_scaled_size = 1;
  74:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****   } else if (cinfo->scale_num * 2 >= cinfo->scale_denom * cinfo->block_size) {
  75:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****     /* Provide block_size/2 scaling */
  76:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****     cinfo->jpeg_width = (JDIMENSION)
  77:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****       jdiv_round_up((long) cinfo->image_width * cinfo->block_size, 2L);
  78:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****     cinfo->jpeg_height = (JDIMENSION)
  79:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****       jdiv_round_up((long) cinfo->image_height * cinfo->block_size, 2L);
  80:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****     cinfo->min_DCT_h_scaled_size = 2;
  81:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****     cinfo->min_DCT_v_scaled_size = 2;
  82:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****   } else if (cinfo->scale_num * 3 >= cinfo->scale_denom * cinfo->block_size) {
  83:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****     /* Provide block_size/3 scaling */
  84:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****     cinfo->jpeg_width = (JDIMENSION)
  85:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****       jdiv_round_up((long) cinfo->image_width * cinfo->block_size, 3L);
  86:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****     cinfo->jpeg_height = (JDIMENSION)
  87:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****       jdiv_round_up((long) cinfo->image_height * cinfo->block_size, 3L);
ARM GAS  /tmp/ccGFwaS8.s 			page 3


  88:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****     cinfo->min_DCT_h_scaled_size = 3;
  89:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****     cinfo->min_DCT_v_scaled_size = 3;
  90:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****   } else if (cinfo->scale_num * 4 >= cinfo->scale_denom * cinfo->block_size) {
  91:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****     /* Provide block_size/4 scaling */
