 624:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****       /* Sampling factors give # of blocks of component in each MCU */
 625:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****       compptr->MCU_width = compptr->h_samp_factor;
 626:Middlewares/Third_Party/LibJPEG/source/jcmaster.c ****       compptr->MCU_height = compptr->v_samp_factor;
