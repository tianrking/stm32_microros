  55:Cus/AT/AT.c   **** 
  56:Cus/AT/AT.c   ****     // 确定要发送的消息
  57:Cus/AT/AT.c   ****     if (strcmp(modeCommand, "UART") == 0) {
  58:Cus/AT/AT.c   ****         sprintf(data, "OK: Changed from AT to UART mode\r\n");
  59:Cus/AT/AT.c   ****         RobotState_SetOperationMode(OP_MODE_UART);
  60:Cus/AT/AT.c   ****     } else if (strcmp(modeCommand, "CAN") == 0) {
  61:Cus/AT/AT.c   ****         sprintf(data, "OK: Changed from AT to CAN mode\r\n");
  62:Cus/AT/AT.c   ****         RobotState_SetOperationMode(OP_MODE_CAN);
