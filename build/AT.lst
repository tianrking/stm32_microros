  66:Cus/AT/AT.c   ****         // HAL_Delay(500);  // 确保消息发送完成
  67:Cus/AT/AT.c   ****         // NVIC_SystemReset();  // 触发系统重启
  68:Cus/AT/AT.c   ****         // return;  // 确保不会继续执行其他代码
  69:Cus/AT/AT.c   ****         RobotState_SetOperationMode(OP_MODE_MICROROS);
  70:Cus/AT/AT.c   ****     } else if (strcmp(modeCommand, "AT") == 0) {
  71:Cus/AT/AT.c   ****         sprintf(data, "OK: AT command mode set\r\n");
