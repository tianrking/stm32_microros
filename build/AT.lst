  79:Cus/AT/AT.c   ****     }
  80:Cus/AT/AT.c   **** 
  81:Cus/AT/AT.c   ****     // 发送模式改变信息，仅当从AT模式退出时发送
  82:Cus/AT/AT.c   ****     if (isExitingATMode) {
